#!/usr/bin/env ruby
# frozen_string_literal: true

# conform — one command for the whole conformance loop.
#
#   porting/conform                       # phase1, both runners, the verdict
#   porting/conform --quick               # the eight-case smoke subset
#   porting/conform --case cli-done-small-gtd
#   porting/conform --cases porting/runners/cases/phase2.jsonl
#   porting/conform --json                # the comparator's structured report
#
# It exists because the loop it replaces was four invocations that had to agree
# about three things — the same case list, the same `--work` root, and
# `--pin-identity` on BOTH sides — and getting any of them wrong produced a
# result that looked like a port defect and was not. The comparator classifies a
# mismatched fixture root or an unpinned observation id as `harness_error`
# precisely because that mistake is easy to make by hand; this makes it hard to
# make at all.
#
# Exit status is the comparator's, unchanged, so this is a drop-in gate:
#
#   0  every paired case matched (or differed only where Marcus recorded an
#      intentional difference)
#   1  at least one gate-failing difference
#   2  usage error, or a runner that could not complete — in which case there is
#      no verdict to report and pretending otherwise would be the worst outcome
#
# What it deliberately does NOT do is interpret the report. The classification,
# the rules and the gate all belong to porting/compare; this only makes sure the
# two observation sets it compares were produced under identical conditions.

require "fileutils"
require "optparse"
require "tmpdir"

ROOT = File.expand_path("..", __dir__)
RUNNERS = File.join(ROOT, "porting", "runners")
COMPARE = File.join(ROOT, "porting", "compare", "compare")
DEFAULT_CASES = File.join(RUNNERS, "cases", "phase1.jsonl")

# QUICK is the smoke subset: one case per behavior class the write path can
# break, and nothing else. It is not a sample of the corpus — it is a chosen
# spanning set, so a green quick run means the shapes are right and only the
# long tail is unproven.
#
#   a structured read           cli-list-json-small-gtd
#   a whole-store validation    cli-check-empty-store
#   a create                    cli-capture-small-gtd
#   a state transition          cli-done-small-gtd
#   a patch over unknown keys   cli-priority-forward-compat
#   a delegation write          cli-delegate-agent-ready
#   a delegation conflict       cli-claim-same-owner-retry
#   a write that rolls back     cli-capture-readonly-rollback
QUICK = %w[
  cli-list-json-small-gtd
  cli-check-empty-store
  cli-capture-small-gtd
  cli-done-small-gtd
  cli-priority-forward-compat
  cli-delegate-agent-ready
  cli-claim-same-owner-retry
  cli-capture-readonly-rollback
].freeze

options = {
  cases: DEFAULT_CASES,
  only: [],
  quick: false,
  out: nil,
  keep: false,
  format: "text",
  verbose: false,
  work: nil,
  report: nil
}

parser = OptionParser.new do |o|
  o.banner = "usage: conform [options]"
  o.on("--cases FILE", "case list to run (default #{DEFAULT_CASES.sub("#{ROOT}/", "")})") { |v| options[:cases] = v }
  o.on("--quick", "run only the #{QUICK.length}-case smoke subset") { options[:quick] = true }
  o.on("--case ID", "run only this case (repeatable; implies the case list contains it)") { |v| options[:only] << v }
  o.on("--out DIR", "keep both observation sets under DIR (default: a temp dir, removed)") { |v| options[:out] = v }
  o.on("--work DIR", "parent directory for fixture copies; both sides get the same one") { |v| options[:work] = v }
  o.on("--keep", "keep fixture copies after the run") { options[:keep] = true }
  o.on("--json", "emit the comparator's structured report instead of the human one") { options[:format] = "json" }
  o.on("--report FILE", "also write the report to FILE") { |v| options[:report] = v }
  o.on("--verbose", "show each runner's per-case progress") { options[:verbose] = true }
  o.on("-h", "--help") { puts o; exit 0 }
end

begin
  parser.parse!
rescue OptionParser::ParseError => e
  warn "conform: #{e.message}"
  exit 2
end

unless ARGV.empty?
  warn "conform: unexpected argument #{ARGV.first.inspect}"
  warn parser.help
  exit 2
end

unless File.file?(options[:cases])
  warn "conform: no case list at #{options[:cases]}"
  exit 2
end

selected = options[:only]
selected = QUICK if options[:quick] && selected.empty?
if options[:quick] && !options[:only].empty?
  warn "conform: --quick and --case are alternatives; --case wins"
end

# Both sides must land in ONE observation root, because the whole point is that
# they are produced under identical conditions and compared without a third
# decision about where each half lives.
out_root = options[:out] ? File.expand_path(options[:out]) : File.join(Dir.tmpdir, "tasks-conform-#{Process.pid}")
ruby_out = File.join(out_root, "ruby")
go_out = File.join(out_root, "go")
FileUtils.mkdir_p([ruby_out, go_out])

def run_side(name, runner, out_dir, cases, selected, options)
  argv = [runner, "--out", out_dir, "--pin-identity"]
  # --pin-identity on BOTH sides or neither: an unpinned observation id is a
  # harness_error in the comparator, and a run with one side pinned would report
  # it as one for every case.
  argv += ["--work", options[:work]] if options[:work]
  argv << "--keep" if options[:keep]
  argv << "--quiet" unless options[:verbose]
  selected.each { |id| argv += ["--case", id] }
  argv << cases

  warn "conform: #{name} …" unless options[:verbose]
  # The runner's own exit status is 1 when a CASE failed to execute, which is
  # not the same thing as a mismatch and must not be reported as one. Either way
  # the observations it did write are still compared; what is fatal is a runner
  # that could not start at all.
  system(*argv)
  status = $?
  raise "#{name} runner could not be executed" if status.nil?
  raise "#{name} runner died on signal #{status.termsig}" if status.signaled?

  status.exitstatus
end

begin
  ruby_status = run_side("ruby", File.join(RUNNERS, "ruby", "run"), ruby_out, options[:cases], selected, options)
  go_status = run_side("go", File.join(RUNNERS, "go", "run"), go_out, options[:cases], selected, options)
rescue RuntimeError => e
  warn "conform: #{e.message}"
  FileUtils.rm_rf(out_root) unless options[:out]
  exit 2
end

# A usage/config failure from either runner (exit 2) means the comparison would
# be over an incomplete set. Exit 1 from a runner means a case failed to execute
# and IS worth comparing — the observation records the failure, and the
# comparator is the thing entitled to classify it.
if ruby_status == 2 || go_status == 2
  warn "conform: a runner refused its arguments (ruby=#{ruby_status} go=#{go_status}); no verdict"
  FileUtils.rm_rf(out_root) unless options[:out]
  exit 2
end

compare_argv = [COMPARE]
compare_argv << "--json" if options[:format] == "json"
compare_argv += ["--out", options[:report]] if options[:report]
compare_argv += [ruby_out, go_out]

system(*compare_argv)
verdict = $?.exitstatus

if options[:out]
  warn "conform: observations kept at #{out_root}"
else
  FileUtils.rm_rf(out_root)
end

# A runner that failed a case while the comparison passed is a green report over
# a red run, and reporting only the green half would be the exact overclaim this
# tool exists to prevent.
if verdict.zero? && (ruby_status != 0 || go_status != 0)
  warn "conform: the comparison passed but a runner reported a failed case " \
       "(ruby=#{ruby_status} go=#{go_status}) — re-run with --verbose"
  exit 1
end

exit verdict
