#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "open3"
require "pathname"

ROOT = Pathname.new(__dir__).join("../../..").realpath
CASES = ROOT.join("porting/runners/cases/query-filter-parse.jsonl")
RUBY_PROBE = ROOT.join("porting/runners/ruby/query-filter-parse-probe")

def run(*command, **options)
  stdout, stderr, status = Open3.capture3(*command, **options)
  abort "failed: #{command.join(" ")}\n#{stderr}" unless status.success?

  stdout.lines.filter_map do |line|
    stripped = line.strip
    JSON.parse(stripped) unless stripped.empty?
  end
end

ruby = run(RUBY_PROBE.to_s, CASES.to_s)
go = run("go", "run", "./cmd/query-filter-parse-probe", "../porting/runners/cases/query-filter-parse.jsonl", chdir: ROOT.join("go").to_s)
abort "query-filter-parse mismatch\nRuby: #{JSON.pretty_generate(ruby)}\nGo: #{JSON.pretty_generate(go)}" unless ruby == go

puts "query-filter-parse direct conformance: #{ruby.length}/#{ruby.length} cases matched"
