#!/usr/bin/env ruby
# frozen_string_literal: true

# Compare the direct parser result for every format-parse fixture. This is a
# transitional, slice-local conformance seam: it does not pretend to be the
# full CLI observation runner, whose check/list surface requires later slices.

require "json"
require "open3"
require "pathname"
require "tmpdir"

ROOT = Pathname.new(__dir__).join("../../..").realpath
CASES = ROOT.join("porting/runners/cases/format-parse.jsonl")
RUBY_PROBE = ROOT.join("porting/runners/ruby/format-parse-probe")

def run(*command, **options)
  stdout, stderr, status = Open3.capture3(*command, **options)
  abort "failed: #{command.join(" ")}\n#{stderr}" unless status.success?

  JSON.parse(stdout)
end

go_probe = ARGV.empty? ? ["go", "run", "./cmd/format-parse-probe"] : ARGV
Dir.mktmpdir("tasks-format-parse-conformance-") do |work|
  cases = CASES.readlines(chomp: true).filter_map do |line|
    stripped = line.strip
    next if stripped.empty? || stripped.start_with?("#")

    JSON.parse(stripped)
  end

  cases.each do |kase|
    store = ROOT.join("porting/fixtures", kase.fetch("fixture"), "store/tasks.jsonl").to_s
    ruby = run(RUBY_PROBE.to_s, store)
    go = run(*go_probe, store, chdir: ROOT.join("go").to_s)
    next if ruby == go

    File.write(File.join(work, "#{kase.fetch("case_id")}-ruby.json"), JSON.pretty_generate(ruby) + "\n")
    File.write(File.join(work, "#{kase.fetch("case_id")}-go.json"), JSON.pretty_generate(go) + "\n")
    abort "format-parse mismatch for #{kase.fetch("case_id")}; details in #{work}"
  end
end

puts "format-parse direct conformance: 11/11 cases matched"
