#!/usr/bin/env ruby
# frozen_string_literal: true

# Compare the direct Store Item projection until the query and CLI slices make
# the full language-neutral runner applicable to this read-model boundary.

require "json"
require "open3"
require "pathname"
require "tmpdir"

ROOT = Pathname.new(__dir__).join("../../..").realpath
CASES = ROOT.join("porting/runners/cases/store-snapshot-items.jsonl")
RUBY_PROBE = ROOT.join("porting/runners/ruby/store-snapshot-probe")

def run(*command, **options)
  stdout, stderr, status = Open3.capture3(*command, **options)
  abort "failed: #{command.join(" ")}\n#{stderr}" unless status.success?

  JSON.parse(stdout)
end

go_probe = ARGV.empty? ? ["go", "run", "./cmd/store-snapshot-probe"] : ARGV
Dir.mktmpdir("tasks-store-snapshot-conformance-") do |work|
  cases = CASES.readlines(chomp: true).filter_map do |line|
    stripped = line.strip
    next if stripped.empty? || stripped.start_with?("#")

    JSON.parse(stripped)
  end

  cases.each do |kase|
    fixture = ROOT.join("porting/fixtures", kase.fetch("fixture"), "store")
    live = fixture.join("tasks.jsonl").to_s
    archive = fixture.join("archive.jsonl")
    arguments = [live]
    arguments << archive.to_s if archive.exist?
    ruby = run(RUBY_PROBE.to_s, *arguments)
    go = run(*go_probe, *arguments, chdir: ROOT.join("go").to_s)
    next if ruby == go

    File.write(File.join(work, "#{kase.fetch("case_id")}-ruby.json"), JSON.pretty_generate(ruby) + "\n")
    File.write(File.join(work, "#{kase.fetch("case_id")}-go.json"), JSON.pretty_generate(go) + "\n")
    abort "store-snapshot-items mismatch for #{kase.fetch("case_id")}; details in #{work}"
  end

  missing_live = File.join(work, "missing-tasks.jsonl")
  missing_archive = File.join(work, "missing-archive.jsonl")
  ruby = run("ruby", "-I#{ROOT.join("lib")}", "-rjson", "-e", <<~'RUBY', missing_live, missing_archive)
    require "tasks/store"
    store = Tasks::Store.new(org: ARGV.fetch(0), archive: ARGV.fetch(1))
    snapshot = store.read_snapshot
    puts JSON.generate("live" => snapshot.items, "archive" => snapshot.archive_items)
  RUBY
  go = run(*go_probe, missing_live, missing_archive, chdir: ROOT.join("go").to_s)
  unless ruby == go
    File.write(File.join(work, "missing-live-ruby.json"), JSON.pretty_generate(ruby) + "\n")
    File.write(File.join(work, "missing-live-go.json"), JSON.pretty_generate(go) + "\n")
    abort "store-snapshot-items mismatch for missing-live; details in #{work}"
  end

  structured_live = File.join(work, "structured-tags.jsonl")
  File.write(structured_live, <<~JSONL)
    {"type":"meta","version":2}
    {"type":"task","id":"structured","state":"TODO","title":"Structured tags","tags":[["x",{"a":1}],{"first":"one","second":[true,null,"x"]}]}
  JSONL
  ruby = run(RUBY_PROBE.to_s, structured_live)
  go = run(*go_probe, structured_live, chdir: ROOT.join("go").to_s)
  unless ruby == go
    File.write(File.join(work, "structured-tags-ruby.json"), JSON.pretty_generate(ruby) + "\n")
    File.write(File.join(work, "structured-tags-go.json"), JSON.pretty_generate(go) + "\n")
    abort "store-snapshot-items mismatch for structured-tags; details in #{work}"
  end

  normalized_live = File.join(work, "normalized-structured-tags.jsonl")
  File.write(normalized_live, <<~JSONL)
    {"type":"meta","version":2}
    {"type":"task","id":"normalized","state":"TODO","title":"Normalized structured tags","tags":[{"a":1,"a":2},1e3,-0,1.2300]}
  JSONL
  ruby = run(RUBY_PROBE.to_s, normalized_live)
  go = run(*go_probe, normalized_live, chdir: ROOT.join("go").to_s)
  unless ruby == go
    File.write(File.join(work, "normalized-structured-tags-ruby.json"), JSON.pretty_generate(ruby) + "\n")
    File.write(File.join(work, "normalized-structured-tags-go.json"), JSON.pretty_generate(go) + "\n")
    abort "store-snapshot-items mismatch for normalized-structured-tags; details in #{work}"
  end

  float_live = File.join(work, "float-structured-tags.jsonl")
  File.write(float_live, <<~JSONL)
    {"type":"meta","version":2}
    {"type":"task","id":"floats","state":"TODO","title":"Float structured tags","tags":[1e6,1e7,1e-5,-0.0,0.000001,12345678901234567890.0,1e309]}
  JSONL
  ruby = run(RUBY_PROBE.to_s, float_live)
  go = run(*go_probe, float_live, chdir: ROOT.join("go").to_s)
  unless ruby == go
    File.write(File.join(work, "float-structured-tags-ruby.json"), JSON.pretty_generate(ruby) + "\n")
    File.write(File.join(work, "float-structured-tags-go.json"), JSON.pretty_generate(go) + "\n")
    abort "store-snapshot-items mismatch for float-structured-tags; details in #{work}"
  end

  structured_id_live = File.join(work, "structured-ids.jsonl")
  File.write(structured_id_live, <<~JSONL)
    {"type":"meta","version":2}
    {"type":"task","id":{"b":1,"a":[true,null,"x"]},"state":"TODO","title":"Hash id"}
    {"type":"task","id":["a",{"n":1.5},[]],"state":"TODO","title":"Array id"}
    {"type":"task","id":12,"state":"TODO","title":"Integer id"}
    {"type":"task","id":1e3,"state":"TODO","title":"Float id"}
    {"type":"task","id":true,"state":"TODO","title":"Boolean id"}
    {"type":"task","id":"","state":"TODO","title":"Empty id"}
  JSONL
  ruby = run(RUBY_PROBE.to_s, structured_id_live)
  go = run(*go_probe, structured_id_live, chdir: ROOT.join("go").to_s)
  unless ruby == go
    File.write(File.join(work, "structured-ids-ruby.json"), JSON.pretty_generate(ruby) + "\n")
    File.write(File.join(work, "structured-ids-go.json"), JSON.pretty_generate(go) + "\n")
    abort "store-snapshot-items mismatch for structured-ids; details in #{work}"
  end

  # Date forms through the whole store boundary, not just the parser: every one
  # of these is a form `time.Parse("2006-01-02")` silently dropped to nil. Only
  # absolute forms appear here, so this case stays independent of today; the
  # today-relative forms are compared under one injected date by
  # `porting/evidence/store-snapshot-items/date-conformance`.
  date_live = File.join(work, "date-forms.jsonl")
  File.write(date_live, <<~JSONL)
    {"type":"meta","version":2}
    {"type":"task","id":"basic","state":"TODO","title":"Basic","scheduled":"20260802","deadline":"2026-08","closed":"2024-366"}
    {"type":"task","id":"ordinal","state":"TODO","title":"Ordinal","scheduled":"2026-215","deadline":"2026215","closed":"2026-366"}
    {"type":"task","id":"week","state":"TODO","title":"Week","scheduled":"2026-W31-7","deadline":"2026W011","closed":"2026-W31"}
    {"type":"task","id":"datetime","state":"TODO","title":"Datetime","scheduled":"2026-08-02T10:11:12Z","deadline":"20260802T101112Z","closed":"2026-08-02 10:11:12"}
    {"type":"task","id":"padded","state":"TODO","title":"Padded","scheduled":" 2026-08-02","deadline":"\\t2026-08-02\\n","closed":"2026-08-02x"}
    {"type":"task","id":"refused","state":"TODO","title":"Refused","scheduled":"2026-8-2","deadline":"2026-02-30","closed":"2026-W31-0"}
    {"type":"task","id":"reform","state":"TODO","title":"Reform","scheduled":"1582-10-04","deadline":"1582-10-10","closed":"1582-10-15"}
  JSONL
  ruby = run(RUBY_PROBE.to_s, date_live)
  go = run(*go_probe, date_live, chdir: ROOT.join("go").to_s)
  unless ruby == go
    File.write(File.join(work, "date-forms-ruby.json"), JSON.pretty_generate(ruby) + "\n")
    File.write(File.join(work, "date-forms-go.json"), JSON.pretty_generate(go) + "\n")
    abort "store-snapshot-items mismatch for date-forms; details in #{work}"
  end

  total = cases.length + 6
  puts "store-snapshot-items direct conformance: #{total}/#{total} cases matched"
end
