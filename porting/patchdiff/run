#!/usr/bin/env bash
# Run every field-patch differential batch: same fixtures, both stores, diff the
# typed outcome, the store bytes and the journal.
#
#   porting/patchdiff/run              # all four batches
#   porting/patchdiff/run fields.json  # one batch
#
# Never touches real task data: every case runs in its own mkdtemp.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../.." && pwd)"

probe="$here/patch-diff-probe"
(cd "$root/go" && go build -o "$probe" ./cmd/patch-diff-probe)

batches=("$@")
if [ ${#batches[@]} -eq 0 ]; then
  for generator in cases_fields cases_recurrence cases_delegation cases_changeset; do
    python3 "$here/$generator.py" >/dev/null
  done
  batches=(fields.json recurrence.json delegation.json changeset.json)
fi

status=0
for batch in "${batches[@]}"; do
  echo "== $batch"
  python3 "$here/diff.py" "$root" "$batch" | tail -1 || status=1
done
exit "$status"
