#!/usr/bin/env ruby
# frozen_string_literal: true

# Capture TaskFilter's pure argument-to-value contract. This intentionally
# bypasses the fixture runner: neither parse_cli nor TaskFilter.new reads or
# writes a task store, so introducing a fixture copy would obscure the actual
# subject of the slice.

require "json"
require_relative "../../../lib/tasks/task_queries"

def filter_json(filter)
  {
    "scope" => filter.scope.to_s,
    "include_archive" => filter.include_archive?,
    "deferred_only" => filter.deferred_only,
    "unavailable_only" => filter.unavailable_only,
    "someday_only" => filter.someday_only,
    "recurring_only" => filter.recurring_only,
    "body_search" => filter.body_search,
    "delegated_only" => filter.delegated_only,
    "agent_ready_only" => filter.agent_ready_only,
    "contexts" => filter.contexts,
    "tags" => filter.tags,
    "priority" => filter.priority,
    "state" => filter.state,
    "states" => filter.states,
    "text" => filter.text,
    "text_query" => filter.text_query
  }
end

def observe(case_spec)
  filter, json = case case_spec.fetch("operation")
                 when "parse_cli"
                   parsed = Tasks::TaskFilter.parse_cli(case_spec.fetch("argv"))
                   [parsed.filter, parsed.json]
                 when "new"
                   [Tasks::TaskFilter.new(**case_spec.fetch("kwargs", {}).transform_keys(&:to_sym)), nil]
                 else
                   raise ArgumentError, "unknown operation: #{case_spec.fetch("operation")}"
                 end

  { "case_id" => case_spec.fetch("case_id"), "ok" => true,
    "json" => json, "filter" => filter_json(filter) }
rescue ArgumentError => error
  { "case_id" => case_spec.fetch("case_id"), "ok" => false,
    "error" => { "class" => error.class.name, "message" => error.message } }
end

abort "usage: #{File.basename($PROGRAM_NAME)} CASES.jsonl" unless ARGV.length == 1

File.foreach(ARGV.fetch(0), chomp: true) do |line|
  next if line.strip.empty? || line.lstrip.start_with?("#")

  puts JSON.generate(observe(JSON.parse(line)))
end
