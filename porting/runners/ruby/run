#!/usr/bin/env ruby
# frozen_string_literal: true

# run — the Ruby oracle's runner.
#
#   porting/runners/ruby/run porting/runners/cases/phase1.jsonl
#   porting/runners/ruby/run --out evidence/ruby porting/runners/cases/phase1.jsonl
#   porting/runners/ruby/run --case cli-list-small-gtd --pin-identity cases.jsonl
#
# The protocol lives in porting/runners/README.md and the harness that
# implements it lives in ../lib/harness.rb. This file is only the part that is
# Ruby-specific: which program is the CLI, and which is the probe.

require "rbconfig"
require_relative "../lib/harness"

TARGET = PortingRunner::Target.new(
  name: "ruby",
  cli: [RbConfig.ruby, File.expand_path("../../../bin/tasks", __dir__)],
  probe: [RbConfig.ruby, File.expand_path("probe", __dir__)]
)

exit PortingRunner::CLIEntry.run(ARGV, TARGET) if $PROGRAM_NAME == __FILE__
