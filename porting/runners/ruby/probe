#!/usr/bin/env ruby
# frozen_string_literal: true

# probe — the Ruby implementation's self-report, for the conformance runner.
#
#   probe <copy-root>
#
# Prints ONE JSON object on stdout and exits 0. Every runner ships a probe of
# its own (`porting/runners/<impl>/probe`) that prints the SAME object from the
# same inputs; the object's shape is the contract, the language behind it is
# not. See porting/runners/README.md § "The probe".
#
# It exists because two things an observation must record cannot be read off
# the CLI's output:
#
#   1. **Revision tokens.** No CLI command prints `s1.` / `v1.` tokens (they are
#      user-visible only over HTTP, which Phase 1 does not port). Deriving them
#      inside the harness would mean re-implementing the product's revision
#      algorithm in the harness — and then the harness could not detect a port
#      that got that algorithm wrong, which is one of the five seeded-mismatch
#      classes the Phase 1 gate tests. So the probe asks the implementation.
#
#   2. **Which pins were actually applied.** A pin that was set and silently
#      ignored produces a run that looks reproducible and is not. Only the
#      implementation knows what it resolved, so only the implementation can
#      answer. `Tasks::Determinism.report` is the seam that answers it.
#
# The probe is READ-ONLY with respect to the store's own bytes, but it is not
# side-effect free: reading a snapshot takes the store lock, which creates
# `.tasks.jsonl.lock` when it is absent. The runner therefore runs the probe
# only AFTER it has captured the post-invocation tree (and runs the
# before-probe against a separate throwaway copy), so a probe can never mask
# the lock-creation delta the port is supposed to reproduce.

require "json"

ROOT = File.expand_path("../../..", __dir__)
require_relative "#{ROOT}/lib/tasks/config"
require_relative "#{ROOT}/lib/tasks/dates"
require_relative "#{ROOT}/lib/tasks/determinism"
require_relative "#{ROOT}/lib/tasks/journal"
require_relative "#{ROOT}/lib/tasks/store"
require_relative "#{ROOT}/lib/tasks/timezones"
require_relative "#{ROOT}/lib/tasks/update_stamp"

PROBE_VERSION = 1

copy_root = ARGV[0]
abort "usage: probe <copy-root>" if copy_root.nil? || copy_root.empty?

# Resolve exactly as `bin/tasks` does, from the same environment the invocation
# ran under: anything else would report tokens for a different store than the
# one under test.
paths = Tasks::Config.resolve(default_dir: copy_root)
Tasks::Dates.configure!(date_order: paths.date_order)

store_pins = {
  now: Tasks::Determinism.clock,
  id_source: Tasks::Determinism.id_source,
  coalesce_scope: Tasks::Determinism.coalesce_scope
}.compact

# --- revisions --------------------------------------------------------------
#
# `checked_read_snapshot` is the API-grade read: it returns the content-derived
# store revision for the exact bytes on disk even when those bytes are invalid,
# and a snapshot (hence per-task revisions) only when they are not. A malformed
# fixture therefore still yields a store token, which is the honest answer — the
# token is a digest of bytes, not an assertion that they parse.
revisions = begin
  store = Tasks::Store.new(org: paths.org, archive: paths.archive, links: paths.links,
                           link_systems: paths.link_systems, max_depth: paths.max_depth,
                           **store_pins)
  checked = store.checked_read_snapshot
  snapshot = checked.snapshot
  resources = []
  if snapshot
    snapshot.items.each do |item|
      next unless item.id

      resources << { "id" => item.id, "kind" => "task", "revision" => snapshot.revision_for(item) }
    end
    snapshot.archive_items.each do |item|
      next unless item.id

      resources << { "id" => item.id, "kind" => "archived_task",
                     "revision" => snapshot.revision_for(item) }
    end
  end
  { "status" => checked.status.to_s,
    "store" => checked.store_revision,
    "resources" => resources.sort_by { |r| [r["id"], r["kind"]] } }
rescue StandardError => e
  # A probe that cannot read the store says so; it never guesses a token.
  { "status" => "probe_error", "store" => nil, "resources" => [],
    "error" => "#{e.class}: #{e.message}" }
end

# --- pins -------------------------------------------------------------------
#
# `applied` answers "did the implementation USE this?", and `value` is what the
# implementation RESOLVED it to — not the raw string it was handed. Reporting
# the resolved value is what catches two implementations parsing one pin
# differently, and `applied: false` alongside a non-null request is what catches
# a pin that was accepted and dropped. The runner treats that combination as a
# hard failure.
def requested(env, name)
  raw = env[name]
  raw.nil? || raw.to_s.strip.empty? ? nil : raw.to_s
end

env = ENV
pins = []
add = ->(name, applied, value) { pins << { "name" => name, "applied" => applied, "value" => value } }

now_request = requested(env, Tasks::Determinism::NOW)
begin
  resolved_now = Tasks::Determinism.now(env: env)
  add.call(Tasks::Determinism::NOW, !resolved_now.nil?, resolved_now&.iso8601)
rescue ArgumentError
  # Malformed and therefore NOT applied — reported rather than raised, so the
  # runner can fail the case with the requested value in evidence.
  add.call(Tasks::Determinism::NOW, false, now_request)
end

ids_request = requested(env, Tasks::Determinism::IDS)
begin
  sequence = ids_request && Tasks::Determinism::IdSequence.new(ids_request)
  add.call(Tasks::Determinism::IDS, !sequence.nil?, ids_request)
rescue ArgumentError
  add.call(Tasks::Determinism::IDS, false, ids_request)
end

scope = Tasks::Determinism.coalesce_scope(env: env)
add.call(Tasks::Determinism::COALESCE_SCOPE, !scope.nil?, scope)

delegation_request = requested(env, Tasks::Determinism::DELEGATION_KEYS)
begin
  delegation_source = delegation_request && Tasks::Determinism.delegation_key_source(env: env)
  add.call(Tasks::Determinism::DELEGATION_KEYS, !delegation_source.nil?, delegation_request)
rescue ArgumentError
  add.call(Tasks::Determinism::DELEGATION_KEYS, false, delegation_request)
end

# `applied` for the hostname pin is a CALL-SITE check, not a module check.
# There are two hostname consumers — Config's host-context selection and the
# device half of the update stamp — and a pin that reaches only one of them is
# the exact failure `applied` exists to catch. So each consumer is asked what it
# actually resolved, and the pin counts as applied only when both agree with it.
# `TASKS_DEVICE` legitimately out-ranks the hostname for the device slug, so
# that consumer is only interrogated when no device override is set.
hostname_request = requested(env, Tasks::Determinism::HOSTNAME)
resolved_hostname = Tasks::Determinism.hostname(env: env).call.to_s
device_override = requested(env, Tasks::Determinism::DEVICE)
device_slug = Tasks::UpdateStamp.device(env: env)
hostname_consumers_agree =
  !hostname_request.nil? &&
  paths.hostname.to_s == hostname_request &&
  resolved_hostname == hostname_request &&
  (!device_override.nil? || device_slug == Tasks::UpdateStamp.slug(hostname_request))
add.call(Tasks::Determinism::HOSTNAME, hostname_consumers_agree,
         hostname_request && resolved_hostname)

# The test-only clock seam, reported because it is a clock input and because
# `Tasks::Determinism` is now where it resolves. The reported `value` is the
# instant the whole clock precedence actually produced, so an implementation
# that got the precedence backwards reports a different one — which is the only
# way this seam can be checked from outside the process.
#
# Being out-ranked by TASKS_PIN_NOW counts as APPLIED, not as a dropped pin —
# the same rule TASKS_DEVICE gets against the hostname pin above. Reporting a
# legitimate override as `applied: false` would make the runner fail a correct
# case, which is how an invariant stops being believed.
sequence_request = requested(env, Tasks::Determinism::TEST_TODAY_SEQUENCE)
sequence_resolved =
  begin
    sequence_request && Tasks::Determinism.now_for_adapter(env: env).utc.iso8601
  rescue ArgumentError
    # A malformed TASKS_PIN_NOW; that pin already reported itself unapplied
    # above and this seam has nothing further to say about it.
    nil
  end
add.call(Tasks::Determinism::TEST_TODAY_SEQUENCE,
         !sequence_request.nil? && !sequence_resolved.nil?, sequence_resolved)

winsize = Tasks::Determinism.winsize(env: env)
add.call(Tasks::Determinism::LINES, !winsize.nil?, winsize && winsize[0].to_s)
add.call(Tasks::Determinism::COLUMNS, !winsize.nil?, winsize && winsize[1].to_s)

device_request = requested(env, Tasks::Determinism::DEVICE)
add.call(Tasks::Determinism::DEVICE, !device_request.nil?,
         device_request && Tasks::UpdateStamp.device(env: env))

# TZ resolves through Config, so `applied` is the strict test: the pin counts as
# applied only when the zone the implementation ended up with is the zone that
# was asked for. A silent fallback to Etc/UTC reports applied: false.
tz_request = requested(env, Tasks::Determinism::TZ)
add.call(Tasks::Determinism::TZ, !tz_request.nil? && paths.timezone == tz_request,
         tz_request && paths.timezone)

# TASKS_TIMEZONE is a product setting rather than one of Determinism's KEYS,
# but the harness pins it (it out-ranks TZ), so it is reported here too: a pin
# the runner sets and nobody reports is exactly the blind spot `applied` exists
# to close. `porting/specs/determinism.md` lists TZ only, and should name both.
timezone_request = requested(env, "TASKS_TIMEZONE")
add.call("TASKS_TIMEZONE", !timezone_request.nil? && paths.timezone == timezone_request,
         timezone_request && paths.timezone)

# LANG/LC_ALL are applied when the process's default external encoding is the
# encoding they name; that is the only effect they have here.
locale_encoding = Encoding.default_external.to_s
[Tasks::Determinism::LANG, Tasks::Determinism::LC_ALL].each do |name|
  request = requested(env, name)
  applied = !request.nil? &&
            request.split(".", 2).last.to_s.delete("-").casecmp?(locale_encoding.delete("-"))
  add.call(name, applied, request && locale_encoding)
end

# Colour. Four environment names and no more — read off the source rather than
# taken from the conventional list. `NO_COLOR` and `TASKS_THEME` reach
# `Config#pick_theme` (TASKS_THEME out-ranks NO_COLOR, and the resolved answer is
# `paths.theme`); `COLORTERM` and `TERM` reach `Tui::Border.truecolor?` and
# `Tui::App#mouse_enabled?`, which the CLI surface does not run. `CLICOLOR` and
# `CLICOLOR_FORCE` are read NOWHERE in bin/ or lib/ and are deliberately absent.
#
# The harness pins all four to unset, so `applied` is false and `value` is null
# on every Phase-1 observation. That is the honest report and it is worth
# emitting: it says the implementation resolved colour from nothing, which is a
# fact about the run, whereas a missing pin row says only that nobody asked.
#
# What is NOT reported here, on purpose: whether stdout was a terminal. That is
# the input the CLI's `color()` actually branches on, and this probe cannot
# answer it — the probe's own stdout is a pipe, so any answer it gave would
# describe the probe rather than the invocation. Only the runner knows what it
# attached, so it records it, in `invocation.tty`.
#
# `applied` for both theme inputs is answered from the implementation's own
# precedence report (`Config` records WHICH source decided the theme), not from
# a re-derivation here. NO_COLOR is legitimately out-ranked by TASKS_THEME and
# by a config-file `theme` key, so — exactly as TASKS_DEVICE out-ranks the
# hostname pin above — being overridden counts as applied rather than as a
# dropped pin, which would otherwise fail a perfectly correct case.
theme_source = paths.sources[:theme].to_s
theme_request = requested(env, "TASKS_THEME")
add.call("TASKS_THEME", !theme_request.nil? && theme_source == "TASKS_THEME env",
         theme_request && paths.theme)

no_color_request = requested(env, "NO_COLOR")
add.call("NO_COLOR",
         !no_color_request.nil? && ["NO_COLOR env", "TASKS_THEME env", "config file"].include?(theme_source),
         no_color_request && paths.theme)

%w[TERM COLORTERM].each do |name|
  request = requested(env, name)
  add.call(name, !request.nil?, request)
end

report = Tasks::Determinism.report(env: env)

# --- paths ------------------------------------------------------------------
#
# The paths the implementation ACTUALLY resolved, so the runner can assign
# `files[].role` from them instead of from a table of hardcoded filenames. The
# two spellings are both reported because both can appear in the tree: a
# symlinked store has a `configured` path (the link) and a `canonical` one (the
# bytes), and a harness that knew only the first would record the file carrying
# the store's bytes as `role: "other"`.
def canonical(path)
  path && Tasks::Journal.canonical(path)
rescue StandardError
  path
end

paths_report = {
  "store" => paths.org,
  "store_canonical" => canonical(paths.org),
  "archive" => paths.archive,
  "archive_canonical" => canonical(paths.archive),
  "memory" => paths.memory,
  "config" => paths.config_file,
  "journal_dir" => (Tasks::Journal.dir_for(paths.org, env: env) if paths.org)
}

puts JSON.generate(
  "probe_version" => PROBE_VERSION,
  "revisions" => revisions,
  "paths" => paths_report,
  "pins" => pins.sort_by { |pin| pin["name"] },
  "environment" => {
    "tzdb_version" => report["tzdb_version"],
    "platform" => report["ruby_platform"],
    "locale" => locale_encoding,
    "runtime" => "ruby #{report["ruby_version"]}"
  }
)
