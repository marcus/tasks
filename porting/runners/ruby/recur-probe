#!/usr/bin/env ruby
# frozen_string_literal: true

# Direct oracle for the interval half of Tasks::Recur. The CLI recurrence
# commands and calendar grammar are later slices, so this compares only the
# package boundary claimed by recur-interval-cookies.

require "date"
require "json"

ROOT = File.expand_path("../../..", __dir__)
require_relative "#{ROOT}/lib/tasks/recur"

path = ARGV.fetch(0) { abort "usage: recur-probe CASES.jsonl" }
abort "usage: recur-probe CASES.jsonl" unless ARGV.one?

def parse_outcome(input, default_prefix)
  result = Tasks::Recur.parse_result(input, default_prefix: default_prefix)
  { "canonical" => result[:canonical]&.to_s, "error" => result[:error] }
end

def next_outcome(input, spec)
  value = Tasks::Recur.next_date(input, from: Date.iso8601(spec.fetch("from")), today: Date.iso8601(spec.fetch("today")))
  { "value" => value.iso8601, "error" => nil }
rescue ArgumentError => error
  { "value" => nil, "error" => error.message }
end

File.readlines(path, chomp: true).each do |line|
  next if line.strip.empty? || line.strip.start_with?("#")

  spec = JSON.parse(line)
  input = spec.fetch("input")
  out = {
    "case_id" => spec.fetch("case_id"),
    "parse" => parse_outcome(input, spec.fetch("default_prefix", ".+")),
    "cookie" => Tasks::Recur.cookie?(input)
  }
  out["humanize"] = Tasks::Recur.humanize(spec.fetch("humanize")) if spec.key?("humanize")
  out["next"] = next_outcome(input, spec.fetch("next")) if spec.key?("next")
  puts JSON.generate(out)
end
