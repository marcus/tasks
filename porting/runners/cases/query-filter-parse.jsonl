{"case_id":"query-filter-unknown-keyword-escapes","operation":"new","kwargs":{"quote\"q":1}}
# `/\A\+(.+)/`: Ruby's `.` never matches "\n", so the tag stops at the first
# newline and a "+" followed immediately by one is not a tag at all.
{"case_id":"query-filter-tag-embedded-newline","operation":"parse_cli","argv":["+alpha\nbeta"]}
{"case_id":"query-filter-tag-leading-newline","operation":"parse_cli","argv":["+\nbeta"]}
{"case_id":"query-filter-tag-trailing-newline","operation":"parse_cli","argv":["+alpha\n"]}
{"case_id":"query-filter-tag-only-newline","operation":"parse_cli","argv":["+\n"]}
