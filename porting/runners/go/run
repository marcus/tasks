#!/usr/bin/env ruby
# frozen_string_literal: true

# run — the Go port's runner, the exact counterpart of ../ruby/run.
#
#   porting/runners/go/run porting/runners/cases/phase1.jsonl
#   porting/runners/go/run --out /tmp/go --pin-identity porting/runners/cases/phase1.jsonl
#
# Same options, same pinned environment, same observation JSON as the Ruby
# runner, because it is the same harness: the protocol lives in
# ../README.md, the harness that implements it lives in ../lib/harness.rb, and
# this file is only the part that is Go-specific — which binary is the CLI,
# which is the probe, and how they get built.
#
# Why the harness is shared rather than reimplemented in Go: every runner-side
# value in an observation (the pinned environment map, the tree walk,
# fixture.root_sha256, the deltas, sha256_normalized) is compared field-for-field
# by porting/compare and classified HARNESS_ERROR when it differs. A second,
# independently written harness would report its own base64/sorting/digest
# divergences as port defects. Everything the IMPLEMENTATION answers still comes
# from Go: `probe` below is a Go binary linking the Go store package, so
# `revisions`, `pins` and the resolved `paths` are the port's own code and a
# divergence in any of them is a real mismatch. That is exactly the split
# ../README.md § "Why revision tokens come from a probe" asks for.
#
# The build step runs once, before any case, in the OPERATOR's environment: the
# pinned PATH an invocation gets is /usr/bin:/bin:/usr/sbin:/sbin, which has no
# Go toolchain on it by design.

require_relative "../lib/harness"

GO_DIR = File.expand_path("../../../go", __dir__)
BIN_DIR = File.join(GO_DIR, "bin")

TARGET = PortingRunner::Target.new(
  name: "go",
  cli: [File.join(BIN_DIR, "tasks")],
  probe: [File.join(BIN_DIR, "tasks-probe")],
  prepare: lambda do
    build = File.expand_path("build", __dir__)
    unless system(build)
      raise PortingRunner::Error, "go build failed — run #{build} and fix it before running the corpus"
    end
  end
)

exit PortingRunner::CLIEntry.run(ARGV, TARGET) if $PROGRAM_NAME == __FILE__
