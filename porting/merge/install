#!/usr/bin/env ruby
# frozen_string_literal: true

# porting/merge/install — wire up the manifest-merge-driver as the git merge
# driver for porting/manifest.jsonl in a checkout of THIS repo.
#
#   porting/merge/install [repo]     # defaults to this checkout's toplevel
#
# This is deliberately a separate installer from bin/install-merge-driver
# rather than an extra path bolted onto it. bin/install-merge-driver targets
# an arbitrary *task-data* repo -- wherever tasks.jsonl/archive.jsonl happen to
# live for a given user -- and requires that repo to already select
# `merge=tasksjsonl` for both files in its own .gitattributes, written by
# whatever set that data repo up. porting/manifest.jsonl is not user data; it
# is this source repo's own port-tracking file, always at the same path in
# this same tree, and this tree has no .gitattributes yet at all. So unlike
# bin/install-merge-driver, this installer OWNS creating/extending
# .gitattributes rather than requiring it to already exist -- there is no
# other mechanism that would.
#
# Idempotent: re-running updates the git config in place and only appends the
# .gitattributes line if it is not already present.

require "open3"
require "shellwords"

ROOT = File.expand_path("../..", __dir__)
DRIVER = File.join(__dir__, "manifest-merge-driver")
PATHNAME = "porting/manifest.jsonl"
ATTR_LINE = "#{PATHNAME} merge=portingmanifest"

def git_config(repo, key, value)
  _stdout, stderr, status = Open3.capture3("git", "-C", repo, "config", key, value)
  abort "git config #{key} failed: #{stderr.strip}" unless status.success?
end

repo = ARGV.shift
abort "usage: porting/merge/install [repo]" unless ARGV.empty?
repo = File.expand_path(repo || ROOT)

_top, stderr, status = Open3.capture3("git", "-C", repo, "rev-parse", "--show-toplevel")
abort "not a git repository: #{repo}#{stderr.empty? ? "" : " (#{stderr.strip})"}" unless status.success?

attributes = File.join(repo, ".gitattributes")
attribute_text = File.file?(attributes) ? File.read(attributes, encoding: "UTF-8") : ""
unless attribute_text.match?(/^\s*#{Regexp.escape(PATHNAME)}\s+merge=portingmanifest(?:\s|$)/)
  File.open(attributes, "a", encoding: "UTF-8") do |f|
    f.write("\n") unless attribute_text.empty? || attribute_text.end_with?("\n")
    f.puts(ATTR_LINE)
  end
  puts "added `#{ATTR_LINE}` to #{attributes}"
end

# %L/%X/%Y deliberately unquoted -- see manifest-merge-driver's header comment
# and lib/tasks/merge_driver_command.rb's install (bin/install-merge-driver)
# for why: Git pre-quotes them itself on rebase/cherry-pick, and quoting them
# again is a shell syntax error that silently drops this driver from those
# paths.
driver = "#{Shellwords.escape(DRIVER)} %O %A %B %P %L %X %Y"
git_config(repo, "merge.portingmanifest.name", "porting manifest jsonl 3-way record merge")
git_config(repo, "merge.portingmanifest.driver", driver)

puts "installed portingmanifest merge driver in #{repo}"
puts "  #{driver}"
