#!/usr/bin/env ruby
# frozen_string_literal: true

# manifest-issues — project porting/manifest.jsonl into td.
#
# The fleet's "what should I work on next" is a td query, but the truth about
# what there is to port lives in the manifest. This script is the one-way
# projection between them: one td epic per campaign, one td issue per slice,
# dependency edges wired from `depends_on`. It is safe to run at any time and
# safe to re-run after a failure — every write is preceded by a read that
# decides whether the write is needed at all, so a second run is a no-op.
#
#   porting/manifest-issues plan            # what sync would do; touches nothing
#   porting/manifest-issues sync            # create/update td to match the manifest
#   porting/manifest-issues sync --json     # same, machine-readable
#   porting/manifest-issues progress        # slice counts, generated from the manifest
#   porting/manifest-issues validate        # manifest self-consistency + source/test existence
#   porting/manifest-issues drift           # slices whose Ruby source moved past source_sha
#   porting/manifest-issues closure         # what drift watches per slice, and why
#   porting/manifest-issues reach           # oracle refs a slice cannot actually run
#
# `sync --dry-run` is a synonym for `plan`.
#
# Identity is a label, never a title: the issue for slice `format-parse` is the
# one carrying `slice:format-parse`. Retitle it in td, rename the behavior in
# the manifest, close it, reopen it — the mapping survives, because nothing
# about it is derived from text a human might edit.
#
# A slice whose `fixtures_todo` is still set also gets a second issue — the
# fixture gap — which the slice depends on. `td ready` lists open issues whose
# dependencies are met, so without that edge the fleet would be offered slices
# manifest.md forbids passing `characterizing`. The edge disappears on the sync
# after the corpus lands.
#
# What this script does NOT do: it never writes a td *status*. td owns work
# state (open / in_progress / in_review); the manifest's `status` field is port
# progress, which agents update in the manifest. Syncing status in either
# direction would let a generator run stomp on a claim. Gating is expressed as a
# dependency edge for exactly that reason — `td block` would be a status write.

require "json"
require "open3"
require "optparse"
require "tmpdir"

module ManifestIssues
  PORTING_DIR = File.expand_path(__dir__)
  REPO_ROOT = File.expand_path("..", PORTING_DIR)
  # The records, and the one seam a test uses to hand the script a different
  # set of them without writing to the tracked manifest. Paths only — REPO_ROOT
  # stays the repository, so source paths, oracle tests, and fixtures are still
  # resolved against the real tree.
  MANIFEST = ENV["MANIFEST_ISSUES_MANIFEST"] || File.join(PORTING_DIR, "manifest.jsonl")
  CAMPAIGNS = ENV["MANIFEST_ISSUES_CAMPAIGNS"] || File.join(PORTING_DIR, "campaigns.jsonl")

  # Every label this script owns. An issue is "ours" if it carries FLEET_LABEL;
  # within ours, the slice/campaign label is the durable identity.
  FLEET_LABEL = "porting"
  SLICE_LABEL = "porting-slice"
  CAMPAIGN_LABEL = "porting-campaign"
  # A slice whose `fixtures_todo` is still set cannot be proved, because
  # manifest.md forbids it passing `characterizing` while that field is
  # non-null. Advertising it in `td ready` would send a claiming agent at work
  # it must immediately hand back, so the missing corpus is projected as its own
  # issue and the slice takes a dependency edge on it. The gap is real work,
  # `td ready` offers the work that is actually startable, and no td *status* is
  # written to achieve it.
  GATE_LABEL = "porting-fixture-gate"

  RISKS = %w[low medium high].freeze
  # Points are a size signal for the fleet's scheduler, derived from the risk
  # tier's required evidence — not an independent estimate to keep in sync.
  RISK_POINTS = { "low" => 1, "medium" => 3, "high" => 5 }.freeze

  # PORTING.md's slice loop, scaled by risk. Restated here as acceptance text so
  # the tier's obligations travel with the issue an agent claims.
  RISK_ACCEPTANCE = {
    "low" => "Oracle capture -> translate -> compile -> differential conformance. " \
             "One combined review; self-approval allowed (td approve --self-review --reason).",
    "medium" => "Low tier, plus property tests and split source-fidelity / Go-idiom reviews. " \
                "Independent approval required.",
    "high" => "Full loop: medium tier, plus fault injection at every write boundary, real " \
              "competing processes, and stress and budget checks. Two independent reviews; " \
              "independent approval only.",
  }.freeze

  ALWAYS = "Never skipped at any tier: the manifest entry, the Ruby oracle capture, and " \
           "differential conformance. Anything else skipped is recorded in the manifest entry."

  STATUSES = %w[not_started characterizing translating conformance reviewing
                ported not_applicable blocking_cutover blocked].freeze
  # PORTING.md's drift rule: a slice whose Ruby source moved must reach one of
  # these, or CI fails while a changed behavior has no recorded disposition.
  TERMINAL_STATUSES = %w[ported not_applicable blocking_cutover].freeze

  REQUIRED_KEYS = %w[id campaign behavior target_package depends_on risk source_paths
                     source_sha ruby_tests oracle_gaps fixtures fixtures_todo
                     observable_outputs platforms perf_budget status evidence
                     intentional_differences notes].freeze

  # Mutation verbs, and the slice that ports each. A slice's oracle test may
  # drive a verb the slice does not own — but only if the owner is *upstream*,
  # because a test needing behavior from a slice three edges downstream cannot
  # pass at the referencing slice's position in the graph.
  #
  # This is the standing form of the 2026-08-01 oracle audit (td-940935). Three
  # of the four worst misattributions it found shared exactly this signature,
  # and every one of them passed a validator that checked only that the named
  # test existed. An audit finds them once; this finds the next one.
  #
  # A verb mapping to nil is unseeded — no slice ports it (td-ee475f). That is a
  # stronger finding than a misplaced edge, not a weaker one, so it counts as
  # unreachable too.
  VERB_OWNERS = {
    "create_task!" => "create-basic",
    "patch_task!" => "changeset-apply-basic",
    "apply_task_changeset!" => "changeset-apply-basic",
    "apply_changeset!" => "changeset-apply-basic",
    "delete_task!" => "delete-task",
    "ensure_id!" => "id-minting",
    "stamp_changed_tasks!" => "update-stamp",
    # Seeded 2026-08-01 by the SLICING pass (td-ee475f, td-8df1bb). These twelve
    # mapped to nil until campaign 4's second half and campaign 7 existed; with
    # them named, `reach` resolves the four pre-existing slices whose recorded
    # reaches into archive_swept! had nowhere to land.
    "create_project!" => "section-create-and-rename",
    "create_section!" => "section-create-and-rename",
    "rename_section!" => "section-create-and-rename",
    "complete_project!" => "project-complete-and-close",
    "archive_swept!" => "archive-sweep",
    "archive_project!" => "archive-project",
    "claim_task!" => "delegation-claim-release",
    "release_task!" => "delegation-claim-release",
    "set_work_ref!" => "delegation-claim-release",
    "delegate_task!" => "delegation-assign",
    "undelegate_task!" => "delegation-assign",
    "decide_proposal!" => "proposal-decisions",
    # Seeded 2026-08-02 with campaigns 5, 6, 9 and 12. Extending this table is
    # part of landing a campaign that owns a store verb, and forgetting it is
    # silent: `reach` only reports a reach it can NAME, so an unmapped verb
    # makes every test that drives it look edge-free. A clean `reach` over a
    # manifest that just grew by 91 slices is therefore not evidence until this
    # table has grown with it.
    "undo!" => "undo-redo-apply",
    "redo!" => "undo-redo-apply",
    "repair!" => "store-repair",
  }.freeze

  Error = Class.new(StandardError)

  # ---------------------------------------------------------------- manifest

  class Manifest
    attr_reader :slices, :campaigns

    def self.load(manifest_path: MANIFEST, campaigns_path: CAMPAIGNS)
      new(read_jsonl(manifest_path), read_jsonl(campaigns_path))
    end

    def self.read_jsonl(path)
      raise Error, "missing #{path}" unless File.exist?(path)
      File.readlines(path, chomp: true).each_with_index.filter_map do |line, i|
        next if line.strip.empty?
        begin
          JSON.parse(line)
        rescue JSON::ParserError => e
          raise Error, "#{path}:#{i + 1}: #{e.message.lines.first.strip}"
        end
      end
    end

    def initialize(slices, campaigns)
      @slices = slices
      @campaigns = campaigns
    end

    def slice(id) = slices.find { |s| s["id"] == id }
    def campaign(number) = campaigns.find { |c| c["campaign"] == number }

    # Every repo file a slice's behavior actually runs: its `source_paths` plus
    # everything those transitively `require_relative`. `source_paths` names the
    # Ruby a slice *ports*, which is the smaller set on purpose — but drift has
    # to watch the larger one, because behavior the slice must reproduce is
    # produced by code it does not name. check.rb calls into recur.rb; drop a day
    # from Recur::DAYS and a fixture the port is proved against changes its
    # `check` outcome while a source_paths-only drift query reports nothing.
    #
    # Only require_relative is followed: `require "json"` is stdlib, and a
    # stdlib version bump is not what the drift rule is for.
    REQUIRE_RELATIVE = /^\s*require_relative\s+["']([^"']+)["']/

    def closure(slice, root: REPO_ROOT)
      seen = []
      queue = Array(slice["source_paths"]).dup
      until queue.empty?
        path = queue.shift
        next if seen.include?(path)
        full = File.join(root, path)
        next unless File.file?(full)
        seen << path
        File.foreach(full) do |line|
          match = REQUIRE_RELATIVE.match(line) or next
          target = File.expand_path(File.join(File.dirname(full), match[1]))
          target = "#{target}.rb" unless target.end_with?(".rb")
          next unless File.file?(target) && target.start_with?("#{root}/")
          queue << target.delete_prefix("#{root}/")
        end
      end
      seen.sort
    end

    # Every slice that must be green before this one can start.
    def ancestors(id, seen = [])
      Array(slice(id)&.fetch("depends_on", nil)).each do |dep|
        next if seen.include?(dep)
        seen << dep
        ancestors(dep, seen)
      end
      seen
    end

    # Oracle refs reaching for behavior the referencing slice cannot have yet: a
    # test driving a mutation verb owned by a slice that is neither this one nor
    # upstream of it.
    #
    # An entry is *explained* when one of the slice's `oracle_gaps` sentences
    # names the test — the same escape hatch the rest of this file uses, and a
    # real answer rather than a loophole: several of these tests are the only
    # oracle their slice has, so "kept, and here is why it cannot pass at this
    # position" is more honest than a deletion that leaves the behavior with no
    # evidence at all.
    def unreachable_oracles(root: REPO_ROOT)
      slices.flat_map do |s|
        reachable = [s["id"]] + ancestors(s["id"])
        explained = Array(s["oracle_gaps"]).join(" ")
        Array(s["ruby_tests"]).filter_map do |ref|
          file, name = ref.split("#", 2)
          next unless name
          body = test_body(File.join(root, file), name)
          next unless body
          reaches = VERB_OWNERS.keys.select do |verb|
            body.include?(verb) && !reachable.include?(VERB_OWNERS[verb])
          end
          next if reaches.empty?
          { "slice" => s["id"], "ref" => ref, "verbs" => reaches,
            "owners" => reaches.map { |v| VERB_OWNERS[v] || "(unseeded)" }.uniq,
            "explained" => explained.include?(name) }
        end
      end
    end

    def test_body(path, name)
      return nil unless File.file?(path)
      source = (@sources ||= {})[path] ||= File.read(path)
      source[/^\s*def #{Regexp.escape(name)}\b.*?^\s{2}end$/m]
    end

    # What `closure` adds beyond what the slice already names.
    def transitive_only(slice, root: REPO_ROOT)
      closure(slice, root: root) - Array(slice["source_paths"])
    end

    # Every way the manifest can be wrong that a machine can see. Returns a list
    # of human-readable problems; empty means the manifest is internally
    # consistent AND every source path and oracle test it names really exists.
    def problems(root: REPO_ROOT)
      out = []
      ids = slices.map { |s| s["id"] }
      dupes = ids.tally.select { |_, n| n > 1 }.keys
      out << "duplicate slice ids: #{dupes.join(", ")}" unless dupes.empty?

      campaign_numbers = campaigns.map { |c| c["campaign"] }
      cdupes = campaign_numbers.tally.select { |_, n| n > 1 }.keys
      out << "duplicate campaign numbers: #{cdupes.join(", ")}" unless cdupes.empty?

      slices.each do |s|
        id = s["id"] || "(no id)"
        missing_keys = REQUIRED_KEYS - s.keys
        out << "#{id}: missing keys #{missing_keys.join(", ")}" unless missing_keys.empty?
        extra = s.keys - REQUIRED_KEYS
        out << "#{id}: unmodelled keys #{extra.join(", ")}" unless extra.empty?

        out << "#{id}: risk #{s["risk"].inspect} not one of #{RISKS.join("/")}" unless RISKS.include?(s["risk"])
        out << "#{id}: status #{s["status"].inspect} not one of #{STATUSES.join("/")}" unless STATUSES.include?(s["status"])
        out << "#{id}: campaign #{s["campaign"].inspect} has no record in campaigns.jsonl" unless campaign_numbers.include?(s["campaign"])
        out << "#{id}: evidence must be porting/evidence/#{id}/" unless s["evidence"] == "porting/evidence/#{id}/"

        unknown = Array(s["depends_on"]) - ids
        out << "#{id}: depends on unknown slice(s) #{unknown.join(", ")}" unless unknown.empty?
        out << "#{id}: depends on itself" if Array(s["depends_on"]).include?(id)

        Array(s["source_paths"]).each do |p|
          out << "#{id}: source path #{p} does not exist" unless File.exist?(File.join(root, p))
        end
        out << "#{id}: source_sha is not a 40-char sha" unless s["source_sha"].to_s.match?(/\A[0-9a-f]{40}\z/)

        # A slice with no oracle test is a finding, not a blank field: it must
        # say so in oracle_gaps rather than leave ruby_tests empty and silent.
        if Array(s["ruby_tests"]).empty? && Array(s["oracle_gaps"]).empty?
          out << "#{id}: no ruby_tests and no oracle_gaps — an unproven slice must record the gap"
        end
        Array(s["ruby_tests"]).each do |ref|
          file, name = ref.split("#", 2)
          full = File.join(root, file)
          unless File.exist?(full)
            out << "#{id}: ruby test file #{file} does not exist"
            next
          end
          # A whole-file claim is unfalsifiable: the file exists, so validation
          # passes, and nobody can tell which of its tests are the oracle and
          # which happen to live nearby. test/test_config.rb has 70 tests; a
          # slice that claims the file claims all of them, including the ones
          # proving something else entirely. Naming each test is what makes the
          # claim checkable — and what makes a test that stops proving the
          # slice's behavior fail loudly instead of hiding behind a file path.
          if name.nil? || name.strip.empty?
            out << "#{id}: ruby test #{file} is a whole-file claim — name the tests " \
                   "(#{file}#test_...) that are this slice's oracle"
            next
          end
          out << "#{id}: #{file} has no #{name}" unless File.read(full).include?("def #{name}")
        end
        repeats = Array(s["ruby_tests"]).tally.select { |_, n| n > 1 }.keys
        out << "#{id}: ruby_tests repeats #{repeats.join(", ")}" unless repeats.empty?

        Array(s["fixtures"]).each do |f|
          out << "#{id}: fixture #{f} does not exist" unless File.exist?(File.join(root, f))
        end
        # Three honest shapes, and one dishonest one. Fixtures wired, or a
        # fixtures_todo naming what the corpus still lacks, or — for a slice
        # that genuinely operates on no store at all — neither, provided
        # `notes` says so in as many words. A silent double blank is the
        # dishonest shape: it reads as "wired" and proves nothing.
        if Array(s["fixtures"]).empty? && to_s_or_nil(s["fixtures_todo"]).nil? &&
           !s["notes"].to_s.match?(/fixture/i)
          out << "#{id}: no fixtures and no fixtures_todo — wire the corpus, say what is " \
                 "missing, or say in notes why this slice needs no fixture"
        end
      end

      out.concat(cycles)
      out
    end

    # Dependency cycles, reported as one line per cycle found.
    def cycles
      graph = slices.to_h { |s| [s["id"], Array(s["depends_on"])] }
      state = Hash.new(:new)
      found = []
      walk = lambda do |node, path|
        state[node] = :open
        graph.fetch(node, []).each do |dep|
          next unless graph.key?(dep)
          if state[dep] == :open
            found << "dependency cycle: #{(path + [dep]).join(" -> ")}"
          elsif state[dep] == :new
            walk.call(dep, path + [dep])
          end
        end
        state[node] = :done
      end
      graph.each_key { |n| walk.call(n, [n]) if state[n] == :new }
      found.uniq
    end

    def to_s_or_nil(v) = (v.nil? || v.to_s.strip.empty?) ? nil : v.to_s
  end

  # ---------------------------------------------------------------- td client

  # Every td invocation this script makes, in one place. `td` is resolved from
  # TD_BIN so a test can stand a recording double in front of it.
  class Td
    def initialize(bin: ENV["TD_BIN"] || "td", work_dir: REPO_ROOT)
      @bin = bin
      @work_dir = work_dir
    end

    def fleet_issues
      run_json("list", "--labels", FLEET_LABEL, "--all", "--format", "json", "--limit", "500") || []
    end

    def show(id) = run_json("show", id, "--json")

    # Whether td still has this issue. A soft read: `show` on a deleted id exits
    # non-zero, which `run` turns into an exception, and "the issue is gone" is
    # an answer rather than a failure here.
    def exists?(id)
      _out, _err, status = Open3.capture3(@bin, "--work-dir", @work_dir, "show", id, "--json")
      status.success?
    end

    def dependencies(id)
      Array(run_json("dep", id, "--json")&.fetch("dependencies", nil))
    end

    # Returns the new issue id. Long text goes through files: --description-file
    # and --acceptance-file both preserve formatting, and only one of them can
    # read stdin, so neither does.
    def create(type:, title:, labels:, priority:, points:, parent:, description:, acceptance:)
      with_text_files(description, acceptance) do |dfile, afile|
        args = ["create", "--title", title, "--type", type,
                "--labels", labels.join(","), "--priority", priority,
                "--points", points.to_s,
                "--description-file", dfile, "--acceptance-file", afile, "--json"]
        args += ["--parent", parent] if parent
        result = run_json(*args)
        result&.fetch("id", nil) or raise Error, "td create returned no id for #{title.inspect}"
      end
    end

    def update(id, fields)
      with_text_files(fields[:description], fields[:acceptance]) do |dfile, afile|
        args = ["update", id]
        args += ["--title", fields[:title]] if fields.key?(:title)
        args += ["--priority", fields[:priority]] if fields.key?(:priority)
        args += ["--points", fields[:points].to_s] if fields.key?(:points)
        args += ["--labels", fields[:labels].join(",")] if fields.key?(:labels)
        args += ["--parent", fields[:parent]] if fields.key?(:parent)
        args += ["--description-file", dfile] if fields.key?(:description)
        args += ["--acceptance-file", afile] if fields.key?(:acceptance)
        run(*args, "--json")
      end
    end

    def dep_add(id, dep) = run("dep", "add", id, dep)
    def dep_rm(id, dep) = run("dep", "rm", id, dep)

    private

    def with_text_files(description, acceptance)
      Dir.mktmpdir("manifest-issues") do |dir|
        d = File.join(dir, "description.md")
        a = File.join(dir, "acceptance.md")
        File.write(d, description.to_s)
        File.write(a, acceptance.to_s)
        yield d, a
      end
    end

    def run(*args)
      stdout, stderr, status = Open3.capture3(@bin, "--work-dir", @work_dir, *args)
      raise Error, "td #{args.first} failed: #{stderr.strip.empty? ? stdout.strip : stderr.strip}" unless status.success?
      stdout
    end

    def run_json(*args)
      out = run(*args)
      return nil if out.strip.empty?
      JSON.parse(out)
    rescue JSON::ParserError
      # td prints a human line ("No issues matching query") when a read finds
      # nothing; that is an empty result, not a failure.
      nil
    end
  end

  # ---------------------------------------------------------------- desired state

  # The td shape a manifest record should produce. Pure: same manifest in, same
  # issue fields out, which is what makes the second run a no-op.
  module Desired
    module_function

    TITLE_LIMIT = 200

    def campaign_issue(campaign)
      {
        type: "epic",
        title: truncate("Go port campaign #{campaign["campaign"]}: #{campaign["title"]}"),
        labels: [FLEET_LABEL, CAMPAIGN_LABEL, "campaign:#{campaign["campaign"]}"],
        priority: "P2",
        points: 0,
        parent: nil,
        description: campaign_description(campaign),
        acceptance: "Every slice issue under this epic is closed with its evidence bundle " \
                    "recorded under porting/evidence/, and every manifest record for campaign " \
                    "#{campaign["campaign"]} reads ported, not applicable, or blocking cutover.",
      }
    end

    def slice_issue(slice, epic_id)
      {
        type: "task",
        title: truncate("port #{slice["id"]}: #{slice["behavior"]}"),
        labels: [FLEET_LABEL, SLICE_LABEL, "slice:#{slice["id"]}",
                 "risk:#{slice["risk"]}", "campaign:#{slice["campaign"]}"],
        priority: "P2",
        points: RISK_POINTS.fetch(slice["risk"]),
        parent: epic_id,
        description: slice_description(slice),
        acceptance: slice_acceptance(slice),
      }
    end

    # The missing corpus for one slice, as its own issue. It exists only while
    # the slice's `fixtures_todo` is non-null; the slice depends on it, so the
    # fleet is offered the fixture work instead of a slice it cannot prove.
    def gate_issue(slice, epic_id)
      {
        type: "task",
        title: truncate("fixtures for #{slice["id"]}: the corpus this slice still lacks"),
        labels: [FLEET_LABEL, GATE_LABEL, "fixture-gate:#{slice["id"]}",
                 "campaign:#{slice["campaign"]}"],
        priority: "P2",
        points: 1,
        parent: epic_id,
        description: gate_description(slice),
        acceptance: <<~TEXT.strip,
          The named fixtures exist under porting/fixtures/ with a README recording the Ruby
          outcome, porting/manifest.jsonl lists them in #{slice["id"]}'s `fixtures`, that
          slice's `fixtures_todo` is null, and `porting/manifest-issues sync` has been re-run
          so the dependency edge from #{slice["id"]} to this issue is gone.
        TEXT
      }
    end

    def gate_description(slice)
      <<~TEXT.strip
        Blocks slice #{slice["id"]} (#{slice["behavior"]}).

        Missing corpus:
        #{bullets([slice["fixtures_todo"]])}

        Already wired for this slice:
        #{bullets(slice["fixtures"], empty: "nothing yet")}

        manifest.md: a slice may not pass `characterizing` while `fixtures_todo` is non-null.
        Until this issue is done, #{slice["id"]} is not startable, which is why it carries a
        dependency edge on this one rather than sitting in `td ready`.

        #{generated_footer}
      TEXT
    end

    def truncate(text)
      one_line = text.gsub(/\s+/, " ").strip
      return one_line if one_line.length <= TITLE_LIMIT
      cut = one_line[0, TITLE_LIMIT - 1]
      cut = cut[0, cut.rindex(" ") || cut.length].rstrip
      "#{cut}…"
    end

    def campaign_description(campaign)
      <<~TEXT.strip
        #{campaign["summary"]}

        Maps onto #{campaign["plan_phase"]} of docs/plans/active/tasks-go-port-plan.md.

        #{generated_footer}
      TEXT
    end

    def slice_description(slice)
      sha = slice["source_sha"].to_s[0, 12]
      <<~TEXT.strip
        #{slice["behavior"]}

        Campaign #{slice["campaign"]} | risk #{slice["risk"]} | target package #{slice["target_package"]}

        Ruby source (as of #{sha}):
        #{bullets(slice["source_paths"])}

        Ruby oracle tests:
        #{bullets(slice["ruby_tests"], empty: "none — see oracle gaps")}

        Oracle gaps and exclusions:
        #{bullets(slice["oracle_gaps"], empty: "none recorded")}

        Fixtures:
        #{bullets(slice["fixtures"], empty: (slice["fixtures_todo"] || "none recorded"))}

        Observable outputs:
        #{bullets(slice["observable_outputs"])}

        Platforms: #{Array(slice["platforms"]).join(", ")}
        Performance budget: #{slice["perf_budget"] || "none set"}
        Evidence: #{slice["evidence"]}
        Manifest status: #{slice["status"]}
        #{slice["notes"] ? "\nNotes: #{slice["notes"]}" : ""}
        #{generated_footer}
      TEXT
    end

    def slice_acceptance(slice)
      <<~TEXT.strip
        Risk tier #{slice["risk"]}: #{RISK_ACCEPTANCE.fetch(slice["risk"])}

        #{ALWAYS}

        Evidence bundle lands under #{slice["evidence"]} and the manifest record for
        #{slice["id"]} is updated in the same change.
      TEXT
    end

    def bullets(items, empty: "none")
      list = Array(items)
      return "  - #{empty}" if list.empty?
      list.map { |i| "  - #{i}" }.join("\n")
    end

    def generated_footer
      "Generated from porting/manifest.jsonl by porting/manifest-issues. " \
        "Change the manifest, not this issue: the next sync overwrites edits made here."
    end
  end

  # ---------------------------------------------------------------- planner

  Action = Struct.new(:kind, :target, :td_id, :detail, keyword_init: true) do
    def to_h = { "action" => kind, "target" => target, "td_id" => td_id, "detail" => detail }
    def to_line
      "#{kind.to_s.upcase.ljust(6)} #{(td_id || "-").ljust(9)} #{target}#{detail.empty? ? "" : "  (#{detail})"}"
    end
  end

  # Reads td once for the fleet, then decides per record whether anything needs
  # writing. `apply: false` is the dry run — it takes the same reads and the
  # same decisions, so what it prints is what a real run would do.
  class Planner
    def initialize(manifest, td)
      @manifest = manifest
      @td = td
      @actions = []
    end

    attr_reader :actions

    def run(apply:)
      fleet = @td.fleet_issues
      epics, slices, gates = index(fleet)
      epic_ids = sync_campaigns(epics, apply: apply)
      slice_ids = sync_slices(slices, epic_ids, apply: apply)
      gate_ids = sync_gates(gates, epic_ids, apply: apply)
      # Every issue this script has ever been responsible for, not only the ones
      # the manifest still wants. An edge is ours to remove if it points at a
      # porting issue — including a retired slice's issue and a gate whose gap
      # has closed. Without that, a slice rename leaves its dependents wired to
      # both the old issue and the new one, and in a fleet whose ready-work
      # query is a dependency query, "depends on a retired issue nobody will
      # ever close" means permanently unstartable.
      fleet_ids = fleet.map { |i| i["id"] }.compact
      sync_dependencies(slice_ids, gate_ids, fleet_ids, apply: apply)
      report_orphans(epics, slices, gates)
      @actions
    end

    private

    # Two indexes, not one, from a single list call. A slice issue carries
    # `campaign:N` as *membership* while the epic carries it as *identity*, so a
    # flat label map would let a slice masquerade as its own epic. The marker
    # label (porting-slice / porting-campaign) is what separates them.
    def index(issues)
      epics = {}
      slices = {}
      gates = {}
      collisions = []
      issues.each do |issue|
        labels = Array(issue["labels"])
        index, key = if labels.include?(CAMPAIGN_LABEL)
                       [epics, labels.find { |l| l.start_with?("campaign:") }]
                     elsif labels.include?(SLICE_LABEL)
                       [slices, labels.find { |l| l.start_with?("slice:") }]
                     elsif labels.include?(GATE_LABEL)
                       [gates, labels.find { |l| l.start_with?("fixture-gate:") }]
                     end
        next unless key
        # Identity is a label, so two issues carrying one identity label is not
        # a thing to resolve quietly. Last-one-wins would repoint every
        # dependency edge at the newcomer and silently orphan the issue an agent
        # may already have claimed — and then converge, reporting "nothing to
        # do" forever over a permanently wrong graph. Two concurrent syncs are
        # enough to produce it. Refuse instead.
        collisions << [key, index[key]["id"], issue["id"]] if index.key?(key)
        index[key] = issue
      end

      unless collisions.empty?
        detail = collisions.map { |key, first, second| "#{key} on #{first} and #{second}" }
        raise Error, "duplicate identity label(s) in td — refusing to sync, because a " \
                     "dependency edge would be repointed at one of them and the other " \
                     "silently orphaned:\n  #{detail.join("\n  ")}\n" \
                     "Fix by removing the label from whichever issue is not the real one " \
                     "(td update <id> --labels ...); nothing here is safe to guess."
      end
      [epics, slices, gates]
    end

    def sync_campaigns(epics, apply:)
      @manifest.campaigns.sort_by { |c| c["campaign"] }.to_h do |campaign|
        key = "campaign:#{campaign["campaign"]}"
        desired = Desired.campaign_issue(campaign)
        id = reconcile(key, desired, epics[key], "campaign #{campaign["campaign"]}", apply: apply)
        [campaign["campaign"], id]
      end
    end

    def sync_slices(slices, epic_ids, apply:)
      @manifest.slices.to_h do |slice|
        key = "slice:#{slice["id"]}"
        desired = Desired.slice_issue(slice, epic_ids[slice["campaign"]])
        id = reconcile(key, desired, slices[key], "slice #{slice["id"]}", apply: apply)
        [slice["id"], id]
      end
    end

    # One gate per slice that still names a missing corpus. Slices whose
    # `fixtures_todo` is null get none — and any gate issue left over from a gap
    # that has since closed falls out here and is reported as an orphan.
    def sync_gates(gates, epic_ids, apply:)
      @manifest.slices.select { |s| gated?(s) }.to_h do |slice|
        key = "fixture-gate:#{slice["id"]}"
        desired = Desired.gate_issue(slice, epic_ids[slice["campaign"]])
        id = reconcile(key, desired, gates[key], "fixture gap #{slice["id"]}", apply: apply)
        [slice["id"], id]
      end
    end

    def gated?(slice) = !slice["fixtures_todo"].to_s.strip.empty?

    # Create if absent; otherwise fetch the full issue and update only the fields
    # that actually differ. Returns the td id, or nil in a dry run of a create
    # (nothing downstream may assume an id it did not get).
    def reconcile(key, desired, summary, label, apply:)
      unless summary
        if apply
          id = @td.create(**desired)
          @actions << Action.new(kind: :create, target: label, td_id: id, detail: key)
          return id
        end
        @actions << Action.new(kind: :create, target: label, td_id: nil, detail: key)
        return nil
      end

      id = summary["id"]
      actual = @td.show(id) || {}
      changes = {}
      changes[:title] = desired[:title] if desired[:title] != actual["title"]
      changes[:priority] = desired[:priority] if desired[:priority] != actual["priority"]
      changes[:points] = desired[:points] if desired[:points] != actual["points"]
      changes[:parent] = desired[:parent] if desired[:parent] && desired[:parent] != actual["parent_id"]
      changes[:description] = desired[:description] if normalize(desired[:description]) != normalize(actual["description"])
      changes[:acceptance] = desired[:acceptance] if normalize(desired[:acceptance]) != normalize(actual["acceptance"])
      # Labels the manifest does not own (a human's "flaky", say) are kept.
      wanted_labels = (Array(actual["labels"]) - owned(Array(actual["labels"])) + desired[:labels]).uniq.sort
      changes[:labels] = wanted_labels if wanted_labels != Array(actual["labels"]).uniq.sort

      if changes.empty?
        @actions << Action.new(kind: :skip, target: label, td_id: id, detail: "up to date")
      else
        @td.update(id, changes) if apply
        @actions << Action.new(kind: :update, target: label, td_id: id, detail: changes.keys.join(", "))
      end
      id
    end

    def owned(labels)
      labels.select do |l|
        l == FLEET_LABEL || l == SLICE_LABEL || l == CAMPAIGN_LABEL || l == GATE_LABEL ||
          l.start_with?("slice:", "risk:", "campaign:", "fixture-gate:")
      end
    end

    def normalize(text) = text.to_s.gsub(/\r\n?/, "\n").strip

    def sync_dependencies(slice_ids, gate_ids, fleet_ids, apply:)
      plan = []
      @manifest.slices.each do |slice|
        id = slice_ids[slice["id"]]
        wanted = (Array(slice["depends_on"]).filter_map { |d| slice_ids[d] } +
                  [gate_ids[slice["id"]]].compact).uniq.sort
        unless id
          # Dry run before the issue exists: every edge is a future add.
          wanted_names = Array(slice["depends_on"])
          wanted_names += ["fixture-gate:#{slice["id"]}"] if gated?(slice)
          unless wanted_names.empty?
            @actions << Action.new(kind: :dep, target: "slice #{slice["id"]}", td_id: nil,
                                   detail: "+#{wanted_names.join(" +")}")
          end
          next
        end
        current = @td.dependencies(id).uniq.sort
        add = wanted - current
        # Ours to remove: any edge to an issue this script owns (fleet-labelled,
        # so retired slices and closed gaps included), plus any edge to an id td
        # no longer resolves at all — a deleted issue can never be satisfied, so
        # leaving the edge would strand every dependent. A human-added edge to a
        # live issue outside the fleet stays.
        ours = (slice_ids.values.compact + gate_ids.values.compact + fleet_ids).uniq
        dangling = (current - ours - wanted).reject { |d| @td.exists?(d) }
        remove = ((current & ours) - wanted) + dangling
        # A dry run has no id for a gate it would create, so the gating edge is
        # named rather than numbered. Without this the plan would under-report
        # what the real run does, which is the one thing a dry run may not do.
        pending = gated?(slice) && gate_ids[slice["id"]].nil? ? ["+fixture-gate:#{slice["id"]}"] : []
        next if add.empty? && remove.empty? && pending.empty?
        plan << [slice["id"], id, add, remove, pending]
      end

      # Every removal first, across the whole graph, and only then the
      # additions. td refuses an edge that would close a cycle, and a
      # reordering — B no longer depends on A, A now depends on B — presents
      # exactly that transient if the add is attempted while the old edge is
      # still there. Per-slice ordering made the reorder of update-stamp cost a
      # second sync run to converge, which is the idempotency property failing
      # quietly: the first run reported success having silently not written one
      # edge.
      if apply
        plan.each { |_name, id, _add, remove, _pending| remove.each { |d| @td.dep_rm(id, d) } }
        plan.each { |_name, id, add, _remove, _pending| add.each { |d| @td.dep_add(id, d) } }
      end
      plan.each do |name, id, add, remove, pending|
        detail = (add.map { |d| "+#{d}" } + remove.map { |d| "-#{d}" } + pending).join(" ")
        @actions << Action.new(kind: :dep, target: "slice #{name}", td_id: id, detail: detail)
      end
    end

    # A td issue labelled for a slice the manifest no longer has. Reported, never
    # deleted: removing a slice from the manifest is a decision, and the issue
    # may carry the evidence of why.
    #
    # An orphan whose issue is already CLOSED is not reported. The report is an
    # instruction ("close this issue") and `fleet_issues` passes `--all`, so
    # without this the instruction never converges: acting on it changes nothing
    # the next run can see, and `plan` can never be clean again once any gap has
    # ever closed. Closed is the human having acted, which is the whole ask.
    # Note this is not a filter on `fleet_issues` — reconcile still needs to find
    # a closed issue by its identity label if the manifest ever wants it back,
    # and `sync_dependencies` still needs its id to strip stale edges.
    def report_orphans(epics, slices, gates)
      known_epics = @manifest.campaigns.map { |c| "campaign:#{c["campaign"]}" }
      known_slices = @manifest.slices.map { |s| "slice:#{s["id"]}" }
      [[epics, known_epics], [slices, known_slices]].each do |index, known|
        (index.keys - known).sort.each do |key|
          next if closed?(index[key])

          @actions << Action.new(kind: :orphan, target: key, td_id: index[key]["id"],
                                 detail: "labelled for a record the manifest no longer has")
        end
      end

      # A gate for a gap that has closed. Its edge is already gone; the issue is
      # left for a human to close, because it holds the record of what was built.
      wanted_gates = @manifest.slices.select { |s| gated?(s) }.map { |s| "fixture-gate:#{s["id"]}" }
      (gates.keys - wanted_gates).sort.each do |key|
        next if closed?(gates[key])

        @actions << Action.new(kind: :orphan, target: key, td_id: gates[key]["id"],
                               detail: "fixtures_todo is null now — the gap closed, close this issue")
      end
    end

    def closed?(issue) = issue["status"].to_s == "closed"
  end

  # ---------------------------------------------------------------- cli

  class CLI
    def self.run(argv)
      new.run(argv)
    end

    def run(argv)
      options = { json: false, dry_run: false }
      parser = OptionParser.new do |o|
        o.banner = "usage: porting/manifest-issues <plan|sync|progress|validate|drift|closure|reach> [--json] [--dry-run]"
        o.on("--json", "machine-readable output") { options[:json] = true }
        o.on("--dry-run", "with sync: plan only, write nothing") { options[:dry_run] = true }
        o.on("-h", "--help") { puts o; exit 0 }
      end
      rest = parser.parse(argv)
      command = rest.shift || "plan"
      unless rest.empty?
        warn "unexpected argument: #{rest.first}"
        warn parser.banner
        return 2
      end

      manifest = Manifest.load
      case command
      when "plan"     then sync(manifest, options, apply: false)
      when "sync"     then sync(manifest, options, apply: !options[:dry_run])
      when "progress" then progress(manifest, options)
      when "validate" then validate(manifest, options)
      when "drift"    then drift(manifest, options)
      when "closure"  then closure(manifest, options)
      when "reach"    then reach(manifest, options)
      else
        warn "unknown command: #{command}"
        warn parser.banner
        2
      end
    rescue Error => e
      if options[:json]
        puts JSON.pretty_generate({ "ok" => false, "error" => e.message })
      else
        warn "error: #{e.message}"
      end
      1
    end

    private

    def sync(manifest, options, apply:)
      problems = manifest.problems
      unless problems.empty?
        raise Error, "manifest is not valid, refusing to sync:\n  #{problems.join("\n  ")}"
      end

      actions = Planner.new(manifest, Td.new).run(apply: apply)
      summary = actions.map(&:kind).tally.transform_keys(&:to_s)
      summary["total"] = actions.size
      mode = apply ? "sync" : "dry-run"

      if options[:json]
        puts JSON.pretty_generate({ "ok" => true, "mode" => mode,
                                    "actions" => actions.map(&:to_h), "summary" => summary })
      else
        gaps = manifest.slices.count { |s| !s["fixtures_todo"].to_s.strip.empty? }
        puts "#{mode}: #{manifest.slices.size} slices, #{manifest.campaigns.size} campaigns, " \
             "#{gaps} fixture gap#{"s" unless gaps == 1}"
        actions.each { |a| puts a.to_line }
        puts
        puts summary.map { |k, v| "#{k}=#{v}" }.join("  ")
        puts "nothing to do — td already matches the manifest" if (summary.keys - %w[skip total]).empty?
      end
      0
    end

    # The only progress number that exists. Counting is done here, from the
    # manifest, so no percentage is ever written down anywhere.
    def progress(manifest, options)
      counts = manifest.slices.map { |s| s["status"] }.tally
      by_campaign = manifest.slices.group_by { |s| s["campaign"] }.transform_values do |slices|
        { "total" => slices.size,
          "done" => slices.count { |s| TERMINAL_STATUSES.include?(s["status"]) },
          "by_status" => slices.map { |s| s["status"] }.tally }
      end
      total = manifest.slices.size
      done = manifest.slices.count { |s| TERMINAL_STATUSES.include?(s["status"]) }

      if options[:json]
        puts JSON.pretty_generate({ "ok" => true, "total" => total, "done" => done,
                                    "by_status" => counts, "by_campaign" => by_campaign })
      else
        puts "slices: #{done}/#{total} at a terminal status"
        STATUSES.each { |s| puts "  #{s.ljust(18)} #{counts.fetch(s, 0)}" if counts.key?(s) }
        puts
        by_campaign.keys.sort.each do |number|
          c = by_campaign[number]
          name = manifest.campaign(number)&.fetch("title", nil) || "(no campaign record)"
          puts "campaign #{number}: #{c["done"]}/#{c["total"]}  #{name}"
        end
      end
      0
    end

    def validate(manifest, options)
      problems = manifest.problems
      if options[:json]
        puts JSON.pretty_generate({ "ok" => problems.empty?, "problems" => problems,
                                    "slices" => manifest.slices.size })
      elsif problems.empty?
        puts "ok: #{manifest.slices.size} slices, #{manifest.campaigns.size} campaigns, " \
             "every source path and oracle test resolves"
      else
        problems.each { |p| puts p }
      end
      problems.empty? ? 0 : 1
    end

    # What drift actually watches per slice, and the last commit that touched
    # it — which is the sha a not-yet-characterized slice should be pinned to.
    # Printed rather than stored: a derived set that rots in the manifest is
    # worse than one computed on demand.
    def closure(manifest, options)
      rows = manifest.slices.map do |slice|
        watched = manifest.closure(slice)
        last, _err, _status = Open3.capture3(
          "git", "-C", REPO_ROOT, "log", "-1", "--format=%H", "--", *watched
        )
        { "id" => slice["id"], "source_paths" => Array(slice["source_paths"]),
          "transitive" => manifest.transitive_only(slice), "watched" => watched,
          "source_sha" => slice["source_sha"], "last_touch" => last.strip }
      end

      if options[:json]
        puts JSON.pretty_generate({ "ok" => true, "slices" => rows })
      else
        rows.each do |row|
          mark = row["source_sha"] == row["last_touch"] ? " " : "!"
          puts "#{mark} #{row["id"]}  #{row["watched"].size} file(s) watched " \
               "(#{row["source_paths"].size} ported + #{row["transitive"].size} transitive)"
          row["transitive"].each { |p| puts "      + #{p}" }
        end
        stale = rows.count { |r| r["source_sha"] != r["last_touch"] }
        puts
        puts "#{stale} slice(s) pinned to something other than their closure's last-touch commit"
      end
      0
    end

    # Oracle refs that cannot pass where they are claimed. Exits non-zero on any
    # that no `oracle_gaps` sentence accounts for.
    def reach(manifest, options)
      found = manifest.unreachable_oracles
      unexplained = found.reject { |r| r["explained"] }

      if options[:json]
        puts JSON.pretty_generate({ "ok" => unexplained.empty?, "reaches" => found })
      elsif found.empty?
        puts "no unreachable oracles: every claimed test's mutation verbs are owned by the " \
             "slice or by one upstream of it"
      else
        found.group_by { |r| r["slice"] }.each do |id, rows|
          puts id
          rows.each do |row|
            mark = row["explained"] ? "explained " : "UNEXPLAINED"
            puts "  #{mark} #{row["ref"].split("#").last}"
            puts "              drives #{row["verbs"].join(", ")} — owned by " \
                 "#{row["owners"].join(", ")}, not upstream of #{id}"
          end
        end
        puts
        puts "#{found.size} reach(es), #{unexplained.size} unexplained"
      end
      unexplained.empty? ? 0 : 1
    end

    # PORTING.md's drift rule, made executable: a slice whose source moved past
    # its source_sha must be at a terminal status, or it is an open question.
    def drift(manifest, options)
      drifted = manifest.slices.filter_map do |slice|
        # The transitive closure, not just source_paths: a slice is drifted when
        # any code that produces its behavior moved, including code it calls
        # rather than ports.
        watched = manifest.closure(slice)
        commits, _err, status = Open3.capture3(
          "git", "-C", REPO_ROOT, "log", "--format=%H", "#{slice["source_sha"]}..HEAD",
          "--", *watched
        )
        next unless status.success?
        shas = commits.split("\n")
        next if shas.empty?
        { "id" => slice["id"], "source_sha" => slice["source_sha"], "status" => slice["status"],
          "watched" => watched, "commits_since" => shas,
          "resolved" => TERMINAL_STATUSES.include?(slice["status"]) }
      end
      unresolved = drifted.reject { |d| d["resolved"] }

      if options[:json]
        puts JSON.pretty_generate({ "ok" => unresolved.empty?, "drifted" => drifted })
      elsif drifted.empty?
        puts "no drift: every slice's Ruby source is unchanged since its source_sha"
      else
        drifted.each do |d|
          mark = d["resolved"] ? "resolved" : "UNRESOLVED"
          puts "#{mark.ljust(10)} #{d["id"]}  #{d["commits_since"].size} commit(s) since " \
               "#{d["source_sha"][0, 12]}  (status: #{d["status"]})"
        end
      end
      unresolved.empty? ? 0 : 1
    end
  end
end

exit ManifestIssues::CLI.run(ARGV) if __FILE__ == $PROGRAM_NAME
