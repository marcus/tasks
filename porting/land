#!/usr/bin/env bash
#
# land — merge one approved porting slice into main, or refuse cleanly.
#
#   porting/land <slice-id>
#
# This is the fleet's missing landing step: PORTING.md's iteration ends with
# `td review` / `td approve`, and until this script existed nothing ever
# turned that approval into main advancing. It is deliberately a script, not
# prose in PORTING.md, for the reasons PORTING.md states about itself: it is
# paid for on every tick, so the tick-level prompt should call this in one
# line and this file should carry the logic — deterministic, testable
# identically under both harnesses.
#
# What it does, in order:
#   1. Refuse unless already landed (idempotent no-op) is ruled out.
#   2. Verify the slice's td issue is actually approved and closed — the real
#      representation, not an invented one: `status == "closed"` AND a
#      non-superseded review_history entry with `decision == "approved"`.
#   3. Verify `port/<slice>` exists.
#   4. Cheap merge-tree dry run (no mutation) against the current main tip.
#   5. Take a real lock (mkdir-based; flock is not on macOS by default and was
#      confirmed absent here), so two concurrent invocations from the two
#      harnesses serialize instead of racing main.
#   6. Under the lock, re-verify the merge-tree check (main may have moved
#      between steps 4 and 5), then actually merge (--no-ff), mark the
#      manifest entry `ported`, and run the repo's test suite.
#   7. On any failure past this point: `git reset --hard` main back to
#      exactly where it was, log why on the td issue, exit non-zero. On
#      success: delete `port/<slice>`, log the landing, exit 0.
#
# Never uses --force, --ours/--theirs, or a force-push. Never touches a repo
# other than the one worktree that actually has DEFAULT_BRANCH checked out —
# found by inspecting `git worktree list`, not assumed from $0's location,
# because $0 may be a copy of this file sitting in a detached-HEAD slot
# worktree whose own toplevel is NOT the repo's main checkout.
#
# Env overrides:
#   TASKS_REPO        repo root, if you want to skip worktree discovery
#   DEFAULT_BRANCH    branch slices land on (default: main)
#   LAND_TEST_CMD     the repo test suite (default: ruby test/all.rb)
#   LAND_TEST_TIMEOUT seconds before the test run is killed (default: 1800)
#   LAND_LOCK_TIMEOUT seconds to wait for the landing lock (default: 600)
#   LAND_LOCK_STALE   seconds after which an unattended lock is reclaimed
#                     (default: 900) — reclaimed immediately regardless if its
#                     pid is no longer alive
#
# Exit codes: 0 success (including "already landed"), 1 a named precondition
# or step failed and main is untouched, 2 usage error.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DEFAULT_BRANCH="${DEFAULT_BRANCH:-main}"
LAND_TEST_CMD="${LAND_TEST_CMD:-ruby test/all.rb}"
LAND_TEST_TIMEOUT="${LAND_TEST_TIMEOUT:-1800}"
LAND_LOCK_TIMEOUT="${LAND_LOCK_TIMEOUT:-600}"
LAND_LOCK_STALE="${LAND_LOCK_STALE:-900}"
LOCK_POLL=2

log()  { printf '%s land: %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >&2; }
die()  { log "REFUSED: $*"; exit 1; }
usage() { echo "usage: porting/land <slice-id>" >&2; exit 2; }

[ $# -eq 1 ] || usage
SLICE="$1"
case "$SLICE" in
  ''|*[!A-Za-z0-9_-]*) usage ;;
esac

# ---------------------------------------------------------------- repo root
# Refs (branches, objects) are shared across every worktree of this repo, but
# a branch can only be checked out non-detached in exactly one of them. Slot
# worktrees run detached on purpose (PORTING.md step 5), so the one worktree
# with $DEFAULT_BRANCH actually checked out is authoritative here regardless
# of which worktree's copy of this script is running.
find_main_worktree() {
  git worktree list --porcelain 2>/dev/null | awk -v want="refs/heads/$1" '
    /^worktree / { wt = substr($0, 10) }
    /^branch /   { if (substr($0, 8) == want) print wt }
  '
}

if [ -n "${TASKS_REPO:-}" ]; then
  REPO_ROOT="$TASKS_REPO"
else
  REPO_ROOT="$(find_main_worktree "$DEFAULT_BRANCH" | head -1)"
  if [ -z "$REPO_ROOT" ]; then
    # Fall back to this script's own toplevel — the common case in a single-
    # worktree repo (e.g. every test fixture for this script).
    REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null)"
  fi
fi
[ -n "$REPO_ROOT" ] && [ -d "$REPO_ROOT/.git" -o -f "$REPO_ROOT/.git" ] \
  || die "cannot find a worktree with '$DEFAULT_BRANCH' checked out (set TASKS_REPO)"

g() { git -C "$REPO_ROOT" "$@"; }

command -v jq >/dev/null || die "jq not on PATH"
command -v td >/dev/null || die "td not on PATH"
MANIFEST="$REPO_ROOT/porting/manifest.jsonl"
[ -f "$MANIFEST" ] || die "no manifest at $MANIFEST"

# PORTING.md's iteration steps and `td` itself hand an agent the td issue id
# (e.g. td-2f853a), not the manifest slice id this script was originally
# keyed on (e.g. format-parse) — invoking with the td id is the mistake an
# agent following those docs will actually make. Accept both: a td id is
# resolved to its slice via the same slice:<name> label step 2 below relies
# on, so an id that lacks that label fails there with the same message step 2
# would already give, not a confusing new one.
case "$SLICE" in
  td-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f])
    RESOLVED_ISSUE="$(cd "$REPO_ROOT" && td show "$SLICE" --json 2>/dev/null)"
    [ -n "$RESOLVED_ISSUE" ] || die "no td issue $SLICE"
    RESOLVED_SLICE="$(printf '%s' "$RESOLVED_ISSUE" | jq -r '
      [(.labels // [])[] | select(startswith("slice:"))][0] // empty' | sed 's/^slice://')"
    [ -n "$RESOLVED_SLICE" ] || die "td issue $SLICE has no slice:<name> label"
    log "resolved td id $SLICE to slice '$RESOLVED_SLICE'"
    SLICE="$RESOLVED_SLICE"
    ;;
esac
BRANCH="port/$SLICE"
# Inside .git, not the working tree: a lock directory living under
# porting/ would show up as an untracked file in `git status --porcelain`,
# tripping this very script's own clean-checkout check.
GIT_DIR="$(g rev-parse --absolute-git-dir 2>/dev/null)" || die "cannot resolve .git dir for $REPO_ROOT"
LOCK_DIR="$GIT_DIR/porting-land.lock"

TIMEOUT_BIN="$(command -v gtimeout || command -v timeout || true)"

# ---------------------------------------------------------------- helpers
manifest_status() { # manifest_status <id>
  jq -rc --arg id "$1" 'select(.id == $id) | .status' "$MANIFEST" 2>/dev/null | head -1
}

manifest_set_status() { # manifest_set_status <id> <status>
  local id="$1" status="$2" tmp
  tmp="$MANIFEST.$$.tmp"
  : >"$tmp"
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || { printf '\n' >>"$tmp"; continue; }
    if [ "$(printf '%s' "$line" | jq -r '.id // empty' 2>/dev/null)" = "$id" ]; then
      printf '%s' "$line" | jq -c --arg s "$status" '.status = $s' >>"$tmp" || { rm -f "$tmp"; return 1; }
    else
      printf '%s\n' "$line" >>"$tmp"
    fi
  done <"$MANIFEST"
  mv "$tmp" "$MANIFEST"
}

# Records what happened where the next tick (either harness) can find it,
# same idiom PORTING.md already uses for progress. Never fatal: a note that
# fails to write must not mask the real failure.
record() { # record <issue-id> <message>
  td log "$1" "$2" >/dev/null 2>&1 \
    || log "WARNING: could not td log $1 (message: $2)"
}

# ---------------------------------------------------------------- lock
LOCK_HELD=0
acquire_lock() {
  local waited=0 holder_pid holder_at now
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    holder_pid="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
    holder_at="$(cat "$LOCK_DIR/acquired_at" 2>/dev/null || true)"
    now="$(date +%s)"
    if [ -n "$holder_pid" ] && ! kill -0 "$holder_pid" 2>/dev/null; then
      log "lock held by dead pid $holder_pid; reclaiming"
      rm -rf "$LOCK_DIR" 2>/dev/null
      continue
    fi
    case "$holder_at" in
      ''|*[!0-9]*) ;;
      *) if [ $((now - holder_at)) -ge "$LAND_LOCK_STALE" ]; then
           log "lock older than ${LAND_LOCK_STALE}s (pid ${holder_pid:-unknown}); reclaiming"
           rm -rf "$LOCK_DIR" 2>/dev/null
           continue
         fi ;;
    esac
    [ "$waited" -ge "$LAND_LOCK_TIMEOUT" ] && return 1
    sleep "$LOCK_POLL"
    waited=$((waited + LOCK_POLL))
  done
  printf '%s\n' "$$" >"$LOCK_DIR/pid"
  date +%s >"$LOCK_DIR/acquired_at"
  LOCK_HELD=1
  return 0
}

release_lock() {
  [ "$LOCK_HELD" = 1 ] || return 0
  rm -rf "$LOCK_DIR" 2>/dev/null
  LOCK_HELD=0
}

# main_before is set once we know we are about to mutate; cleanup restores it
# on any signal or early return so a killed script never leaves main
# half-merged.
MAIN_BEFORE=""
cleanup() {
  local rc=$?
  if [ -n "$MAIN_BEFORE" ]; then
    g merge --abort >/dev/null 2>&1
    if [ "$(g rev-parse "$DEFAULT_BRANCH" 2>/dev/null)" != "$MAIN_BEFORE" ]; then
      log "restoring $DEFAULT_BRANCH to $MAIN_BEFORE after interruption"
      g reset -q --hard "$MAIN_BEFORE" 2>/dev/null
    fi
  fi
  release_lock
  exit "$rc"
}
trap cleanup EXIT INT TERM

# ---------------------------------------------------------------- 1. already landed?
BRANCH_EXISTS=0
g rev-parse --verify -q "refs/heads/$BRANCH" >/dev/null 2>&1 && BRANCH_EXISTS=1
CURRENT_STATUS="$(manifest_status "$SLICE")"
if [ "$BRANCH_EXISTS" = 0 ] && [ "$CURRENT_STATUS" = "ported" ]; then
  log "slice '$SLICE' already landed ($BRANCH gone, manifest status ported); nothing to do"
  exit 0
fi
[ -n "$CURRENT_STATUS" ] || die "no manifest entry for slice '$SLICE'"

# ---------------------------------------------------------------- 2. td approval
ISSUE_JSON="$(cd "$REPO_ROOT" && td list -l "slice:$SLICE" -a --format json 2>/dev/null)"
ISSUE_ID="$(printf '%s' "$ISSUE_JSON" | jq -r --arg lbl "slice:$SLICE" '
  [.[] | select(.labels != null and (.labels | index($lbl)))][0].id // empty' 2>/dev/null)"
[ -n "$ISSUE_ID" ] || die "no td issue labeled slice:$SLICE"

ISSUE="$(cd "$REPO_ROOT" && td show "$ISSUE_ID" --json 2>/dev/null)"
[ -n "$ISSUE" ] || die "td show $ISSUE_ID failed"

ISSUE_STATUS="$(printf '%s' "$ISSUE" | jq -r '.status // empty')"
APPROVED="$(printf '%s' "$ISSUE" | jq -r '
  [(.review_history // [])[] | select(.decision == "approved" and (.superseded | not))] | length > 0')"
if [ "$ISSUE_STATUS" != "closed" ] || [ "$APPROVED" != "true" ]; then
  die "$ISSUE_ID (slice $SLICE) is not approved+closed (status=$ISSUE_STATUS, approved=$APPROVED)"
fi

# ---------------------------------------------------------------- 3. branch exists
[ "$BRANCH_EXISTS" = 1 ] || die "branch $BRANCH does not exist"

# NOTE: the "on $DEFAULT_BRANCH, working tree clean" check deliberately does
# NOT happen here. $REPO_ROOT is a single shared checkout: while a sibling
# invocation holds the lock and is mid-merge, this checkout is transiently
# dirty through no fault of ours. Checking cleanliness before the lock made
# a concurrent, perfectly healthy landing look like a dirty-tree refusal.
# The real check happens once we hold the lock ourselves, below.

# ---------------------------------------------------------------- 4. cheap pre-check
merge_would_conflict() { # merge_would_conflict <branch>
  ! g merge-tree --write-tree "$DEFAULT_BRANCH" "$1" >/dev/null 2>&1
}
if merge_would_conflict "$BRANCH"; then
  record "$ISSUE_ID" "porting/land refused: $BRANCH would conflict with $DEFAULT_BRANCH; landing skipped, main untouched"
  die "$BRANCH would conflict with $DEFAULT_BRANCH (pre-check)"
fi

# ---------------------------------------------------------------- 5. lock
acquire_lock || die "timed out after ${LAND_LOCK_TIMEOUT}s waiting for the landing lock ($LOCK_DIR)"

# A sibling invocation (the other harness) may have landed this exact slice
# while we were waiting for the lock — re-check the idempotent-no-op
# condition now that we hold it, before touching anything. Without this, the
# re-verify below would run merge-tree against a branch that no longer
# exists and misreport it as a conflict.
if ! g rev-parse --verify -q "refs/heads/$BRANCH" >/dev/null 2>&1 \
   && [ "$(manifest_status "$SLICE")" = "ported" ]; then
  log "slice '$SLICE' was landed by a concurrent run while waiting for the lock; nothing to do"
  exit 0
fi

# Now that we hold the lock, $REPO_ROOT's checkout is ours alone to inspect
# and mutate: no sibling invocation can be mid-merge here too.
[ "$(g symbolic-ref -q --short HEAD 2>/dev/null)" = "$DEFAULT_BRANCH" ] \
  || die "$REPO_ROOT is not on $DEFAULT_BRANCH (detached or on another branch)"
[ -z "$(g status --porcelain 2>/dev/null)" ] \
  || die "$REPO_ROOT working tree is not clean"

# ---------------------------------------------------------------- 6. re-verify + merge
MAIN_BEFORE="$(g rev-parse "$DEFAULT_BRANCH")"

if merge_would_conflict "$BRANCH"; then
  record "$ISSUE_ID" "porting/land refused: $BRANCH would conflict with $DEFAULT_BRANCH (re-checked under lock); landing skipped, main untouched"
  MAIN_BEFORE=""   # nothing mutated yet; cleanup should not touch main
  die "$BRANCH would conflict with $DEFAULT_BRANCH (re-check under lock)"
fi

BEHAVIOR="$(jq -rc --arg id "$SLICE" 'select(.id == $id) | .behavior' "$MANIFEST" | head -1)"
if ! g merge --no-ff --no-edit -m "Land port/$SLICE: ${BEHAVIOR:-$SLICE}" "$BRANCH" >/dev/null 2>&1; then
  g merge --abort >/dev/null 2>&1
  MAIN_BEFORE=""
  record "$ISSUE_ID" "porting/land refused: merge of $BRANCH into $DEFAULT_BRANCH failed unexpectedly; main untouched"
  die "merge of $BRANCH failed even after a clean merge-tree check"
fi

# Agents already advance the manifest status ON their port branch as part of
# doing the work (e.g. "porting: mark format parser ported" landing with
# format-parse) — this is the normal, expected path, not an edge case. When
# the merge has already brought the target status in, there is nothing left
# to change: skip straight to the test suite rather than writing an
# identical status and asking git to commit a no-op diff, which git refuses
# (nothing staged) and which this script must not mistake for a real failure.
POST_MERGE_STATUS="$(manifest_status "$SLICE")"
if [ "$POST_MERGE_STATUS" = "ported" ]; then
  log "$SLICE manifest status already 'ported' (set by $BRANCH itself); skipping status commit"
else
  if ! manifest_set_status "$SLICE" "ported"; then
    g reset -q --hard "$MAIN_BEFORE"
    record "$ISSUE_ID" "porting/land refused: could not update manifest status to ported; $DEFAULT_BRANCH reset to $MAIN_BEFORE"
    die "failed to rewrite manifest status for $SLICE"
  fi
  g add porting/manifest.jsonl >/dev/null 2>&1
  if git -C "$REPO_ROOT" diff --cached --quiet -- porting/manifest.jsonl; then
    log "$SLICE manifest status update produced no diff; skipping empty commit"
  elif ! g commit -q -m "porting: mark $SLICE ported (landed $BRANCH)"; then
    g reset -q --hard "$MAIN_BEFORE"
    record "$ISSUE_ID" "porting/land refused: could not commit manifest status update; $DEFAULT_BRANCH reset to $MAIN_BEFORE"
    die "failed to commit manifest status update for $SLICE"
  fi
fi

# ---------------------------------------------------------------- test suite
# LAND_TEST_CMD is a shell command string (default "ruby test/all.rb"), run
# through `sh -c` so an override may use shell syntax (pipes, &&, …).
run_tests() {
  if [ -n "$TIMEOUT_BIN" ]; then
    ( cd "$REPO_ROOT" && "$TIMEOUT_BIN" -k 30 "$LAND_TEST_TIMEOUT" sh -c "$LAND_TEST_CMD" )
  else
    ( cd "$REPO_ROOT" && sh -c "$LAND_TEST_CMD" )
  fi
}

if ! TEST_OUTPUT="$(run_tests 2>&1)"; then
  g reset -q --hard "$MAIN_BEFORE"
  record "$ISSUE_ID" "porting/land refused: test suite failed on the merge of $BRANCH; $DEFAULT_BRANCH reset to $MAIN_BEFORE. Tail: $(printf '%s' "$TEST_OUTPUT" | tail -c 500)"
  die "test suite failed on the merged result; $DEFAULT_BRANCH restored to $MAIN_BEFORE"
fi

# ---------------------------------------------------------------- 7. success
LANDED_SHA="$(g rev-parse "$DEFAULT_BRANCH")"
MAIN_BEFORE=""   # landed; cleanup must not revert on later, unrelated signals

if [ "$ISSUE_STATUS" != "closed" ]; then
  ( cd "$REPO_ROOT" && td close "$ISSUE_ID" --admin "landed by porting/land" >/dev/null 2>&1 )
fi

if ! g branch -d "$BRANCH" >/dev/null 2>&1; then
  log "WARNING: $DEFAULT_BRANCH advanced to $LANDED_SHA but could not delete $BRANCH (checked out elsewhere? not fully merged?) — remove it by hand"
fi

record "$ISSUE_ID" "porting/land: merged $BRANCH into $DEFAULT_BRANCH at $LANDED_SHA, manifest marked ported, branch deleted"
log "landed $SLICE: $DEFAULT_BRANCH now at $LANDED_SHA"
exit 0
