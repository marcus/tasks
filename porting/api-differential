# The routes recorded in porting/intentional-differences.md as refused by the Go
# build. A divergence on one of these is EXPECTED; a divergence anywhere else is
# a defect, and a route here that stops diverging means the capability landed and
# the entry should be retired.
EXPECTED_REFUSALS = [
  "create with recurrence", "create with deadline", "create with scheduled",
  "placement move", "parent unnest", "delete", "approve", "delegate",
  "project create", "project complete", "store bytes"
].freeze

class Server
  attr_reader :dir, :port

  def initialize(name, command, records: FIXTURE_RECORDS, archive: ARCHIVE_RECORDS)
    @dir = Dir.mktmpdir("api-diff-#{name}")
    File.write(File.join(@dir, "tasks.jsonl"), Tasks::Format.dump(records))
    File.write(File.join(@dir, "archive.jsonl"), Tasks::Format.dump(archive)) if archive
    @port = Server.free_port
    @log = Tempfile.new("api-diff-log")
    env = {
      "TASKS_DEVICE" => "pinned",
      "TASKS_FILE" => File.join(@dir, "tasks.jsonl"),
      "TASKS_ARCHIVE" => File.join(@dir, "archive.jsonl"),
      "XDG_STATE_HOME" => File.join(@dir, "state"),
      "XDG_CONFIG_HOME" => File.join(@dir, "config")
    }
    @pid = Process.spawn(env, *command, "--port", @port.to_s, chdir: ROOT, out: @log, err: @log)
    wait_for_ready
  end

  def self.free_port
    server = TCPServer.new("127.0.0.1", 0)
    port = server.addr[1]
    server.close
    port
  end

  def wait_for_ready
    Timeout.timeout(20) do
      loop do
        begin
          return if call("GET", "/healthz").fetch(:code) == "200"
        rescue Errno::ECONNREFUSED, EOFError
          raise "server exited during startup\n#{log_text}" unless alive?

          sleep 0.05
        end
      end
    end
  end

  def alive?
    Process.kill(0, @pid)
    true
  rescue Errno::ESRCH
    false
  end

  def call(method, path, body: nil, raw: nil, headers: {}, content_type: nil)
    request = Net::HTTP.const_get(method.capitalize).new(path)
    headers.each { |name, value| request[name] = value }
    if raw || body
      request["Content-Type"] = content_type || "application/json"
      request.body = raw || JSON.generate(body)
    end
    response = Net::HTTP.start("127.0.0.1", @port) { |client| client.request(request) }
    {
      code: response.code, etag: response["etag"], location: response["location"],
      content_type: response["content-type"], cache_control: response["cache-control"],
      body: response.body
    }
  end

  def bytes = File.binread(File.join(@dir, "tasks.jsonl"))
  def log_text = File.read(@log.path)

  def stop
    Process.kill("TERM", @pid)
    Timeout.timeout(5) { Process.wait(@pid) }
  rescue Errno::ESRCH, Errno::ECHILD, Timeout::Error
    nil
  ensure
    FileUtils.remove_entry(@dir) if File.directory?(@dir)
  end
end

# Normalization. Request ids, revision digests, freshly minted task ids and
# today's date are all legitimately different between two independent servers.
# NOTHING else is.
def scrub(value, seen)
  return value unless value.is_a?(String)

  out = value.dup
  out.gsub!(/req_[0-9a-f]{16}/, "req_X")
  out.gsub!(/v1\.[0-9a-f]{64}\.[0-9a-f]{64}\.[0-9a-f]{64}/, "REV")
  out.gsub!(/s1\.[0-9a-f]{64}/, "SREV")
  out.gsub!(/\b[0-9a-f]{8}\b/) do |id|
    next id if KNOWN_IDS.include?(id)

    seen[id] ||= "NEW#{seen.length + 1}"
    seen[id]
  end
  out.gsub!(Date.today.iso8601, "TODAY")
  out
end

class Comparison
  attr_reader :matches, :mismatches, :unexpected

  def initialize
    @matches = 0
    @mismatches = []
    @unexpected = []
  end

  def compare(name, ruby, go, keys: %i[code etag location content_type cache_control body])
    ruby_seen = {}
    go_seen = {}
    differing = keys.select { |key| scrub(ruby[key], ruby_seen) != scrub(go[key], go_seen) }
    if differing.empty?
      @matches += 1
      puts "  ok       #{name}"
      return
    end
    expected = EXPECTED_REFUSALS.include?(name)
    @mismatches << name
    @unexpected << name unless expected
    puts "  #{expected ? "refused " : "DIFF    "} #{name} (#{differing.join(", ")})"
    return if expected

    differing.each do |key|
      puts "      ruby #{key}: #{scrub(ruby[key], ruby_seen).to_s[0, 700]}"
      puts "      go   #{key}: #{scrub(go[key], go_seen).to_s[0, 700]}"
    end
  end
end

