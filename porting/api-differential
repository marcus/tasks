def run_writes(comparison)
  puts "writes"
  ruby = Server.new("ruby-writes", [RUBY_BIN], archive: nil)
  go = Server.new("go-writes", [GO_BIN], archive: nil)

  both = lambda do |name, method, path, **options|
    comparison.compare(name, ruby.call(method, path, **options), go.call(method, path, **options))
  end
  # The precondition is read from RUBY and reused for both: the two servers
  # agree on a task's revision over identical bytes, which is itself the
  # assertion — a divergence here shows up as a 412 on the Go side.
  tag = ->(id) { ruby.call("GET", "/api/v1/tasks/#{id}").fetch(:etag) }

  both.call("create simple", "POST", "/api/v1/tasks", body: { title: "Fresh task" })
  both.call("create rich", "POST", "/api/v1/tasks",
            body: { title: "Rich task", priority: "B", tags: ["api"], contexts: ["@desk"],
                    state: "NEXT", project: "Work", body: %w[one two] })
  both.call("create under parent", "POST", "/api/v1/tasks",
            body: { title: "Child task", parent_id: FIX[:work] })
  both.call("create bad parent", "POST", "/api/v1/tasks",
            body: { title: "Orphan", parent_id: "deadbeef" })
  both.call("create with scheduled", "POST", "/api/v1/tasks",
            body: { title: "Scheduled", scheduled: "2026-07-20" })
  both.call("create with recurrence", "POST", "/api/v1/tasks",
            body: { title: "Recurring", scheduled: "2026-07-20", recurrence: "weekly" })

  pr = FIX[:pr]
  baseline = tag.call(pr)
  both.call("patch title and priority", "PATCH", "/api/v1/tasks/#{pr}",
            body: { title: "Changed through HTTP", priority: "A" },
            headers: { "If-Match" => baseline })
  both.call("patch stale", "PATCH", "/api/v1/tasks/#{pr}",
            body: { title: "Should lose" }, headers: { "If-Match" => baseline })
  current = tag.call(pr)
  both.call("patch no-op", "PATCH", "/api/v1/tasks/#{pr}",
            body: { title: "Changed through HTTP" }, headers: { "If-Match" => current })
  both.call("patch contexts tags body", "PATCH", "/api/v1/tasks/#{pr}",
            body: { contexts: ["@home"], tags: ["changed"], body: ["line one", "line two"] },
            headers: { "If-Match" => current })
  [
    ["patch deferred", { deferred: true }],
    ["patch scheduled with time",
     { scheduled: "2026-07-21",
       scheduled_time: { local: "09:30", timezone: "America/New_York", fold: 0 } }],
    ["patch date only keeps time", { scheduled: "2026-07-22" }],
    ["patch clear time", { scheduled_time: nil }],
    ["patch recurrence", { recurrence: "weekly" }],
    ["patch lead", { lead: "3d" }],
    ["patch lead off", { lead: nil }],
    ["patch recurrence off", { recurrence: nil }],
    ["patch clear scheduled", { scheduled: nil }],
    ["patch state", { state: "TODO" }]
  ].each do |name, body|
    both.call(name, "PATCH", "/api/v1/tasks/#{pr}", body: body,
                    headers: { "If-Match" => tag.call(pr) })
  end

  flight = tag.call(FIX[:flight])
  [
    ["patch bad recurrence", { recurrence: "every blorp" }],
    ["patch bad lead", { lead: "3 blorps" }],
    ["patch empty changeset", {}],
    ["patch placement malformed", { placement: { parent_id: FIX[:work], after_id: FIX[:eval] } }],
    ["patch placement and parent", { parent_id: FIX[:home], placement: { parent_id: FIX[:work] } }],
    ["patch dst gap",
     { deadline: "2026-03-08", deadline_time: { local: "02:30", timezone: "America/Los_Angeles" } }],
    ["patch unknown zone", { deadline_time: { local: "09:00", timezone: "PST" } }],
    ["patch derived field",
     { deadline_time: { local: "09:00", instant: "2026-07-20T09:00:00Z" } }]
  ].each do |name, body|
    both.call(name, "PATCH", "/api/v1/tasks/#{FIX[:flight]}", body: body,
                    headers: { "If-Match" => flight })
  end
  both.call("patch missing task", "PATCH", "/api/v1/tasks/deadbeef",
            body: { title: "x" }, headers: { "If-Match" => flight })

  both.call("placement move", "PATCH", "/api/v1/tasks/#{FIX[:plants]}",
            body: { placement: { parent_id: FIX[:work] } },
            headers: { "If-Match" => tag.call(FIX[:plants]) })
  both.call("parent unnest", "PATCH", "/api/v1/tasks/bbbb0002",
            body: { parent_id: nil }, headers: { "If-Match" => tag.call("bbbb0002") })
  # -- delete ----------------------------------------------------------------
  #
  # A delete compares ALL THREE revision components, and `location` includes the
  # sibling id list, so two servers that have each minted their own id into a
  # section hold legitimately DIFFERENT revisions for every task in it. Measured
  # on both binaries: after one create in Inbox and one in Work, `own` and
  # `lifecycle` still agree for the existing siblings and `location` differs.
  #
  # A borrowed precondition would therefore make the Go side 412 on a request
  # Ruby performs, which reads as a defect and is not one. The patches above can
  # borrow Ruby's tag because a changeset compares only the components its own
  # fields touch; a delete cannot, so each server supplies its own current tag.
  # The assertion is unchanged in kind: identical requests, each with its own
  # current precondition, must produce identical responses and identical bytes.
  own_tag = ->(server, id) { server.call("GET", "/api/v1/tasks/#{id}").fetch(:etag) }
  delete_case = lambda do |name, path, id, ruby_tag: nil, go_tag: nil|
    comparison.compare(
      name,
      ruby.call("DELETE", path, headers: { "If-Match" => ruby_tag || own_tag.call(ruby, id) }),
      go.call("DELETE", path, headers: { "If-Match" => go_tag || own_tag.call(go, id) })
    )
  end

  delete_case.call("delete", "/api/v1/tasks/#{FIX[:garden]}", FIX[:garden])
  # bbbb0002 was unnested above, so the PR task has exactly one descendant left.
  delete_case.call("delete refuses descendants", "/api/v1/tasks/#{pr}", pr)
  # Each server's own pre-patch revision, so the staleness below is real on both.
  stale_ruby = own_tag.call(ruby, FIX[:eval])
  stale_go = own_tag.call(go, FIX[:eval])
  both.call("patch before a stale delete", "PATCH", "/api/v1/tasks/#{FIX[:eval]}",
            body: { title: "Renamed under the old revision" },
            headers: { "If-Match" => stale_ruby })
  delete_case.call("delete stale", "/api/v1/tasks/#{FIX[:eval]}", FIX[:eval],
                   ruby_tag: stale_ruby, go_tag: stale_go)
  delete_case.call("delete missing", "/api/v1/tasks/deadbeef", FIX[:flight])
  delete_case.call("delete cascade", "/api/v1/tasks/#{pr}?cascade=true", pr)
  # The garden task is gone by now, so these two are the missing-precondition
  # path: a deleted task has no ETag to borrow, and both servers refuse on the
  # header before they ever look for the task.
  both.call("approve a deleted task", "POST", "/api/v1/tasks/#{FIX[:garden]}/approve",
            headers: { "If-Match" => tag.call(FIX[:garden]) })
  both.call("delegate", "POST", "/api/v1/tasks/#{FIX[:garden]}/delegate",
            body: { kind: "agent", mode: "refine" },
            headers: { "If-Match" => tag.call(FIX[:garden]) })

  # -- proposals -------------------------------------------------------------
  #
  # A decision is an own-field write, so the per-server tags are unnecessary
  # here: the `own` component agrees over identical semantic values even when the
  # sibling lists do not. Each proposal is created through the API, so the id is
  # minted independently on each side and the paths differ — hence a lambda that
  # takes the per-server id rather than one shared path.
  propose = lambda do |title, extra = {}|
    ruby_created = ruby.call("POST", "/api/v1/tasks", body: { title: title, state: "PROPOSED" }.merge(extra))
    go_created = go.call("POST", "/api/v1/tasks", body: { title: title, state: "PROPOSED" }.merge(extra))
    comparison.compare("propose #{title}", ruby_created, go_created)
    [ruby_created, go_created].map do |created|
      payload = JSON.parse(created.fetch(:body))
      [payload.dig("data", "id"), created.fetch(:etag)]
    end
  end
  decide = lambda do |name, verb, pair, **options|
    (ruby_id, ruby_tag), (go_id, go_tag) = pair
    comparison.compare(
      name,
      ruby.call("POST", "/api/v1/tasks/#{ruby_id}/#{verb}",
                **options.merge(headers: { "If-Match" => ruby_tag }.merge(options[:headers] || {}))),
      go.call("POST", "/api/v1/tasks/#{go_id}/#{verb}",
              **options.merge(headers: { "If-Match" => go_tag }.merge(options[:headers] || {})))
    )
  end

  comparison.compare("proposed scope", ruby.call("GET", "/api/v1/tasks?scope=proposed"),
                     go.call("GET", "/api/v1/tasks?scope=proposed"))
  approvable = propose.call("Research backup providers")
  decide.call("approve without if-match", "approve", approvable.map { |id, _| [id, nil] })
  decide.call("approve", "approve", approvable)
  decide.call("approve twice", "approve", approvable)
  decide.call("approve rejects a body", "approve", approvable, body: { notes: "x" })

  rejectable = propose.call("Review subscriptions")
  decide.call("reject", "reject", rejectable)

  noted = propose.call("Duplicate proposal", body: "Original rationale.")
  decide.call("reject with notes", "reject", noted,
              body: { notes: ["Duplicate — already rejected previously.", "Same renewal mail."] })

  single = propose.call("Single note proposal")
  decide.call("reject with one string note", "reject", single, body: { notes: "Just the one." })

  bad = propose.call("Bad notes proposal")
  decide.call("reject with non-text notes", "reject", bad, body: { notes: [1, 2] })
  decide.call("reject with an unknown field", "reject", bad, body: { reason: "nope" })
  decide.call("reject with an empty note list", "reject", bad, body: { notes: [] })

  # A task that is not a proposal carries the domain's own sentence, which is the
  # only useful thing to say about the refusal.
  both.call("approve a non-proposal", "POST", "/api/v1/tasks/#{FIX[:flight]}/approve",
            headers: { "If-Match" => tag.call(FIX[:flight]) })
  both.call("project create", "POST", "/api/v1/projects", body: { title: "New project" })
  both.call("project complete", "POST", "/api/v1/projects/#{FIX[:work]}/complete")

  # Every write above is one both builds perform, so the two files must agree
  # byte for byte under the documented normalization. No exception applies to
  # this comparison, and none should ever be added to it: a divergence here means
  # two servers given the same requests wrote different task data.
  comparison.compare("store bytes", { body: ruby.bytes }, { body: go.bytes }, keys: [:body])

  # The one create this build refuses, kept LAST so it cannot contaminate the
  # comparison above. Go answers a stated 501 rather than persisting an all-day
  # date and calling it a success, so Ruby ends with one record Go does not have —
  # and that single record is the whole of the divergence below.
  both.call("create with deadline", "POST", "/api/v1/tasks",
            body: { title: "Dated", deadline: "2026-07-20",
                    deadline_time: { local: "17:00", timezone: "Europe/London", fold: 0 } })
  comparison.compare("store bytes after the refused dated create",
                     { body: ruby.bytes }, { body: go.bytes }, keys: [:body])
ensure
  ruby&.stop
  go&.stop
end

# The reads the project writes are judged against. A divergence here would make
# every comparison after it meaningless, so they run first.
PROJECT_READ_CASES = [
  "/api/v1/projects",
  "/api/v1/projects/#{PFIX[:site]}",
  "/api/v1/projects/#{PFIX[:tasks]}",
  "/api/v1/projects/#{PFIX[:parked]}",
  "/api/v1/projects/#{PFIX[:candidate]}",
  "/api/v1/projects/#{PFIX[:donepile]}"
].freeze

def run_projects(comparison)
  puts "projects"
  ruby = Server.new("ruby-projects", [RUBY_BIN], records: PROJECT_FIXTURE_RECORDS, archive: nil)
  go = Server.new("go-projects", [GO_BIN], records: PROJECT_FIXTURE_RECORDS, archive: nil)

  both = lambda do |name, method, path, **options|
    comparison.compare(name, ruby.call(method, path, **options), go.call(method, path, **options))
  end
  files = lambda do |name|
    comparison.compare("#{name} (live)", { body: ruby.bytes }, { body: go.bytes }, keys: [:body])
    comparison.compare("#{name} (archive)",
                       { body: ruby.archive_bytes }, { body: go.archive_bytes }, keys: [:body])
  end

  PROJECT_READ_CASES.each { |path| both.call("GET #{path}", "GET", path) }

  # -- create ----------------------------------------------------------------
  both.call("project create", "POST", "/api/v1/projects", body: { title: "Mid-year Reviews" })
  both.call("project create duplicate title", "POST", "/api/v1/projects", body: { title: "site launch" })
  both.call("project create duplicate area title", "POST", "/api/v1/projects", body: { title: "TASKS" })
  both.call("project create blank title", "POST", "/api/v1/projects", body: { title: "   " })
  both.call("project create missing title", "POST", "/api/v1/projects", body: {})
  both.call("project create non-string title", "POST", "/api/v1/projects", raw: '{"title":7}')
  both.call("project create unknown field", "POST", "/api/v1/projects",
            body: { title: "X", colour: "red" })
  both.call("project create unknown query", "POST", "/api/v1/projects?bogus=1", body: { title: "X" })
  both.call("project create non-object body", "POST", "/api/v1/projects", raw: "[]")
  both.call("project create text body", "POST", "/api/v1/projects",
            raw: '{"title":"X"}', content_type: "text/plain")
  both.call("project create foreign origin", "POST", "/api/v1/projects",
            body: { title: "X" }, headers: { "Origin" => "https://evil.example" })

  # -- rename ----------------------------------------------------------------
  both.call("project rename", "PATCH", "/api/v1/projects/#{PFIX[:reno]}",
            body: { title: "  Kitchen reno  " })
  both.call("project rename blank title", "PATCH", "/api/v1/projects/#{PFIX[:reno]}",
            body: { title: "   " })
  both.call("project rename missing title", "PATCH", "/api/v1/projects/#{PFIX[:reno]}", body: {})
  both.call("project rename unknown field", "PATCH", "/api/v1/projects/#{PFIX[:reno]}",
            body: { title: "X", colour: "red" })
  both.call("project rename unknown query", "PATCH", "/api/v1/projects/#{PFIX[:reno]}?bogus=1",
            body: { title: "X" })
  both.call("project rename needs no if-match", "PATCH", "/api/v1/projects/#{PFIX[:reno]}",
            body: { title: "Kitchen reno" })
  both.call("project rename missing project", "PATCH", "/api/v1/projects/ffffffff",
            body: { title: "Ghost" })
  both.call("project rename malformed id", "PATCH", "/api/v1/projects/not-hex",
            body: { title: "Ghost" })
  # Four ids that are not projects or areas. Each must refuse BEFORE the store's
  # mechanical section retitle runs — the live bytes below prove it.
  both.call("project rename inbox", "PATCH", "/api/v1/projects/#{PFIX[:inbox]}",
            body: { title: "Renamed" })
  both.call("project rename projects root", "PATCH", "/api/v1/projects/#{PFIX[:projects]}",
            body: { title: "Renamed" })
  both.call("project rename done pile", "PATCH", "/api/v1/projects/#{PFIX[:donepile]}",
            body: { title: "Renamed" })
  both.call("project rename a nested sub-section", "PATCH", "/api/v1/projects/#{PFIX[:site_sub]}",
            body: { title: "Renamed" })
  both.call("project rename a task id", "PATCH", "/api/v1/projects/#{PFIX[:reno_todo]}",
            body: { title: "Renamed" })
  both.call("project rename foreign origin", "PATCH", "/api/v1/projects/#{PFIX[:reno]}",
            body: { title: "X" }, headers: { "Origin" => "https://evil.example" })
  files.call("bytes after the rename refusals")
  # Retitling the "Tasks" area to "Inbox" moves it OUT of the read model, so the
  # 200 is synthesized from the pre-read. That area's NEXT task carries a timed
  # deadline, which is exactly what a synthesis that forgets `next_time`/`next_at`
  # drops on the floor.
  both.call("project rename area out of scope", "PATCH", "/api/v1/projects/#{PFIX[:tasks]}",
            body: { title: "Inbox" })

  # -- complete --------------------------------------------------------------
  both.call("project complete", "POST", "/api/v1/projects/#{PFIX[:site]}/complete")
  both.call("project complete again", "POST", "/api/v1/projects/#{PFIX[:site]}/complete")
  both.call("project complete rejects a body", "POST", "/api/v1/projects/#{PFIX[:empty]}/complete",
            body: { unexpected: true })
  both.call("project complete rejects a text body", "POST", "/api/v1/projects/#{PFIX[:empty]}/complete",
            raw: "nope", content_type: "text/plain")
  both.call("project complete unknown query", "POST", "/api/v1/projects/#{PFIX[:empty]}/complete?force=true")
  both.call("project complete empty project", "POST", "/api/v1/projects/#{PFIX[:empty]}/complete")
  both.call("project complete missing project", "POST", "/api/v1/projects/ffffffff/complete")
  both.call("project complete inbox", "POST", "/api/v1/projects/#{PFIX[:inbox]}/complete")
  both.call("project complete projects root", "POST", "/api/v1/projects/#{PFIX[:projects]}/complete")
  both.call("project complete a task id", "POST", "/api/v1/projects/#{PFIX[:reno_todo]}/complete")
  both.call("project complete foreign origin", "POST", "/api/v1/projects/#{PFIX[:empty]}/complete",
            headers: { "Origin" => "https://evil.example" })
  # An area with no open work left drops out of the read model, so this 200 is
  # synthesized too — zero rollups and stuck.
  both.call("project complete area out of scope", "POST", "/api/v1/projects/#{PFIX[:errands]}/complete")
  files.call("bytes after complete")

  # -- archive ---------------------------------------------------------------
  # The proposal refusal runs FIRST, while no archive file exists yet, so the
  # comparison right after it proves a refused sweep creates nothing.
  both.call("project archive never sweeps an undecided proposal", "POST",
            "/api/v1/projects/#{PFIX[:candidate]}/archive?force=true")
  files.call("bytes after the proposal refusal")
  both.call("project archive refuses open work", "POST", "/api/v1/projects/#{PFIX[:reno]}/archive")
  both.call("project archive refuses a deferred-only project", "POST",
            "/api/v1/projects/#{PFIX[:parked]}/archive")
  both.call("project archive unknown query", "POST", "/api/v1/projects/#{PFIX[:parked]}/archive?bogus=1")
  both.call("project archive bad force value", "POST", "/api/v1/projects/#{PFIX[:parked]}/archive?force=yes")
  both.call("project archive rejects a body", "POST", "/api/v1/projects/#{PFIX[:parked]}/archive",
            body: { unexpected: true })
  both.call("project archive missing project", "POST", "/api/v1/projects/ffffffff/archive")
  both.call("project archive inbox", "POST", "/api/v1/projects/#{PFIX[:inbox]}/archive")
  both.call("project archive foreign origin", "POST", "/api/v1/projects/#{PFIX[:parked]}/archive",
            headers: { "Origin" => "https://evil.example" })
  files.call("bytes after the archive refusals")
  both.call("project archive force sweeps open work", "POST",
            "/api/v1/projects/#{PFIX[:reno]}/archive?force=true")
  both.call("project archive force sweeps a deferred-only project", "POST",
            "/api/v1/projects/#{PFIX[:parked]}/archive?force=true")
  both.call("project archive empty project needs no force", "POST",
            "/api/v1/projects/#{PFIX[:empty]}/archive")
  # The completed project sweeps without force, sub-section and all.
  both.call("project archive a completed project", "POST", "/api/v1/projects/#{PFIX[:site]}/archive")
  both.call("project archive twice", "POST", "/api/v1/projects/#{PFIX[:reno]}/archive")
  files.call("bytes after the sweeps")

  # The read model, after all of it, from a store both servers have rewritten.
  both.call("GET /api/v1/projects after the writes", "GET", "/api/v1/projects")
  both.call("GET /api/v1/tasks?scope=archived after the writes", "GET", "/api/v1/tasks?scope=archived")
  both.call("GET /api/v1/meta after the writes", "GET", "/api/v1/meta")
ensure
  ruby&.stop
  go&.stop
end

unless File.executable?(GO_BIN)
  abort "tasks-api (Go) not found at #{GO_BIN}\n" \
        "build it with: (cd go && go build -o bin/tasks-api ./cmd/tasks-api)"
end

phases = ARGV.empty? ? %w[reads transport writes projects] : ARGV
comparison = Comparison.new
phases.each do |phase|
  case phase
  when "reads" then run_reads(comparison)
  when "transport" then run_transport(comparison)
  when "writes" then run_writes(comparison)
  when "projects" then run_projects(comparison)
  else abort "unknown phase: #{phase}"
  end
end

total = comparison.matches + comparison.mismatches.length
puts
puts "#{comparison.matches}/#{total} identical; " \
     "#{comparison.mismatches.length - comparison.unexpected.length} recorded refusal(s); " \
     "#{comparison.unexpected.length} unexplained"
exit(comparison.unexpected.empty? ? 0 : 1)
