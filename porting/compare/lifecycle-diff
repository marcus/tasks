#!/usr/bin/env ruby
# frozen_string_literal: true

# lifecycle-diff — the differential harness for Wave 3's store lifecycle packet:
# undo, redo, delete, archive, repair, approve and reject.
#
# It runs the same argv against `bin/tasks` and against the built Go binary, in
# two byte-identical sandboxes seeded from a fixture, and diffs everything an
# observer can see: stdout, stderr, exit status, and the bytes of tasks.jsonl,
# archive.jsonl and the journal's index.json.
#
# It also runs the two CROSS-LANGUAGE directions the cutover depends on, which
# no single-implementation test can reach:
#
#   * Ruby writes, Go undoes — rollback from data the old binary produced;
#   * Go writes, Ruby undoes — rollback from data the NEW binary produced,
#     which is the rehearsal the cutover plan requires before Ruby is retired.
#
# Usage:  porting/compare/lifecycle-diff [--verbose]

require "digest"
require "fileutils"
require "json"
require "open3"
require "tmpdir"

ROOT = File.expand_path("../..", __dir__)
RUBY_BIN = File.join(ROOT, "bin", "tasks")
GO_BIN = File.join(ROOT, "go", "bin", "tasks")
FIXTURES = File.join(ROOT, "porting", "fixtures")

VERBOSE = ARGV.include?("--verbose")

PINS = {
  "TASKS_PIN_NOW" => "2026-03-14T15:09:26Z",
  "TASKS_PIN_IDS" => "dddd0001,dddd0002,dddd0003,dddd0004,dddd0005,dddd0006",
  "TASKS_PIN_COALESCE_SCOPE" => "pinned-scope",
  "TASKS_PIN_DELEGATION_KEYS" => "eeee0001eeee0001,eeee0002eeee0002",
  "TASKS_DEVICE" => "fixture",
  "TASKS_TIMEZONE" => "Etc/UTC",
}.freeze

def sandbox(dir, org_text, archive_text = nil)
  FileUtils.mkdir_p(dir)
  File.write(File.join(dir, "tasks.jsonl"), org_text)
  File.write(File.join(dir, "archive.jsonl"), archive_text) if archive_text
  dir
end

def env_for(dir)
  PINS.merge(
    "TASKS_FILE" => File.join(dir, "tasks.jsonl"),
    "TASKS_ARCHIVE" => File.join(dir, "archive.jsonl"),
    "XDG_STATE_HOME" => File.join(dir, "state"),
    "XDG_CONFIG_HOME" => File.join(dir, "config"),
    "NO_COLOR" => "1"
  )
end

def run(binary, dir, argv)
  command = binary == :ruby ? ["ruby", RUBY_BIN] : [GO_BIN]
  out, err, status = Open3.capture3(env_for(dir), *command, *argv)
  { stdout: out.force_encoding("UTF-8"), stderr: err.force_encoding("UTF-8"),
    status: status.exitstatus }
end

# Everything an observer can see afterwards. The journal index is included
# because undo's whole correctness is "where does the cursor point now".
def observe(dir)
  state = {}
  %w[tasks.jsonl archive.jsonl].each do |name|
    path = File.join(dir, name)
    state[name] = File.exist?(path) ? File.read(path, encoding: "UTF-8") : nil
  end
  index = Dir.glob(File.join(dir, "state", "tasks", "journal", "*", "index.json")).first
  if index
    data = JSON.parse(File.read(index))
    # The journal key hashes the org path, which differs per sandbox by
    # construction, so the identity is normalized away and the SHAPE is compared.
    state["journal.cursor"] = data["cursor"]
    state["journal.labels"] = data["states"].map { |s| s["label"] }
    state["journal.repair"] = data["states"].map { |s| s["repair"] }
  else
    state["journal"] = nil
  end
  state
end

$cases = 0
$failures = []

# One scenario: a seed, then a sequence of argv runs against both binaries.
# Every step is compared, not only the last, so a divergence is attributed to
# the command that caused it.
def scenario(name, org:, archive: nil, steps:)
  $cases += 1
  Dir.mktmpdir do |root|
    ruby_dir = sandbox(File.join(root, "ruby"), org, archive)
    go_dir = sandbox(File.join(root, "go"), org, archive)

    steps.each_with_index do |argv, index|
      ruby = run(:ruby, ruby_dir, argv)
      go = run(:go, go_dir, argv)
      label = "#{name} [#{index}] #{argv.join(" ")}"

      %i[stdout stderr status].each do |field|
        next if ruby[field] == go[field]

        $failures << "#{label}\n  #{field}:\n    ruby: #{ruby[field].inspect}\n    go:   #{go[field].inspect}"
      end
      ruby_state = observe(ruby_dir)
      go_state = observe(go_dir)
      ruby_state.each_key do |key|
        next if ruby_state[key] == go_state[key]

        $failures << "#{label}\n  #{key}:\n    ruby: #{ruby_state[key].inspect}\n    go:   #{go_state[key].inspect}"
      end
      warn "  ok #{label}" if VERBOSE && $failures.empty?
    end
  end
end

# A cross-language scenario: one binary writes, the OTHER undoes, in ONE
# sandbox. There is nothing to diff against — the assertion is that the second
# binary can read and revert what the first wrote, and that the file comes back
# to the bytes it started from.
def cross(name, org:, write_with:, write_steps:, undo_with:, undo_steps:)
  $cases += 1
  Dir.mktmpdir do |root|
    dir = sandbox(File.join(root, "shared"), org)
    before = File.read(File.join(dir, "tasks.jsonl"), encoding: "UTF-8")

    write_steps.each do |argv|
      result = run(write_with, dir, argv)
      unless result[:status].zero?
        $failures << "#{name}: #{write_with} #{argv.join(" ")} failed: #{result[:stderr]}"
        return
      end
    end
    after_write = File.read(File.join(dir, "tasks.jsonl"), encoding: "UTF-8")
    if after_write == before
      $failures << "#{name}: #{write_with} wrote nothing, so there is nothing to undo"
      return
    end

    undo_steps.each do |argv|
      result = run(undo_with, dir, argv)
      unless result[:status].zero?
        $failures << "#{name}: #{undo_with} #{argv.join(" ")} refused: #{result[:stderr]}"
        return
      end
    end
    restored = File.read(File.join(dir, "tasks.jsonl"), encoding: "UTF-8")
    if restored != before
      $failures << "#{name}: #{undo_with} did not restore the original bytes\n" \
                   "  before: #{before.inspect}\n  after:  #{restored.inspect}"
    end
    warn "  ok #{name}" if VERBOSE
  end
end

