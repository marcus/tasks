#!/usr/bin/env ruby
# frozen_string_literal: true

# audit — what can this observation set actually prove?
#
#   porting/compare/audit porting/evidence/phase1/ruby
#   porting/compare/audit --json porting/evidence/phase1/ruby
#
# The comparator answers "do these two sets differ?". This answers the prior
# question: "if they differed, would anything in the corpus have shown it?"
#
# A comparison over a corpus that never exercises a behavior returns GATE PASS
# for that behavior forever, and that pass means nothing. That is the exact
# shape of the false green this epic is built to prevent, so the corpus's own
# coverage is audited and reported rather than assumed.
#
# Exit status:
#   0  every gate class is exercised by at least one case
#   1  at least one gate class is not exercised (a real, reportable gap)
#   2  usage error

require "base64"
require "json"
require "optparse"

# The five classes the Phase 1 gate names, each with the predicate that decides
# whether a case exercises it.
CLASSES = {
  "exit_status" => {
    what: "the exit-status contract, including the 1-vs-2 distinction errors.md calls the most important " \
          "single assertion in the error surface",
    probe: lambda { |obs| obs.dig("process", "exit_status") }
  },
  "json_output" => {
    what: "structured stdout compared as parsed data",
    probe: lambda { |obs|
      bytes = Base64.decode64(obs.dig("process", "stdout", "bytes_base64").to_s)
      s = bytes.dup.force_encoding(Encoding::UTF_8)
      next nil unless s.valid_encoding?

      s = s.strip
      next nil unless s.start_with?("{", "[")

      (JSON.parse(s) && "json") rescue nil
    }
  },
  "write_bytes" => {
    what: "store/archive bytes actually changing, so a byte-level store comparison has something to compare",
    probe: lambda { |obs| obs.dig("files", "mutated") ? "mutated" : nil }
  },
  "revision_token" => {
    what: "implementation-reported revision tokens, the only place a divergent revision algorithm surfaces",
    probe: lambda { |obs|
      r = obs["revisions"] || {}
      (r["store"] || !Array(r["resources"]).empty?) ? "revisions" : nil
    }
  },
  "rollback" => {
    what: "a write-then-revert, distinguished from a never-wrote as a LABELLED field",
    probe: lambda { |obs| obs.dig("files", "rolled_back").nil? ? nil : "labelled" }
  }
}.freeze

options = { format: "text" }
parser = OptionParser.new do |o|
  o.banner = "usage: audit [--json] SET"
  o.on("--json") { options[:format] = "json" }
  o.on("-h", "--help") { puts o; exit 0 }
end
parser.parse!
if ARGV.length != 1
  warn parser.help
  exit 2
end

path = ARGV[0]
unless File.exist?(path)
  warn "audit: no such observation set: #{path}"
  exit 2
end

records = if File.directory?(path)
            Dir[File.join(path, "*.json")].sort.map { |f| JSON.parse(File.read(f)) }
          else
            File.readlines(path).map(&:strip).reject(&:empty?).map { |l| JSON.parse(l) }
          end

result = CLASSES.map do |name, spec|
  hits = records.filter_map { |obs| [obs["case_id"], spec[:probe].call(obs)] if spec[:probe].call(obs) }
  values = hits.map(&:last).uniq
  {
    "class" => name,
    "what" => spec[:what],
    "cases" => hits.map(&:first),
    "distinct_values" => values.sort_by(&:to_s),
    "exercised" => !hits.empty?
  }
end

# Exit status gets one extra assertion: observing only 0 and 1 leaves the 1-vs-2
# distinction untested, which is precisely the collapse errors.md warns about.
exit_row = result.find { |r| r["class"] == "exit_status" }
seen = exit_row["distinct_values"]
exit_row["notes"] = if seen.include?(2)
                      []
                    else
                      ["no case exits 2 (ref resolution failure). A port that collapsed 2 into 1 would " \
                       "pass this corpus. errors.md calls the 1-vs-2 distinction a product feature."]
                    end

rollback_row = result.find { |r| r["class"] == "rollback" }
rollback_row["notes"] = if rollback_row["exercised"]
                          []
                        else
                          ["files.rolled_back is null in every observation. The CLI signals a write-then-" \
                           "revert only as an extra stderr sentence, so the difference is detectable as a " \
                           "stderr byte difference but is never labelled. See porting/compare/README.md " \
                           "§ The rollback gap."]
                        end
result.each { |r| r["notes"] ||= [] }

gaps = result.reject { |r| r["exercised"] } + result.select { |r| !r["notes"].empty? && r["exercised"] }
report = {
  "audit_version" => 1,
  "source" => path,
  "cases" => records.length,
  "classes" => result,
  "gaps" => gaps.map { |r| r["class"] }.uniq,
  "passed" => result.all? { |r| r["exercised"] && r["notes"].empty? }
}

if options[:format] == "json"
  puts JSON.pretty_generate(report)
else
  puts "coverage audit: #{path} (#{records.length} observations)\n\n"
  result.each do |r|
    mark = r["exercised"] ? (r["notes"].empty? ? "ok  " : "PART") : "GAP "
    puts "  #{mark} #{r["class"].ljust(16)} #{r["cases"].length} case(s)"
    puts "       #{r["what"]}"
    r["notes"].each { |n| puts "       ! #{n}" }
  end
  puts "\n#{report["passed"] ? "COVERAGE COMPLETE" : "COVERAGE INCOMPLETE: #{report["gaps"].join(", ")}"}"
end

exit(report["passed"] ? 0 : 1)
