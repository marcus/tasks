#!/usr/bin/env ruby
# frozen_string_literal: true

# store-completion-diff — the differential harness for the store-completion
# packet: placement (`move`), the project lifecycle, the three delegation verbs
# that had no store operation, `id`, and the dated create.
#
# It is deliberately the same shape as lifecycle-diff, and for the same reason:
# every bug that mattered in Waves 1-3 was found by running the two binaries
# against byte-identical sandboxes and diffing what an observer can see —
# stdout, stderr, exit status, tasks.jsonl, archive.jsonl and the journal. Unit
# tests found none of them.
#
# Usage:  porting/compare/store-completion-diff [--verbose]

require "fileutils"
require "json"
require "open3"
require "tmpdir"

