#!/usr/bin/env ruby
# frozen_string_literal: true

# seed — write a deliberately-wrong copy of an observation set.
#
#   porting/compare/seed --list
#   porting/compare/seed --mismatch store-bytes IN_DIR OUT_DIR
#
# This is the Phase 1 gate's instrument. A conformance harness that has never
# been shown a mismatch is an untested assertion, so the gate stands up a
# *hypothetical Go implementation* by perturbing the Ruby baseline, and requires
# the comparator to report each perturbation.
#
# Every seed here is deliberately SUBTLE. A wholly different exit code, or a
# store rewritten beyond recognition, proves almost nothing: any comparator
# catches it. A real port defect is an off-by-one token, one reordered key, one
# omitted field — so those are what is seeded, each with a note saying which
# real Go failure mode it models.
#
# One seed, `json-key-order`, is a NEGATIVE control: it must produce no finding
# at all. Proving the comparator stays silent where the spec says to stay silent
# is as much a part of the gate as proving it speaks up elsewhere, because an
# over-strict comparator is the other way to make the harness useless.

require "base64"
require "digest"
require "json"
require "fileutils"
require "optparse"

require_relative "lib/normalize"

module Seed
  # Each seed: the case it lands in, the real port defect it models, and the
  # comparator field that must report it.
  CATALOG = {
    "exit-status" => {
      case_id: "cli-undo-after-capture",
      models: "a port that collapses `1` (error) and `2` (ref resolution failure) into 'nonzero'. " \
              "errors.md calls this the most important single assertion in the error surface: `2` exists so " \
              "an agent can refine a ref rather than abort, so collapsing them breaks every agent using the CLI " \
              "while passing any comparator that only checks 'both failed'.",
      expect: "cli / process.exit_status"
    },
    "json-output" => {
      case_id: "cli-list-json-small-gtd",
      models: "a port whose JSON encoder omits an empty collection instead of emitting `[]` — the single " \
              "commonest Go/Ruby serialization divergence (`omitempty`). errors.md: an omitted key and a null " \
              "key are different answers, and a key present on one side and absent on the other is a failure.",
      expect: "cli / process.stdout (json), reason key_only_in_baseline"
    },
    "json-key-order" => {
      case_id: "cli-list-json-small-gtd",
      negative_control: true,
      models: "a port whose JSON object keys come out in a different order on stdout. errors.md says stdout " \
              "JSON is compared as PARSED DATA, so this must NOT be reported — while the same reordering " \
              "inside the JSONL store (see store-bytes) must be.",
      expect: "no finding"
    },
    "store-bytes" => {
      case_id: "cli-capture-small-gtd",
      models: "a port that writes the store's record keys in a different order — Go map iteration order, or a " \
              "struct field order that does not match Ruby's canonical dump. The parsed records are IDENTICAL; " \
              "only the bytes differ. errors.md makes store bytes a byte-for-byte contract INCLUDING key order, " \
              "because the store is a durable format two implementations must round-trip and a merge driver, a " \
              "diff and a git history all see the bytes.",
      expect: "files / files.after[tasks.jsonl].sha256, plus the journal blob and index that snapshot it"
    },
    "revision-token" => {
      case_id: "cli-list-stale-revision",
      models: "a port whose revision hash differs in one character — a different field ordering inside the " \
              "digest input, or one field included that Ruby excludes. Every conditional write is validated " \
              "against this token, so a single wrong character is a lost-update bug for every HTTP client, and " \
              "nothing else in the observation moves.",
      expect: "revisions / revisions.resources[...]"
    },
    "rollback" => {
      case_id: "cli-capture-readonly-rollback",
      models: "the pair errors.md names as indistinguishable on the filesystem: 'failed post-write validation " \
              "(wrote, rolled back)' versus 'never wrote'. Same exit status, same empty deltas, same store " \
              "bytes — and here also byte-identical stderr, which is the case that used to be undetectable. " \
              "The candidate takes the other internal path and says so: rolled_back false, in the field and " \
              "in the --json error envelope it is read from. stderr is deliberately left untouched, so the " \
              "detection can only come from the label.",
      expect: "files / files.rolled_back, plus cli / process.stdout (json) for the envelope it came from"
    }
  }.freeze

  module_function

  def load_set(dir)
    Dir[File.join(dir, "*.json")].sort.to_h { |f| [File.basename(f, ".json"), JSON.parse(File.read(f))] }
  end

  def write_set(set, dir)
    FileUtils.mkdir_p(dir)
    set.each { |id, obs| File.write(File.join(dir, "#{id}.json"), "#{JSON.pretty_generate(obs)}\n") }
  end

  # --- stream surgery -------------------------------------------------------

  def stream_bytes(obs, which)
    Base64.decode64(obs.dig("process", which, "bytes_base64").to_s)
  end

  def set_stream(obs, which, bytes)
    s = obs["process"][which]
    s["sha256"] = Digest::SHA256.hexdigest(bytes)
    # Kept coherent with the bytes, through the comparator's own rewrite. A seed
    # that left a stale normalized digest behind would be a mismatch nobody
    # asked for — and, worse, would model a runner bug rather than the port
    # defect the seed is named for.
    if s.key?("sha256_normalized")
      spellings = Conformance::Normalize.copy_root_spellings(obs.dig("fixture", "copy_root"))
      s["sha256_normalized"] =
        Digest::SHA256.hexdigest(Conformance::Normalize.rewrite_copy_root_bytes(bytes, spellings))
    end
    s["size_bytes"] = bytes.bytesize
    text = bytes.dup.force_encoding(Encoding::UTF_8)
    s["valid_utf8"] = text.valid_encoding?
    s["bytes_base64"] = Base64.strict_encode64(bytes)
    s["text"] = s["valid_utf8"] ? text : nil
    obs
  end

  # --- file surgery ---------------------------------------------------------

  def file_named(obs, side, path)
    Array(obs.dig("files", side)).find { |f| f["path"] == path }
  end

  def store_file(obs, side)
    Array(obs.dig("files", side)).find { |f| f["role"] == "store" }
  end

  def set_file_bytes(entry, bytes)
    entry["sha256"] = Digest::SHA256.hexdigest(bytes)
    entry["size_bytes"] = bytes.bytesize
    entry["content_base64"] = Base64.strict_encode64(bytes)
    if entry["line_count"]
      entry["line_count"] = bytes.count("\n")
    end
    entry
  end

  # Swap two adjacent keys in one JSONL record, preserving everything else.
  # Ruby's Hash keeps insertion order and JSON.generate honours it, so this is a
  # pure reordering: identical parsed data, different bytes.
  def swap_adjacent_keys(line, index)
    record = JSON.parse(line)
    keys = record.keys
    raise "record has too few keys to swap at #{index}" if index + 1 >= keys.length

    keys[index], keys[index + 1] = keys[index + 1], keys[index]
    JSON.generate(keys.to_h { |k| [k, record[k]] })
  end

  # --- the seeds ------------------------------------------------------------

  def apply(name, set)
    send(:"seed_#{name.tr("-", "_")}", set)
  end

  def seed_exit_status(set)
    obs = set.fetch(CATALOG["exit-status"][:case_id])
    raise "expected the baseline to exit 1" unless obs["process"]["exit_status"] == 1

    obs["process"]["exit_status"] = 2
    set
  end

  def seed_json_output(set)
    obs = set.fetch(CATALOG["json-output"][:case_id])
    bytes = stream_bytes(obs, "stdout")
    rows = JSON.parse(bytes)
    raise "expected a JSON array on stdout" unless rows.is_a?(Array) && rows.first.key?("tags")
    raise "expected the first row's tags to be empty" unless rows.first["tags"] == []

    # `omitempty`: the key vanishes because the value was empty.
    rows.first.delete("tags")
    set_stream(obs, "stdout", "#{JSON.generate(rows)}\n")
    set
  end

  def seed_json_key_order(set)
    obs = set.fetch(CATALOG["json-key-order"][:case_id])
    bytes = stream_bytes(obs, "stdout")
    rows = JSON.parse(bytes)
    rows.each { |r| r.replace(r.to_a.reverse.to_h) }
    set_stream(obs, "stdout", "#{JSON.generate(rows)}\n")
    set
  end

  def seed_store_bytes(set)
    obs = set.fetch(CATALOG["store-bytes"][:case_id])
    entry = store_file(obs, "after") or raise "no store file in files.after"
    old_bytes = Base64.decode64(entry["content_base64"])
    old_sha = entry["sha256"]

    lines = old_bytes.split("\n", -1)
    trailing = lines.pop
    raise "store does not end with a newline" unless trailing == ""

    # The store's last record, with two adjacent keys transposed. Any record
    # would do; the last one is stable across fixture edits.
    lines[-1] = swap_adjacent_keys(lines[-1], 4)
    new_bytes = "#{lines.join("\n")}\n"
    raise "the swap changed the byte length; that is not the defect being modelled" unless
      new_bytes.bytesize == old_bytes.bytesize

    set_file_bytes(entry, new_bytes)
    new_sha = entry["sha256"]

    # A store the port wrote differently is also the store the port snapshotted
    # into the journal, so every derived digest moves with it. Modelling the
    # defect faithfully means moving all of them; leaving the journal alone
    # would produce an observation no implementation could ever emit.
    rewrite_digest_everywhere(obs, old_sha, new_sha, new_bytes)
    set
  end

  def rewrite_digest_everywhere(obs, old_sha, new_sha, new_bytes)
    %w[before after].each do |side|
      Array(obs.dig("files", side)).each do |f|
        f["path"] = f["path"].sub(old_sha, new_sha)
        next unless f["sha256"] == old_sha && f["role"] == "journal_blob"

        set_file_bytes(f, new_bytes)
      end
    end
    Array(obs.dig("files", "deltas")).each do |d|
      d["path"] = d["path"].sub(old_sha, new_sha)
      d["after_sha256"] = new_sha if d["after_sha256"] == old_sha
      d["before_sha256"] = new_sha if d["before_sha256"] == old_sha
    end
    Array(obs.dig("journal", "states")).each do |s|
      s["store_sha256"] = new_sha if s["store_sha256"] == old_sha
    end
    if obs.dig("journal", "blob_sha256")
      obs["journal"]["blob_sha256"] = obs["journal"]["blob_sha256"].map { |s| s == old_sha ? new_sha : s }.sort
    end
    index = obs.dig("journal", "index")
    return unless index && index["content_base64"]

    bytes = Base64.decode64(index["content_base64"]).gsub(old_sha, new_sha)
    set_file_bytes(index, bytes)
    entry = Array(obs.dig("files", "after")).find { |f| f["role"] == "journal_index" }
    set_file_bytes(entry, bytes) if entry
    delta = Array(obs.dig("files", "deltas")).find { |d| d["path"] == index["path"] }
    delta["after_sha256"] = index["sha256"] if delta
    obs
  end

  def seed_revision_token(set)
    obs = set.fetch(CATALOG["revision-token"][:case_id])
    resources = Array(obs.dig("revisions", "resources"))
    target = resources.find { |r| r["revision"] }
    raise "no resource carries a revision token" unless target

    token = target["revision"]
    last = token[-1]
    target["revision"] = token[0..-2] + (last == "0" ? "1" : "0")
    set
  end

  # A port that never wrote where Ruby wrote and reverted. Everything the
  # filesystem can see is identical — exit status, deltas, store bytes — and so
  # is stderr, on purpose: this seed exists to prove the LABEL detects what the
  # bytes cannot. The envelope on stdout moves with the field, because an
  # implementation that reported false in one and true in the other is not a
  # port anyone could write.
  def seed_rollback(set)
    obs = set.fetch(CATALOG["rollback"][:case_id])
    raise "the baseline case does not label a rollback" unless obs.dig("files", "rolled_back") == true

    obs["files"]["rolled_back"] = false
    bytes = stream_bytes(obs, "stdout").dup.force_encoding(Encoding::UTF_8)
    envelope = "\"rolled_back\":true"
    raise "the baseline case's stdout carries no rollback envelope" unless bytes.include?(envelope)

    set_stream(obs, "stdout", bytes.sub(envelope, "\"rolled_back\":false"))
    set
  end
end

options = { mismatch: nil }
parser = OptionParser.new do |o|
  o.banner = "usage: seed --mismatch NAME IN_DIR OUT_DIR"
  o.on("--mismatch NAME", "seed to apply (repeatable)") { |v| (options[:mismatch] ||= []) << v }
  o.on("--list", "print the catalog and exit") do
    puts JSON.pretty_generate(Seed::CATALOG)
    exit 0
  end
  o.on("-h", "--help") { puts o; exit 0 }
end
parser.parse!

names = options[:mismatch]
if names.nil? || names.empty? || ARGV.length != 2
  warn parser.help
  exit 2
end
unknown = names - Seed::CATALOG.keys
unless unknown.empty?
  warn "seed: unknown mismatch(es): #{unknown.join(", ")} (try --list)"
  exit 2
end

set = Seed.load_set(ARGV[0])
if set.empty?
  warn "seed: no observations in #{ARGV[0]}"
  exit 2
end
names.each { |n| Seed.apply(n, set) }
Seed.write_set(set, ARGV[1])
warn "seed: wrote #{set.size} observations to #{ARGV[1]} with #{names.join(", ")} applied"
