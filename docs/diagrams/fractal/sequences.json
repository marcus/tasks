      ]
    },
    {
      "id": "tui-agent-queue",
      "title": "A Queued Agent Request in the TUI",
      "description": "The prompt queue probes availability at submit, builds a fresh system context when the request starts, checks for completion each tick while a goroutine drains the transcript, and the list re-reads the store rather than trusting anything the TUI knows.",
      "provenance": "Authored 2026-09-11 from internal/tui/agentprompt.go (SubmitPrompt, PumpQueue, advanceQueue), internal/tui/term/agent/queue.go (Enqueue, StartNext, Pump), internal/tui/bootstrap.go (BuildAgentQueue, AgentFactory, AgentAvailability, the only caller of agentcontext.Build, llm.Build, llm.LoadConfig, runtimepath.TasksCLI in the TUI), internal/tui/agentadapter.go (Pump as a non-blocking Done check), internal/llm/agent.go (Start, drain, Cancel), and internal/tui/model.go (Refresh, Stale). Authored scenario, not a captured trace.",
      "status": "current",
      "participants": [
        {
          "id": "dev",
          "element": "developer",
          "title": "Developer"
        },
        {
          "id": "readmodel",
          "element": "application.readmodel",
          "title": "Read Model"
        },
        {
          "id": "runtime",
          "element": "tui.runtime",
          "title": "TUI Runtime"
        },
        {
          "id": "queue",
          "element": "tui.queue",
          "title": "Prompt Queue"
        },
        {
          "id": "context",
          "element": "agent.context",
          "title": "System Context"
        },
        {
          "id": "llm",
          "element": "agent.llm",
          "title": "Harness Contract"
        },
        {
          "id": "harness",
          "element": "external.harness",
          "title": "Harness Process"
        },
        {
          "id": "cli",
          "element": "cli.dispatch",
          "title": "Installed tasks CLI"
        },
        {
          "id": "files",
          "element": "external.taskfiles",
          "title": "tasks.jsonl"
        }
      ],
      "groups": [
        {
          "id": "tui-group",
          "title": "tasks-tui",
          "participants": [
            "runtime",
            "queue"
          ]
        },
        {
          "id": "agent-group",
          "title": "Agent Adapters",
          "participants": [
            "context",
            "llm"
          ]
        }
      ],
      "steps": [
        {
          "type": "phase",
          "id": "submit",
          "title": "1. Submit",
          "steps": [
            {
              "type": "message",
              "id": "type",
              "from": "dev",
              "to": "runtime",
              "title": "Type a prompt; Enter",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "enqueue",
              "from": "runtime",
              "to": "queue",
              "title": "Enqueue(text, current provider:model entry)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "probe",
              "from": "queue",
              "to": "llm",
              "title": "Availability probe: Build without a system context, then Available()",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "accepted",
              "from": "queue",
              "to": "runtime",
              "title": "Accepted (or refused: full queue / unavailable provider keeps the text)",
              "kind": "return"
            },
            {
              "type": "message",
              "id": "flash",
              "from": "runtime",
              "to": "dev",
              "title": "Flash: starting agent request #n, or queued behind the running one",
              "kind": "return"
            }
          ]
        },
        {
          "type": "phase",
          "id": "start",
          "title": "2. Start the next request",
          "steps": [
            {
              "type": "message",
              "id": "startnext",
              "from": "runtime",
              "to": "queue",
              "title": "StartNext (only when no adapter is running)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "factory-context",
              "from": "queue",
              "to": "context",
              "title": "Factory (bootstrap.go): agentcontext.Build fresh, so memory edits since the last request are picked up",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "factory-build",
              "from": "queue",
              "to": "llm",
              "title": "llm.Build(entry, {Root: data dir, System}) then adapter.Start(prompt, model)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "spawn",
              "from": "llm",
              "to": "harness",
              "title": "Start: spawn in its own process group; a goroutine drains captured output until exit",
              "kind": "async"
            }
          ]
        },
        {
          "type": "phase",
          "id": "pump",
          "title": "3. Pump each tick",
          "steps": [
            {
              "type": "message",
              "id": "tick",
              "from": "runtime",
              "to": "queue",
              "title": "PumpQueue on the timer tick",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "pump-output",
              "from": "queue",
              "to": "llm",
              "title": "adapter.Pump: non-blocking Done() check (no output pumping; the drain goroutine owns the transcript)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "agent-cli",
              "from": "harness",
              "to": "cli",
              "title": "The harness runs tasks verbs against the same store",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "cli-write",
              "from": "cli",
              "to": "files",
              "title": "Checked transaction installs new bytes",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "activity",
              "from": "runtime",
              "to": "dev",
              "title": "Agent activity view shows the live transcript",
              "kind": "async"
            },
            {
              "type": "message",
              "id": "finished",
              "from": "llm",
              "to": "queue",
              "title": "Process finished: succeeded, failed, or cancelled",
              "kind": "return"
            }
          ]
        },
        {
          "type": "phase",
          "id": "refresh",
          "title": "4. Re-read, never trust",
          "steps": [
            {
              "type": "message",
              "id": "record-result",
              "from": "queue",
              "to": "runtime",
              "title": "Finished snapshot; response pane opens",
              "kind": "return"
            },
            {
              "type": "message",
              "id": "refresh-read",
              "from": "runtime",
              "to": "readmodel",
              "title": "Refresh: ReadTasks (one fresh snapshot; Stale() also fires on any external write)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "rows",
              "from": "readmodel",
              "to": "runtime",
              "title": "Read model; rows rebuilt with selection preserved by id",
              "kind": "return"
            },
            {
              "type": "message",
              "id": "advance",
              "from": "runtime",
              "to": "queue",
              "title": "advanceQueue: start the next pending request, if any",
              "kind": "call"
            }
          ]
        }
      ]
    },
    {
      "id": "git-merge-driver",
      "title": "Git Merges Two Devices' Task Files",
      "description": "On a pull, Git hands the driver three stage files. The merge is built and validated entirely in memory; only a valid result replaces Git's copy, and a refusal leaves both sides fenced so nothing is silently discarded.",
      "provenance": "Authored 2026-09-11 from cmd/tasks/main.go (early dispatch), cmd/tasks/registry.go (earlyCommands), cmd/tasks/mergedriver.go, cmd/tasks/install_merge_driver.go, internal/merge/driver.go (RunDriver, writeConflict, appendLog), internal/merge/merge.go (Merge: Dump then CheckText), internal/merge/order.go, and docs/multi-device-sync.md. Authored scenario, not a captured trace.",
      "status": "current",
      "participants": [
        {
          "id": "dev",
          "element": "developer",
          "title": "Developer"
        },
        {
          "id": "git",
          "element": "external.git",
          "title": "Git"
        },
        {
          "id": "dispatch",
          "element": "cli.dispatch",
          "title": "Registry & Dispatch"
        },
        {
          "id": "maintenance",
          "element": "cli.mergedriver",
          "title": "merge-driver Command"
        },
        {
          "id": "merge",
          "element": "store.merge",
          "title": "Merge Driver"
        },
        {
          "id": "record",
          "element": "store.record",
          "title": "Canonical Records"
        },
        {
          "id": "revision",
          "element": "store.revision",
          "title": "Update Stamps"
        },
        {
          "id": "check",
          "element": "store.check",
          "title": "Invariant Checker"
        },
        {
          "id": "atomic",
          "element": "store.atomic",
          "title": "Atomic Replace"
        }
      ],
      "groups": [
        {
          "id": "cli-group",
          "title": "tasks CLI (plumbing)",
          "participants": [
            "dispatch",
            "maintenance"
          ]
        },
        {
          "id": "merge-group",
          "title": "Persistence & Invariants",
          "participants": [
            "merge",
            "record",
            "revision",
            "check",
            "atomic"
          ]
        }
      ],
      "steps": [
        {
          "type": "phase",
          "id": "setup",
          "title": "1. One-time setup",
          "steps": [
            {
              "type": "message",
              "id": "install",
              "from": "dev",
              "to": "dispatch",
              "title": "tasks install-merge-driver (in the data repository)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "configure",
              "from": "maintenance",
              "to": "git",
              "title": "Verify .gitattributes selects merge=tasksjsonl; git config merge.tasksjsonl.name and .driver = \"<tasks> merge-driver %O %A %B %P %L %X %Y\"",
              "kind": "call"
            }
          ]
        },
        {
          "type": "phase",
          "id": "invoke",
          "title": "2. Git invokes the driver",
          "steps": [
            {
              "type": "message",
              "id": "pull",
              "from": "dev",
              "to": "git",
              "title": "git pull (both devices edited tasks.jsonl)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "driver",
              "from": "git",
              "to": "dispatch",
              "title": "tasks merge-driver %O %A %B %P %L %X %Y with three temp stage files (4 to 7 args; wrong arity exits 2)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "early",
              "from": "dispatch",
              "to": "maintenance",
              "title": "Early dispatch with a nil surface context: no configured store is resolved",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "run",
              "from": "maintenance",
              "to": "merge",
              "title": "RunDriver(args, stdout, stderr, TASKS_MERGE_VERBOSE)",
              "kind": "call"
            }
          ]
        },
        {
          "type": "phase",
          "id": "merge-phase",
          "title": "3. Merge and validate in memory",
          "steps": [
            {
              "type": "message",
              "id": "read",
              "from": "merge",
              "to": "record",
              "title": "Read and parse base, ours, theirs (UTF-8, schema v2 on both sides)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "align",
              "from": "merge",
              "to": "merge",
              "title": "Align records by stable id; combine independent fields; union tags; prefer progressed states",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "stamps",
              "from": "merge",
              "to": "revision",
              "title": "Same-field conflict: compare updated stamps (instant#device), newer wins",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "order",
              "from": "merge",
              "to": "merge",
              "title": "Ours-first ordering, then a DFS walk guaranteeing parent-before-child",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "emit",
              "from": "merge",
              "to": "record",
              "title": "Dump the merged record set to canonical text",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "validate",
              "from": "merge",
              "to": "check",
              "title": "CheckText over the dumped text (ids, parents, DFS pre-order, vocabularies); only a passing result carries text",
              "kind": "call"
            }
          ]
        },
        {
          "type": "phase",
          "id": "outcome",
          "title": "4. Replace or refuse",
          "steps": [
            {
              "type": "message",
              "id": "install-result",
              "from": "merge",
              "to": "atomic",
              "title": "Valid: atomic.Write(ours stage, merged text); append the decision to .tasks-merge.log; exit 0",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "refuse",
              "from": "merge",
              "to": "merge",
              "title": "Invalid: os.WriteFile ours in place with both sides inside conflict markers (deliberately not atomic); log; exit 1",
              "kind": "call",
              "description": "Refusal path. The path stays UU, tasks check fails on the marker lines, and neither side has been summarized or dropped."
            },
            {
              "type": "message",
              "id": "back-to-git",
              "from": "maintenance",
              "to": "git",
              "title": "Exit status; Git copies the ours stage back over the working file either way",
              "kind": "return"
            },
            {
              "type": "message",
              "id": "report",
              "from": "git",
              "to": "dev",
              "title": "Merged cleanly, or a conflict to resolve through the CLI",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
