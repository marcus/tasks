{
  "version": 1,
  "journeys": [
    {
      "id": "cli-mutation",
      "title": "A CLI Mutation, End to End",
      "description": "tasks done <ref>: from argv through the store transaction to a journaled, validated, atomically installed file. The rollback message shows the failure path the same transaction takes.",
      "provenance": "Authored 2026-09-11 from cmd/tasks/main.go, cmd/tasks/priority.go (done, changeState, patchAndReport), cmd/tasks/mutcli.go (patchBaseline), cmd/tasks/done.go (resolveRef), cmd/tasks/list.go (ReadSnapshot), internal/store/patch.go (PatchTask, Patch), internal/store/mutation.go (commit, writeRecords, restore), internal/atomic/atomic.go, internal/check/check.go, and internal/journal/write.go (Record). Authored scenario, not a captured trace.",
      "status": "current",
      "participants": [
        {
          "id": "dev",
          "element": "developer",
          "title": "Developer"
        },
        {
          "id": "dispatch",
          "element": "cli.dispatch",
          "title": "Registry & Dispatch"
        },
        {
          "id": "mutate",
          "element": "cli.mutate",
          "title": "Mutation Command"
        },
        {
          "id": "snapshot",
          "element": "store.snapshot",
          "title": "Snapshot"
        },
        {
          "id": "core",
          "element": "store.core",
          "title": "Store Transaction"
        },
        {
          "id": "lock",
          "element": "store.lock",
          "title": "Store Lock"
        },
        {
          "id": "record",
          "element": "store.record",
          "title": "Canonical Records"
        },
        {
          "id": "atomic",
          "element": "store.atomic",
          "title": "Atomic Replace"
        },
        {
          "id": "check",
          "element": "store.check",
          "title": "Invariant Checker"
        },
        {
          "id": "journal",
          "element": "store.journal",
          "title": "Journal"
        },
        {
          "id": "files",
          "element": "external.taskfiles",
          "title": "tasks.jsonl"
        }
      ],
      "groups": [
        {
          "id": "cli-group",
          "title": "tasks CLI",
          "participants": [
            "dispatch",
            "mutate"
          ]
        },
        {
          "id": "store-group",
          "title": "Persistence & Invariants",
          "participants": [
            "snapshot",
            "core",
            "lock",
            "record",
            "atomic",
            "check",
            "journal"
          ]
        }
      ],
      "steps": [
        {
          "type": "phase",
          "id": "parse",
          "title": "1. Parse and resolve",
          "description": "Configuration is resolved before any store is touched; the ref must resolve to exactly one open task or the command exits 2.",
          "steps": [
            {
              "type": "message",
              "id": "invoke",
              "from": "dev",
              "to": "dispatch",
              "title": "tasks done \"<ref>\"",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "resolve-config",
              "from": "dispatch",
              "to": "mutate",
              "title": "Resolve config; refuse if unconfigured; dispatch done",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "read-snapshot",
              "from": "mutate",
              "to": "snapshot",
              "title": "ReadSnapshot(true) under the shared lock; build queries",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "snapshot-back",
              "from": "snapshot",
              "to": "mutate",
              "title": "Immutable snapshot",
              "kind": "return"
            },
            {
              "type": "message",
              "id": "resolve-ref",
              "from": "mutate",
              "to": "mutate",
              "title": "resolveRef: L<line>, exact id, then title substring; exit 2 on no or many matches",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "baseline",
              "from": "mutate",
              "to": "core",
              "title": "patchBaseline: ExpectedFor(id, state) under its own shared lock, before the write takes its lock",
              "kind": "call"
            }
          ]
        },
        {
          "type": "phase",
          "id": "transaction",
          "title": "2. One checked transaction",
          "description": "Patch(PatchRequest{state: DONE, expected: baseline}). Everything below runs while the exclusive lock is held.",
          "steps": [
            {
              "type": "message",
              "id": "patch",
              "from": "mutate",
              "to": "core",
              "title": "PatchTask(id, state, DONE, expected, label, today) wraps Patch(PatchRequest{...})",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "lock-ex",
              "from": "core",
              "to": "lock",
              "title": "withLock: flock LOCK_EX on .tasks.jsonl.lock (5s wait, then refuse with holder pid)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "before",
              "from": "core",
              "to": "files",
              "title": "fileSnapshot: raw bytes of live and archive (the rollback target)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "preflight",
              "from": "core",
              "to": "check",
              "title": "Schema gate and preflight CheckWith(org)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "reread",
              "from": "core",
              "to": "record",
              "title": "freshRecords: re-read and parse under the lock",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "conflict",
              "from": "core",
              "to": "core",
              "title": "Compare field baseline; MutationConflict if it moved",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "apply",
              "from": "core",
              "to": "core",
              "title": "Apply DONE on a detached clone: closed date, defer tag dropped, recurrence rolled if repeating",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "emit",
              "from": "core",
              "to": "record",
              "title": "Dump: canonical key order, absent fields omitted (serialize before writing)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "stamp",
              "from": "core",
              "to": "core",
              "title": "stampChangedTasks: one shared updated stamp for semantically changed tasks",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "write",
              "from": "core",
              "to": "atomic",
              "title": "atomic.Write(org, text)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "install",
              "from": "atomic",
              "to": "files",
              "title": "Sibling temp, fsync, copy mode, rename over resolved target, fsync dir",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "postcheck",
              "from": "core",
              "to": "check",
              "title": "postWriteFailure: CheckWith on the installed bytes (live and archive)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "rollback",
              "from": "core",
              "to": "atomic",
              "title": "On any failure: restore(before) reinstalls both files; result RolledBack with stage write or validation",
              "kind": "call",
              "description": "Failure path. Validation runs before the journal entry, so a rolled-back write leaves no history step pointing at bytes that never survived."
            },
            {
              "type": "message",
              "id": "journal-record",
              "from": "core",
              "to": "journal",
              "title": "journal.Record(label, before, after, coalesceKey, repair=false)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "journal-persist",
              "from": "journal",
              "to": "journal",
              "title": "Intern blobs by sha, advance cursor, persist index.json, garbage-collect beyond the undo limit",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "reload",
              "from": "core",
              "to": "record",
              "title": "readAfterWrite: snapshot and store revision under the same lock",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "unlock",
              "from": "core",
              "to": "lock",
              "title": "Release flock",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "result",
              "from": "core",
              "to": "mutate",
              "title": "MutationResult{OK, ReadSnapshot, StoreRevision, TouchedIDs}",
              "kind": "return"
            }
          ]
        },
        {
          "type": "phase",
          "id": "report",
          "title": "3. Report",
          "steps": [
            {
              "type": "message",
              "id": "render",
              "from": "mutate",
              "to": "dev",
              "title": "Headline from the post-write snapshot, or --json document; exit 0",
              "kind": "return"
            }
          ]
        }
      ]
    },
    {
      "id": "http-conditional-write",
      "title": "An HTTP Conditional Write Refused as Stale",
      "description": "PATCH /api/v1/tasks/{id} with an If-Match that no longer matches: the loopback gates pass, the precondition is present, but the store compares revisions under its lock and the adapter answers 412 with the current resource and a fresh ETag.",
      "provenance": "Authored 2026-09-11 from cmd/tasks-api/main.go, internal/api/server.go (enforceHost, enforceOrigin, dispatch), internal/api/request.go (ifMatch, jsonBody), internal/api/write.go (updateTask, ensureStoreReady, staleRefusal), internal/api/read.go (readFailure), internal/api/seams.go, internal/store/changeset.go (ApplyChangeset, changesetRevisionError), internal/store/revision.go (taskRevision), and docs/api/openapi.yaml. Authored scenario, not a captured trace.",
      "status": "current",
      "participants": [
        {
          "id": "client",
          "element": "external.http_client",
          "title": "Loopback Client"
        },
        {
          "id": "gates",
          "element": "api.gates",
          "title": "Transport Gates"
        },
        {
          "id": "routes",
          "element": "api.routes",
          "title": "Routes"
        },
        {
          "id": "precondition",
          "element": "api.precondition",
          "title": "If-Match"
        },
        {
          "id": "seams",
          "element": "api.seams",
          "title": "Reader / Changesets"
        },
        {
          "id": "snapshot",
          "element": "store.snapshot",
          "title": "Checked Read"
        },
        {
          "id": "core",
          "element": "store.core",
          "title": "Store Transaction"
        },
        {
          "id": "lock",
          "element": "store.lock",
          "title": "Store Lock"
        },
        {
          "id": "revision",
          "element": "store.revision",
          "title": "Revisions"
        }
      ],
      "groups": [
        {
          "id": "api-group",
          "title": "tasks-api",
          "participants": [
            "gates",
            "routes",
            "precondition",
            "seams"
          ]
        },
        {
          "id": "store-group",
          "title": "Persistence & Invariants",
          "participants": [
            "snapshot",
            "core",
            "lock",
            "revision"
          ]
        }
      ],
      "steps": [
        {
          "type": "phase",
          "id": "gate",
          "title": "1. Loopback gates",
          "steps": [
            {
              "type": "message",
              "id": "request",
              "from": "client",
              "to": "gates",
              "title": "PATCH /api/v1/tasks/{id} · If-Match: \"<revision read earlier>\" · application/json body",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "host",
              "from": "gates",
              "to": "gates",
              "title": "enforceHost: Host must be 127.0.0.1:port or localhost:port; any Forwarded header is 400",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "origin",
              "from": "gates",
              "to": "gates",
              "title": "enforceOrigin: a browser Origin on a mutating method must name this server, else 403",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "dispatch",
              "from": "gates",
              "to": "routes",
              "title": "dispatch: task path matches, id must be 8 hex",
              "kind": "call"
            }
          ]
        },
        {
          "type": "phase",
          "id": "precondition-phase",
          "title": "2. Precondition and body",
          "steps": [
            {
              "type": "message",
              "id": "ifmatch",
              "from": "routes",
              "to": "precondition",
              "title": "ifMatch: missing is 428 missing_precondition; unquoted or malformed is 422",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "expected",
              "from": "precondition",
              "to": "routes",
              "title": "Expected revision token",
              "kind": "return"
            },
            {
              "type": "message",
              "id": "body",
              "from": "routes",
              "to": "routes",
              "title": "jsonBody: 64 KiB limit, application/json only, unknown fields refused, at least one change",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "read",
              "from": "routes",
              "to": "seams",
              "title": "Read(): a checked read for validation (ensureStoreReady and staleRefusal each read again; every read builds a fresh store)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "checked",
              "from": "seams",
              "to": "snapshot",
              "title": "CheckedReadSnapshot: status, snapshot, global store revision",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "checked-back",
              "from": "snapshot",
              "to": "routes",
              "title": "Queries + revision (503 store_invalid, unsupported_schema, or unavailable; never 409 on the read path)",
              "kind": "return"
            },
            {
              "type": "message",
              "id": "validate",
              "from": "routes",
              "to": "routes",
              "title": "validatePatchBody and patchChanges: typed changes in field order",
              "kind": "call"
            }
          ]
        },
        {
          "type": "phase",
          "id": "apply",
          "title": "3. Guarded changeset under the lock",
          "steps": [
            {
              "type": "message",
              "id": "changeset",
              "from": "routes",
              "to": "seams",
              "title": "ApplyChangeset{ID, Changes, ExpectedRevision: expected}",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "store-apply",
              "from": "seams",
              "to": "core",
              "title": "store.ApplyChangeset on a fresh per-request store",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "lock-ex",
              "from": "core",
              "to": "lock",
              "title": "withLock LOCK_EX; strict preflight check; re-read records",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "compare",
              "from": "core",
              "to": "revision",
              "title": "taskRevision v1.<own>.<location>.<lifecycle> vs ExpectedRevision: own always; location and lifecycle only when the change touches them",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "mismatch",
              "from": "revision",
              "to": "core",
              "title": "Mismatch: another writer changed this task since the client read it",
              "kind": "return"
            },
            {
              "type": "message",
              "id": "stale",
              "from": "core",
              "to": "seams",
              "title": "MutationResult{Status: stale}; nothing written, lock released",
              "kind": "return"
            }
          ]
        },
        {
          "type": "phase",
          "id": "refuse",
          "title": "4. Refuse with fresh state",
          "steps": [
            {
              "type": "message",
              "id": "stale-refusal",
              "from": "routes",
              "to": "precondition",
              "title": "staleRefusal(id): re-read the current resource",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "current",
              "from": "precondition",
              "to": "seams",
              "title": "Read(): current task and its revision",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "response",
              "from": "routes",
              "to": "client",
              "title": "412 stale_revision · details.current = canonical task · ETag: \"<fresh revision>\" · x-request-id",
              "kind": "return",
              "description": "The client can decide again without a second round trip. A matching If-Match would instead have produced 200 with the updated resource and its new ETag."
            }
          ]
        }
      ]
    },
    {
      "id": "agent-prompt",
      "title": "An Agent-Driven Change via tasks -p",
      "description": "tasks -p hands a request to a configured harness with the embedded list-agent contract. The harness acts through the installed tasks CLI, never a private path, and the developer sees the resulting git diff.",
      "provenance": "Authored 2026-09-11 from cmd/tasks/prompt.go, internal/agentcontext/agentcontext.go, internal/promptfacts/promptfacts.go, internal/runtimepath/runtimepath.go, internal/llm/agent.go (Build, Available, RunSync), internal/llm/registry.go (DefaultEntry), internal/agentdiff/agentdiff.go (Compute), and internal/agentcontext/TASK_AGENT.md. The harness's internal tool loop is summarized as one message pair. Authored scenario, not a captured trace.",
      "status": "current",
      "participants": [
        {
          "id": "dev",
          "element": "developer",
          "title": "Developer"
        },
        {
          "id": "prompt",
          "element": "cli.prompt",
          "title": "tasks -p"
        },
        {
          "id": "context",
          "element": "agent.context",
          "title": "System Context"
        },
        {
          "id": "llm",
          "element": "agent.llm",
          "title": "Harness Contract"
        },
        {
          "id": "harness",
          "element": "external.harness",
          "title": "Harness Process"
        },
        {
          "id": "provider",
          "element": "external.provider",
          "title": "LLM Provider"
        },
        {
          "id": "cli",
          "element": "cli.dispatch",
          "title": "Installed tasks CLI"
        },
        {
          "id": "core",
          "element": "store.core",
          "title": "Store Transaction"
        },
        {
          "id": "git",
          "element": "external.git",
          "title": "Git"
        }
      ],
      "groups": [
        {
          "id": "agent-group",
          "title": "Agent Adapters",
          "participants": [
            "context",
            "llm"
          ]
        },
        {
          "id": "outside",
          "title": "Outside the Tasks binary",
          "participants": [
            "harness",
            "provider"
          ]
        }
      ],
      "steps": [
        {
          "type": "phase",
          "id": "assemble",
          "title": "1. Assemble the context before spawning",
          "steps": [
            {
              "type": "message",
              "id": "invoke",
              "from": "dev",
              "to": "prompt",
              "title": "tasks -p [--provider NAME] [--model NAME] \"move the dentist task to next week\"",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "gates",
              "from": "prompt",
              "to": "prompt",
              "title": "Schema gate; leading --json refused (the result is a transcript, not a document)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "build-context",
              "from": "prompt",
              "to": "context",
              "title": "Build(paths, runtimepath.TasksCLI(), sources)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "context-parts",
              "from": "context",
              "to": "context",
              "title": "Embedded TASK_AGENT.md + Current environment facts + absolute CLI/task/memory paths + memory policy pointer + agent-memory.md (fresh, 16 KiB budget)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "context-back",
              "from": "context",
              "to": "prompt",
              "title": "System context string (or an error naming an oversize/unreadable memory file)",
              "kind": "return"
            },
            {
              "type": "message",
              "id": "resolve-entry",
              "from": "prompt",
              "to": "llm",
              "title": "LoadConfig, DefaultEntry(provider, model, conf), Build(entry, {Root: data dir, System})",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "available",
              "from": "llm",
              "to": "llm",
              "title": "Available(): binary on PATH and harness Reachable()",
              "kind": "call"
            }
          ]
        },
        {
          "type": "phase",
          "id": "run",
          "title": "2. The harness acts through the CLI",
          "steps": [
            {
              "type": "message",
              "id": "runsync",
              "from": "prompt",
              "to": "llm",
              "title": "RunSync(request, model, stream=false)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "spawn",
              "from": "llm",
              "to": "harness",
              "title": "exec harness argv with the system context, cwd = data directory, inherited stdio",
              "kind": "async"
            },
            {
              "type": "message",
              "id": "model-call",
              "from": "harness",
              "to": "provider",
              "title": "Model requests (the harness's own loop)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "model-back",
              "from": "provider",
              "to": "harness",
              "title": "Tool calls and text",
              "kind": "return"
            },
            {
              "type": "message",
              "id": "agent-list",
              "from": "harness",
              "to": "cli",
              "title": "tasks list --json / tasks show <id> --json (read to find the stable id)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "agent-mutate",
              "from": "harness",
              "to": "cli",
              "title": "tasks defer <id> <date> (the contract forbids hand-editing tasks.jsonl)",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "cli-store",
              "from": "cli",
              "to": "core",
              "title": "Same checked transaction as a human command: lock, re-read, apply, validate, journal",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "cli-back",
              "from": "cli",
              "to": "harness",
              "title": "Headline or JSON result; exit code 0, 1, or 2",
              "kind": "return"
            },
            {
              "type": "message",
              "id": "transcript",
              "from": "harness",
              "to": "dev",
              "title": "Transcript streams straight to the terminal",
              "kind": "async"
            },
            {
              "type": "message",
              "id": "exit",
              "from": "harness",
              "to": "llm",
              "title": "Process exit (non-zero is reported, not fatal)",
              "kind": "return"
            }
          ]
        },
        {
          "type": "phase",
          "id": "show-diff",
          "title": "3. Show what changed",
          "steps": [
            {
              "type": "message",
              "id": "compute-diff",
              "from": "prompt",
              "to": "prompt",
              "title": "agentdiff.Compute{DataDir, Org, Archive, Memory}: pick the files to diff; flag a relocated memory file",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "git-diff",
              "from": "prompt",
              "to": "git",
              "title": "git -C <data dir> --no-pager diff -- <absolute task files> [memory]; untracked files via diff --no-index /dev/null",
              "kind": "call"
            },
            {
              "type": "message",
              "id": "diff-back",
              "from": "git",
              "to": "prompt",
              "title": "Diff text (a relocated memory sidecar is flagged with a notice)",
              "kind": "return"
            },
            {
              "type": "message",
              "id": "done",
              "from": "prompt",
