#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "shellwords"

ROOT = File.expand_path("..", __dir__)
TASKS_BIN = File.join(ROOT, "bin", "tasks")

def git_config(repo, key, value)
  _stdout, stderr, status = Open3.capture3("git", "-C", repo, "config", key, value)
  abort "git config #{key} failed: #{stderr.strip}" unless status.success?
end

repo = ARGV.shift
abort "usage: bin/install-merge-driver [task-data-repo]" unless ARGV.empty?

unless repo
  require_relative "../lib/tasks/config"
  paths = Tasks::Config.resolve(default_dir: ROOT)
  repo = File.dirname(paths.org)
end
repo = File.expand_path(repo)

_top, stderr, status = Open3.capture3("git", "-C", repo, "rev-parse", "--show-toplevel")
abort "not a git repository: #{repo}#{stderr.empty? ? "" : " (#{stderr.strip})"}" unless status.success?

attributes = File.join(repo, ".gitattributes")
attribute_text = File.file?(attributes) ? File.read(attributes, encoding: "UTF-8") : ""
missing = %w[tasks.jsonl archive.jsonl].reject do |pathname|
  attribute_text.match?(/^\s*#{Regexp.escape(pathname)}\s+merge=tasksjsonl(?:\s|$)/)
end
unless missing.empty?
  abort "#{attributes} must select merge=tasksjsonl for both tasks.jsonl and archive.jsonl " \
        "(missing: #{missing.join(", ")})"
end

# %L (conflict-marker size) and %X/%Y (the ours/theirs conflict labels) are only
# read when the driver REFUSES, to write the markers Git would have written
# itself. Measured on Git 2.50: `merge` gives "HEAD"/"<branch>", `rebase` and
# `cherry-pick` give "HEAD"/"<sha> (<subject>)", `checkout -m` gives
# "ours"/"theirs" — never empty in any of them.
#
# They are deliberately NOT quoted here. Git substitutes into a string it hands
# to the shell, and it already quotes these itself wherever the value can
# contain spaces (the rebase/cherry-pick subject form arrives as `'a1b2c3
# (subject)'`). Adding our own quotes produces `''a1b2c3 (subject)''`, which is
# a shell syntax error — the driver then never runs at all and Git falls back to
# its own text merge, silently bypassing this driver on every rebase.
#
# An install predating this line leaves the four-argument command in that
# repository's config; the driver treats all three as optional and falls back to
# marker size 7 and the labels "ours"/"theirs", so an old install keeps working
# and re-running this installer is the whole upgrade.
driver = "#{Shellwords.escape(TASKS_BIN)} merge-driver %O %A %B %P %L %X %Y"
git_config(repo, "merge.tasksjsonl.name", "tasks jsonl 3-way record merge")
git_config(repo, "merge.tasksjsonl.driver", driver)

puts "installed tasksjsonl merge driver in #{repo}"
puts "  #{driver}"
