#!/usr/bin/env ruby
# frozen_string_literal: true

# tasks — a tiny CLI over tasks.jsonl
#
# Usage (each command has a single-letter alias):
#   bin/tasks agenda|a        show items with SCHEDULED/DEADLINE, soonest first
#   bin/tasks next|n          list NEXT actions grouped by context
#   bin/tasks quadrants|q     Covey 2x2 from priority+deadline (or important/urgent tags)
#   bin/tasks inbox|i         show unprocessed INBOX items
#   bin/tasks projects|pj     list projects & areas rolled up over open tasks
#   bin/tasks project create|show|complete|archive|rename <title|ref>  make/read/
#                             mutate one project (create makes an empty project
#                             section; complete aka done; archive --force past open)
#   bin/tasks capture|c "..." append a new item (flags: --due/--scheduled/
#                             --priority/--tag/--context/--no-host-context/
#                             --state/--project/--under/--note)
#   bin/tasks propose "..."   suggest an inert task for approval
#   bin/tasks approve <ref>   accept a PROPOSED task into INBOX
#   bin/tasks reject <ref> [--note "..."]  decline PROPOSED → CANCELLED
#   bin/tasks delegate <ref> refine|research|implement   hand to the agent pool
#   bin/tasks delegate <ref> --to <email> [--keep-state] hand to a person (WAITING)
#   bin/tasks undelegate <ref>            clear the marker / revoke a claim
#   bin/tasks workref <ref> <url|off>     record where the work lives
#   bin/tasks claim <ref> --worker <id>   atomically pick up agent-ready work
#   bin/tasks release <ref> --worker <id> [--note "..."] [--force]  hand it back
#   bin/tasks done|d <ref>    mark a matching open item DONE (complete/close);
#                             cascades to its open descendants (recurring parent
#                             rolls forward instead and does not cascade)
#   bin/tasks due <ref> <date-or-date-time>       set/replace an item's DEADLINE
#   bin/tasks schedule <ref> <date-or-date-time>  set/replace Available from (SCHEDULED)
#   bin/tasks undate <ref> [--kind deadline|scheduled]  remove date stamp(s)
#   bin/tasks state <ref> <STATE>    transition an item to any state
#   bin/tasks cancel|drop <ref> [--note "..."]  mark CANCELLED (+ optional reason)
#   bin/tasks priority <ref> <A|B|C|none>  set/clear priority (incl. PROPOSED)
#   bin/tasks retitle <ref> "new title"    replace title (incl. PROPOSED)
#   bin/tasks tag <ref> +t -t @ctx -@ctx   edit tags/contexts (incl. PROPOSED)
#   bin/tasks note <ref> "text"            append a body line (incl. PROPOSED)
#   bin/tasks move <ref> ("Section"|--under <ref>|--top)  relocate/nest/unnest a subtree
#   bin/tasks move <ref> ["Section"|--under <ref>] --before <ref>  place before a sibling
#   bin/tasks delete <ref>   hard-delete a task (needs --cascade if it has
#                             subtasks); undoable — usually prefer cancel/archive
#   bin/tasks recur <ref> <schedule|off>   repeat on done (weekly, 2w, .+1m,
#                             every mon,wed, m:15, last friday; off clears).
#                             No schedule: preview the next occurrences.
#                             --explain "<schedule>" previews without a task
#   bin/tasks lead <ref> <span|off>        hide until a span before its date
#                             (3w, 2d, 1m, "a week"; off clears). No span:
#                             show the window and when it opens.
#   bin/tasks defer|snooze <ref> [date]    defer until a date, or hold indefinitely
#   bin/tasks someday <ref>                hold indefinitely (someday/maybe)
#   bin/tasks activate <ref>               make available now (undefer/resume)
#   bin/tasks show|s <ref>    show one task in full (headline + notes)
#   bin/tasks archive|x       move DONE/CANCELLED items to archive.jsonl
#   bin/tasks list|l [...]    list tasks grouped by state, with filters:
#     scope:   --open/-o (default) --proposed --done/-d --archived/-x --all/-a
#     filters: @context /text +tag -A|-B|-C --deferred/-D --unavailable
#              --someday/--on-hold --delegated --agent-ready
#              (compose freely except as documented)
#   bin/tasks -p "..."        hand a natural-language request to an LLM agent
#                             (Claude or another configured harness), which acts
#                             on your tasks and reports what changed
#   bin/tasks config          show where tasks.jsonl/archive.jsonl and the
#                             agent-memory.md sidecar resolve, and why
#   bin/tasks merge-driver <base> <ours> <theirs> <path>  internal Git plumbing
#   bin/tasks help|-h         full command reference
#
# Shared domain code uses TZInfo for named-zone and DST-safe time resolution.
# Rack/Puma/OpenAPI remain isolated to bin/tasks-api. Reads one JSON record/line.
# Task files default to the repo root; point them elsewhere with TASKS_DIR
# (or TASKS_FILE/TASKS_ARCHIVE) env vars or ~/.config/tasks/config.

require "date"
require "shellwords"

ROOT    = File.expand_path("..", __dir__)

# Git invokes this plumbing command with temporary merge-stage paths. Dispatch
# before resolving a configured task store so the driver depends only on the
# three explicit files Git supplied.
if ARGV.first == "merge-driver"
  require_relative "../lib/tasks/merge_driver_command"
  exit Tasks::MergeDriverCommand.run(ARGV.drop(1))
end

# Task files are configurable (env vars, ~/.config/tasks/config) so the data
# can live outside this repo. See lib/tasks/config.rb for precedence.
require_relative "../lib/tasks/config"
require_relative "../lib/tasks/dates"
PATHS   = Tasks::Config.resolve(default_dir: ROOT)
ORG     = PATHS.org
ARCHIVE = PATHS.archive
Tasks::Dates.configure!(date_order: PATHS.date_order)

# The model layer owns parsing and every mutation; the CLI adds dispatch,
# ref resolution, and output. (Tasks::Item, Tasks::Format etc. live there.)
require_relative "../lib/tasks/store"
require_relative "../lib/tasks/application"
require_relative "../lib/tasks/opener"
require_relative "../lib/tasks/timezones"

def contexts(item) = item.tags.select { |t| t.start_with?("@") }
def open?(item)     = OPEN_STATES.include?(item.state)

OPEN_STATES = Tasks::Store::OPEN_STATES
PROPOSED_STATES = Tasks::Store::PROPOSED_STATES
CLOSED_STATES = Tasks::Store::CLOSED_STATES
ALL_STATES = Tasks::Store::STATES
DONE_STATES = CLOSED_STATES

def color(str, code) = $stdout.tty? ? "\e[#{code}m#{str}\e[0m" : str
def bold(s)   = color(s, 1)
def dim(s)    = color(s, 90)
def red(s)    = color(s, 31)
def yellow(s) = color(s, 33)
def cyan(s)   = color(s, 36)

# Color a deadline by how close it is: red = overdue/today, yellow = next 2 days,
# cyan = this week, dim = further out.
def due_color(days)
  if    days <= 0 then 31
  elsif days <= 2 then 33
  elsif days <= 7 then 36
  else                 90
  end
end

# Short, colored date tag for `next`/`list`, e.g. "7/1" (no leading zeros).
# Prefers the DEADLINE; falls back to the SCHEDULED start date, marked with a
# leading "~" to distinguish "start" from "due". Empty when the item has
# neither. Colored by proximity (see due_color).
def short_due(item, today: Date.today, context: nil)
  date = item.deadline || item.scheduled
  return "" unless date
  days  = (date - today).to_i
  label = "#{date.month}/#{date.day}"
  value = item.deadline_value || item.scheduled_value
  if value&.local_time
    context ||= temporal_context
    projected = value.projected(context)
    hour, minute = projected.fetch(:local).split(":").map(&:to_i)
    time = if PATHS.time_format == 24
             format("%02d:%02d", hour, minute)
           else
             format("%d:%02d%s", (hour % 12).zero? ? 12 : hour % 12, minute, hour < 12 ? "a" : "p")
           end
    label = "#{projected.fetch(:date).month}/#{projected.fetch(:date).day} #{time}"
    label << " #{value.timezone}" if value.fixed? && value.timezone != context.timezone_id
  end
  label = "~#{label}" unless item.deadline # scheduled = soft start date
  color(label, due_color(days))
end

def fmt(item)
  pri = item.priority ? "[#{item.priority}] " : ""
  ctx = contexts(item)
  tag = ctx.empty? ? "" : dim("  #{ctx.join(" ")}")
  "#{pri}#{item.title}#{tag}"
end

# Emit items as the standard JSON array (docs/cli-spec.md) and return true
# when --json was requested; read commands call this first.
def emit_json?(items, args, extra: nil, result: nil)
  return false unless args.include?("--json")
  require "json"
  rows = items.map do |i|
    h = item_json(i, task: result&.task_for(i))
    h.merge!(extra.call(i)) if extra
    h
  end
  puts JSON.generate(rows)
  true
end

def cmd_next(args = [])
  context = temporal_context
  today = context.local_date
  result = application.view_tasks(:next, today: today, context: cli_operation_context(context))
  nexts = result.items
  return if emit_json?(nexts, args, result: result)
  by_ctx = Hash.new { |h, k| h[k] = [] }
  nexts.each do |i|
    ctxs = contexts(i)
    (ctxs.empty? ? ["(no context)"] : ctxs).each { |c| by_ctx[c] << i }
  end
  by_ctx.sort.each do |ctx, list|
    puts bold(ctx)
    # The canonical :next order is already priority-sorted with file-order
    # ties; a per-group re-sort here would re-break those ties (MRI sort_by
    # is unstable).
    list.each do |i|
      due = short_due(i, today: today, context: context)
      puts "  #{fmt(i)}#{due.empty? ? "" : "  #{due}"}"
    end
    puts
  end
end

def cmd_quadrants(args = [])
  context = temporal_context
  today = context.local_date
  result = application.view_tasks(:quadrants, today: today, urgent_days: PATHS.urgent_days,
                                   context: cli_operation_context(context))
  open_items = result.items
  return if emit_json?(open_items, args, result: result, extra: ->(i) { result.metadata_for(i) })
  by_q = open_items.group_by { |item| result.metadata_for(item).fetch(:quadrant) }
  Tasks::Quadrants::LABELS.each do |key, label|
    puts bold(label)
    matched = by_q[key] || []
    matched.empty? ? (puts "  —") : matched.each { |i| puts "  #{fmt(i)}" }
    puts
  end
end

def cmd_agenda(args = [])
  context = temporal_context
  today = context.local_date
  result = application.view_tasks(:agenda, today: today, context: cli_operation_context(context))
  dated = result.items
  return if emit_json?(dated, args, result: result)
  dated.each do |i|
    d = i.deadline || i.scheduled
    kind = i.deadline ? "DUE " : "STRT"
    days = (d - today).to_i
    when_s = days.negative? ? "#{-days}d ago" : days.zero? ? "today" : "in #{days}d"
    value = result.task_for(i)&.public_send(i.deadline ? :deadline_value : :scheduled_value)
    local = value&.local_time
    stamp = "#{local || d.strftime("%m-%d")} #{kind} (#{when_s})"
    stamp = red(stamp) if days <= 2
    puts "#{stamp}  #{fmt(i)}"
  end
end

def cmd_inbox(args = [])
  context = temporal_context
  today = context.local_date
  result = application.view_tasks(:inbox, today: today, context: cli_operation_context(context))
  inbox = result.items
  return if emit_json?(inbox, args, result: result)
  inbox.empty? ? (puts "Inbox empty. ✨") : inbox.each { |i| puts "  #{fmt(i)}" }
end

CAPTURE_USAGE = %(usage: tasks capture "text" [--due d] [--scheduled d] [--priority A|B|C] [--tag t] [--context @x] [--no-host-context] [--state STATE] [--project "Heading" | --under <ref>] [--note "text"])
PROPOSE_USAGE = %(usage: tasks propose "text" [--due d] [--scheduled d] [--lead span] [--priority A|B|C] [--tag t] [--context @x] [--no-host-context] [--project "Heading" | --under <ref>] [--note "rationale"])

def cmd_capture(args, proposed: false)
  context = temporal_context
  today = context.local_date
  tags = []
  contexts = []
  notes = []
  due = scheduled = priority = state = project = recur = lead = under = nil
  due_timezone = scheduled_timezone = due_fold = scheduled_fold = nil
  due_floating = scheduled_floating = false
  dry = json = no_host_context = false
  positional = []
  i = 0
  # fetch a flag's value or abort — a forgotten value must never fail silently
  need = ->(flag) { args[i += 1] or abort "missing value for #{flag}" }
  while i < args.length
    case (a = args[i])
    when "--due", "--deadline"    then due = need.(a)
    when "--scheduled", "--sched" then scheduled = need.(a)
    when "--due-timezone"          then due_timezone = need.(a)
    when "--scheduled-timezone"    then scheduled_timezone = need.(a)
    when "--due-floating"          then due_floating = true
    when "--scheduled-floating"    then scheduled_floating = true
    when "--due-fold"              then due_fold = need.(a)
    when "--scheduled-fold"        then scheduled_fold = need.(a)
    when "--priority", "--pri"    then priority = need.(a)
    when "--tag"                  then tags << need.(a)
    when "--context", "--ctx"     then contexts << need.(a)
    when "--no-host-context"      then no_host_context = true
    when "--state"                then state = need.(a)
    when "--project"              then project = need.(a)
    when "--under"                then under = need.(a)
    when "--recur", "--repeat"    then recur = need.(a)
    when "--lead"                 then lead = need.(a)
    when "--note"                 then notes << need.(a)
    when "--dry-run"              then dry = true
    when "--json"                 then json = true
    when /\A--/                   then abort "unknown flag: #{a}"
    else                               positional << a
    end
    i += 1
  end
  text = positional.join(" ").strip.force_encoding("UTF-8")
  usage = proposed ? PROPOSE_USAGE : CAPTURE_USAGE
  abort usage if text.empty?
  # --under (nest under a task) and --project (file under a section) are two
  # different destinations — pick one.
  abort "can't combine --under and --project\n#{usage}" if under && project
  abort "propose owns state PROPOSED" if proposed && state
  abort "proposals cannot recur" if proposed && recur
  abort "due temporal modifiers require --due" if !due && (due_timezone || due_floating || due_fold)
  abort "scheduled temporal modifiers require --scheduled" if !scheduled && (scheduled_timezone || scheduled_floating || scheduled_fold)
  abort "--due-timezone and --due-floating are mutually exclusive" if due_timezone && due_floating
  abort "--scheduled-timezone and --scheduled-floating are mutually exclusive" if scheduled_timezone && scheduled_floating
  { "--due-fold" => due_fold, "--scheduled-fold" => scheduled_fold }.each do |flag, fold|
    abort "#{flag} must be earlier or later" unless fold.nil? || %w[earlier later].include?(fold)
  end

  cookie = nil
  if recur
    cookie = parse_recur_input(recur)
    abort "a capture cannot start with recurrence cleared — drop --recur" if cookie == :off
    # A recurrence needs a date to repeat; default to scheduling it today —
    # unless a lead is also set, where "today" would put the window in the past
    # and hide the schedule's own first occurrence. The store seeds that
    # occurrence instead, so leave the date unset here.
    scheduled ||= "today" unless due || lead
  end

  span = lead && parse_lead_input(lead)
  if span == :off
    abort "a capture cannot start with its lead time cleared — drop --lead"
  end

  due_date = due && parse_temporal(
    due, context: context, field: "--due",
    options: { timezone: due_timezone, floating: due_floating, fold: due_fold == "later" ? 1 : 0 }
  )
  scheduled_date = scheduled && parse_temporal(
    scheduled, context: context, field: "--scheduled",
    options: { timezone: scheduled_timezone, floating: scheduled_floating,
               fold: scheduled_fold == "later" ? 1 : 0 }
  )

  pri = priority&.upcase
  pri = nil if pri && %w[NONE CLEAR -].include?(pri)
  abort "priority must be A, B, or C" unless pri.nil? || %w[A B C].include?(pri)

  # A recurring capture always ends up dated — either from a flag here or from
  # the first occurrence the store seeds for a lead — so it lands processed as
  # TODO either way, rather than as an INBOX item that is already scheduled.
  dated = due_date || scheduled_date || cookie
  st = proposed ? "PROPOSED" : (state&.upcase || (dated ? "TODO" : "INBOX"))
  valid = ALL_STATES
  abort "unknown state: #{st} (want one of #{valid.join(", ")})" unless valid.include?(st)
  if cookie && (CLOSED_STATES + PROPOSED_STATES).include?(st)
    abort "can't set recurrence on a #{st} task"
  end
  if span && !(due_date || scheduled_date) && cookie.nil?
    abort "a lead time needs a date to hide before — add --due or --scheduled"
  end
  if span && due_date && scheduled_date
    abort lead_gate_conflict_hint(span)
  end

  # Contexts are tags that start with "@"; list them before plain tags.
  all_tags = contexts.map { |c| c.start_with?("@") ? c : "@#{c}" } + tags

  # --under nests below an existing task (open-only ref, exit 2 on miss).
  # Resolve the convenience ref here, then pass only its durable id across the
  # application boundary.
  under_item = under && resolve_ref(under, include_proposed: proposed)
  parent_id = under_item && stable_id_for(under_item)

  command = Tasks::CreateTask.new(
    title: text, deadline: due_date, scheduled: scheduled_date,
    priority: pri, tags: all_tags, state: st, project: project,
    parent_id: parent_id, recurrence: cookie, lead: span,
    body: notes.empty? ? nil : notes.join("\n"),
    apply_host_context: !no_host_context
  )

  if dry
    preview = application.prepare_create_task(command)
    head = +"#{st} "
    head << "[##{pri}] " if pri
    head << text
    head << " :#{preview.tags.join(":")}:" unless preview.tags.empty?
    head << " (recur #{cookie})" if cookie
    head << " (lead #{span})" if span
    if under_item
      puts %(would #{proposed ? "propose" : "capture"} under "#{under_item.title}": #{head})
    else
      puts "would #{proposed ? "propose" : "capture"} under #{project || "Inbox"}: #{head}"
    end
    return
  end

  result = application.create_task(command, today: today, context: cli_operation_context(context))
  if result.too_deep?
    mutation_failed "would exceed max depth #{store.max_depth} (max_depth config / TASKS_MAX_DEPTH)"
  end
  # A parent can disappear after the CLI resolved --under. That is a stale
  # mutation (exit 1), not a fresh ref-resolution miss (exit 2).
  if result.not_found? && parent_id
    result = Tasks::MutationResult.new(status: :stale, errors: result.errors,
                                        read_snapshot: result.read_snapshot,
                                        field_errors: result.field_errors,
                                        form_errors: result.form_errors,
                                        touched_ids: result.touched_ids, summary: result.summary,
                                        rolled_back: result.rolled_back?)
  end
  mutation_result_failed(result, "could not #{proposed ? "propose" : "capture"} (no #{(project || "Inbox").inspect} section found?)")
  if proposed && !json
    puts "proposed: #{text} [#{result.touched_ids.fetch(0)}]"
  else
    report_touched(result.touched_ids, json: json, today: today,
                   read_snapshot: result.read_snapshot, temporal_context: context)
  end
end

def cmd_propose(args) = cmd_capture(args, proposed: true)

def cmd_proposal_decision(args, action:)
  context = temporal_context
  today = context.local_date
  notes = []
  if action == :reject
    notes, args = extract_repeatable_flag(args, "--note")
  end
  flags, rest = take_flags(args, "--json")
  ref = rest.shift
  usage = action == :reject ? "tasks reject <ref> [--note \"reason\"] [--json]" : "tasks #{action} <ref> [--json]"
  abort "usage: #{usage}" if ref.nil? || ref.strip.empty? || !rest.empty?
  item = resolve_ref(ref, include_done: true)
  result = if action == :reject
             application.reject_task(
               stable_id_for(item), today: today, notes: notes.empty? ? nil : notes,
               context: cli_operation_context(context)
             )
           else
             application.approve_task(
               stable_id_for(item), today: today,
               context: cli_operation_context(context)
             )
           end
  if result.conflict? && result.summary&.dig(:proposed_descendant_ids)
    mutation_failed "decide proposed descendants first"
  end
  mutation_failed(result.errors.first) if result.invalid? && !result.errors.empty?
  mutation_result_failed(result, "failed to #{action} proposal")
  if flags["--json"]
    report_touched(
      result.touched_ids, json: true, today: today,
      read_snapshot: result.read_snapshot, temporal_context: context
    )
  else
    target = action == :approve ? "INBOX" : "CANCELLED"
    verb = action == :approve ? "approved" : "rejected"
    puts "#{verb} → #{target}: #{item.title}"
  end
end

def cmd_approve(args) = cmd_proposal_decision(args, action: :approve)
def cmd_reject(args) = cmd_proposal_decision(args, action: :reject)

# --- Delegation (delegate / undelegate / workref / claim / release) ----------
#
# Five thin adapters over the typed Tasks::Application delegation operations.
# Eligibility, the atomic claim compare-and-set, worker matching, and the
# WAITING default all live behind that boundary; what happens here is argument
# parsing, ref resolution, and printing the one-line delegation summary.

DELEGATE_USAGE = %(usage: tasks delegate <ref> <refine|research|implement>  |  tasks delegate <ref> --to <email> [--keep-state])
WORKER_HINT = "pass --worker <id> or set TASKS_WORKER_ID"

# The worker id behind a claim or release: the flag always wins, then the
# TASKS_WORKER_ID environment variable a heartbeat harness sets once per
# session. Missing both is a usage error, not a silent owner-level write.
# Normalize before trimming — see utf8_strip.
def worker_id(flag_value, required: true)
  value = utf8_strip((flag_value || ENV["TASKS_WORKER_ID"]).to_s)
  abort "worker id is not valid UTF-8 text" unless value.valid_encoding?
  abort "missing worker id — #{WORKER_HINT}" if value.empty? && required
  value.empty? ? nil : value
end

# One line describing a task's delegation. `delegate`, `claim`, `release`, and
# `list --delegated/--agent-ready` all print through it, so the four surfaces
# cannot drift apart.
def delegation_headline(task, state_changed: false)
  delegation = task&.delegation
  return "not delegated: #{task&.title}" unless delegation

  case delegation["status"]
  when "delegated" then "delegated → #{delegation["assignee"]} (#{task.state}): #{task.title}"
  when "ready"
    # The state only appears when this write moved it — replacing a person with
    # the agent pool leaves WAITING, and silently changing state would surprise.
    ready = "agent-ready (#{delegation["mode"]})"
    state_changed ? "#{ready} → #{task.state}: #{task.title}" : "#{ready}: #{task.title}"
  when "claimed"   then "claimed by #{delegation["assignee"]}: #{task.title}"
  else "delegated: #{task.title}"
  end
end

# The same summary without the title, for `show`'s field list.
def delegation_summary(delegation)
  case delegation["status"]
  when "delegated" then "→ #{delegation["assignee"]}"
  when "ready"     then "agent-ready (#{delegation["mode"]})"
  when "claimed"   then "claimed by #{delegation["assignee"]} (#{delegation["mode"]})"
  else delegation["status"].to_s
  end
end

# Typed refusals mapped to the CLI's error contract. A conflict is the
# lost-race case (a claim someone else holds, a worker mismatch): it names the
# holder, exits non-zero, and with --json also emits a machine-readable error
# object so a heartbeat agent branches without parsing display text.
def delegation_failed!(result, json:)
  if result.conflict?
    summary = result.summary || {}
    message = if summary[:action] == :claim && summary[:holder]
                "conflict: already claimed by #{summary[:holder]} at #{summary[:at]}"
              else
                "conflict: #{result.errors.first || "delegation conflict"}"
              end
    if json
      require "json"
      puts JSON.generate({ error: "conflict", action: summary[:action]&.to_s,
                           id: summary[:task_id], holder: summary[:holder],
                           at: summary[:at], message: message })
    end
    warn message
    exit result.cli_exit_code
  end
  mutation_failed(result.errors.first) if result.invalid? && !result.errors.empty?
  mutation_result_failed(result, "failed to update delegation")
end

# The canonical post-write task as the [item, TaskView] pair the CLI's JSON
# shapes are built from. An idempotent repeat writes nothing and carries no
# snapshot, so that case re-reads the live file.
def delegation_task_pair(result, task_id, today:, context:)
  snapshot = result.read_snapshot
  unless snapshot
    store.reload!
    snapshot = store.read_snapshot
  end
  query = Tasks::TaskQueries.new(snapshot, today: today, temporal_context: context)
  item = snapshot.items.find { |candidate| candidate.id == task_id }
  [item, item && query.task(item)]
end

def cmd_delegate(args)
  context = temporal_context
  today = context.local_date
  args = args.dup
  to = extract_value(args, "--to")
  flags, rest = take_flags(args, "--json", "--keep-state")
  ref = rest.shift
  mode = rest.join(" ").strip
  abort DELEGATE_USAGE if ref.nil? || ref.strip.empty?
  abort DELEGATE_USAGE if to.nil? && mode.empty?
  abort "delegate takes a mode or --to <email>, not both\n#{DELEGATE_USAGE}" if to && !mode.empty?

  # Refs resolve across proposed and closed tasks so an ineligible target
  # reports the state that refuses it rather than a bare no-match.
  item = resolve_ref(ref, include_done: true)
  task_id = stable_id_for(item)
  operation = cli_operation_context(context)
  result = if to
             application.delegate_task(task_id, kind: "human", assignee: utf8_arg(to),
                                       keep_state: flags["--keep-state"], today: today,
                                       context: operation)
           else
             application.delegate_task(task_id, kind: "agent", mode: mode,
                                       keep_state: flags["--keep-state"], today: today,
                                       context: operation)
           end
  delegation_failed!(result, json: flags["--json"])
  if flags["--json"]
    report_touched([task_id], json: true, today: today,
                   read_snapshot: result.read_snapshot, temporal_context: context)
  else
    _item, task = delegation_task_pair(result, task_id, today: today, context: context)
    puts delegation_headline(task, state_changed: !!result.summary[:state_changed])
  end
end

def cmd_undelegate(args)
  context = temporal_context
  today = context.local_date
  flags, rest = take_flags(args, "--json")
  ref = rest.shift
  abort "usage: tasks undelegate <ref> [--json]" if ref.nil? || ref.strip.empty? || !rest.empty?

  item = resolve_ref(ref, include_done: true)
  task_id = stable_id_for(item)
  result = application.undelegate_task(task_id, today: today,
                                       context: cli_operation_context(context))
  delegation_failed!(result, json: flags["--json"])
  if flags["--json"]
    report_touched([task_id], json: true, today: today,
                   read_snapshot: result.read_snapshot, temporal_context: context)
  else
    _item, task = delegation_task_pair(result, task_id, today: today, context: context)
    title = task&.title || item.title
    puts result.no_change? ? "not delegated: #{title}" : "undelegated: #{title}"
  end
end

# Record where the work lives (ticket, PR, brief, session); `off` clears it.
# The owner may always write it; an agent passes --worker to prove its claim
# still matches (deliberately never defaulted from the environment, so an
# exported TASKS_WORKER_ID cannot silently change who is writing).
def cmd_workref(args)
  context = temporal_context
  today = context.local_date
  args = args.dup
  worker = extract_value(args, "--worker")
  flags, rest = take_flags(args, "--json")
  ref = rest.shift
  reference = utf8_strip(rest.join(" "))
  abort "usage: tasks workref <ref> <url-or-id|off> [--worker <id>]" if ref.nil? || ref.strip.empty? || reference.empty?
  abort "work reference is not valid UTF-8 text" unless reference.valid_encoding?

  item = resolve_ref(ref, include_done: true)
  task_id = stable_id_for(item)
  result = application.set_work_ref(task_id, reference, worker: worker, today: today,
                                    context: cli_operation_context(context))
  delegation_failed!(result, json: flags["--json"])
  if flags["--json"]
    report_touched([task_id], json: true, today: today,
                   read_snapshot: result.read_snapshot, temporal_context: context)
  else
    _item, task = delegation_task_pair(result, task_id, today: today, context: context)
    title = task&.title || item.title
    puts task&.work_ref ? "work ref → #{task.work_ref}: #{title}" : "work ref cleared: #{title}"
  end
end

def cmd_claim(args)
  context = temporal_context
  today = context.local_date
  args = args.dup
  worker_flag = extract_value(args, "--worker")
  flags, rest = take_flags(args, "--json")
  ref = rest.shift
  abort "usage: tasks claim <ref> --worker <id> [--json]" if ref.nil? || ref.strip.empty? || !rest.empty?
  worker = worker_id(worker_flag)

  item = resolve_ref(ref, include_done: true)
  task_id = stable_id_for(item)
  result = application.claim_task(task_id, worker: worker, today: today,
                                  context: cli_operation_context(context))
  delegation_failed!(result, json: flags["--json"])
  claimed, task = delegation_task_pair(result, task_id, today: today, context: context)
  if flags["--json"]
    # The whole canonical resource, not just the marker: a worker claims and
    # reads the authority it is working under in one step.
    require "json"
    puts JSON.generate(task_resource_json(claimed, task))
  else
    puts delegation_headline(task)
  end
end

def cmd_release(args)
  context = temporal_context
  today = context.local_date
  args = args.dup
  worker_flag = extract_value(args, "--worker")
  note = utf8_arg(extract_value(args, "--note"))
  flags, rest = take_flags(args, "--json", "--force")
  ref = rest.shift
  abort "usage: tasks release <ref> --worker <id> [--note \"blocker\"] [--force]" if ref.nil? || ref.strip.empty? || !rest.empty?
  # --force is the owner override, so it stands in for a worker id.
  worker = worker_id(worker_flag, required: !flags["--force"])

  item = resolve_ref(ref, include_done: true)
  task_id = stable_id_for(item)
  result = application.release_task(task_id, worker: worker, force: flags["--force"],
                                    note: note, today: today,
                                    context: cli_operation_context(context))
  delegation_failed!(result, json: flags["--json"])
  warn "note was not appended: #{result.errors.first}" if note && result.summary[:note_applied] == false
  if flags["--json"]
    report_touched([task_id], json: true, today: today,
                   read_snapshot: result.read_snapshot, temporal_context: context)
  else
    _item, task = delegation_task_pair(result, task_id, today: today, context: context)
    puts "released → #{delegation_headline(task)}"
  end
end

# Core of the state-transition verbs. `state` passes the target as a
# positional arg; its sugar `done`/`cancel` hardcode DONE/CANCELLED. All three
# resolve the ref, honor --dry-run/--json, and route the write through the
# stable-id state patch (which stamps/clears CLOSED). `resolve_closed:` widens ref
# resolution to closed tasks — always for `state` (so you can reopen a DONE
# item), on demand elsewhere via --include-done. Optional `notes` (cancel only)
# append withdrawal rationale in the same multi-field write as the state change.
def change_state(args, usage:, resolve_closed:, to: nil, dry_verb: nil, archive_hint: false, recur_aware: false,
                 notes: nil)
  context = temporal_context
  today = context.local_date
  flags, rest = take_flags(args, "--dry-run", "--json", "--include-done")
  ref = rest.shift
  target = to || rest.join(" ").strip.upcase
  abort %(usage: #{usage}) if ref.nil? || ref.strip.empty? || target.empty?
  valid = ALL_STATES
  abort "unknown state: #{target} (want one of #{valid.join(", ")})" unless valid.include?(target)

  item = resolve_ref(ref, include_done: resolve_closed || flags["--include-done"])
  # Completing a recurring task rolls its date forward and keeps it open — a
  # different verb (and no archive hint) than closing a one-shot task.
  recurring_done = recur_aware && target == "DONE" && item.recurring?
  note_text = notes && !notes.empty? ? notes.join("\n") : nil
  if flags["--dry-run"]
    if recurring_done
      puts "would recur → #{recur_next(item, context: context).iso8601}: #{item_headline(item)}"
    else
      puts "would #{dry_verb || "set state #{target} on"}: #{item_headline(item)}"
      # Completing an open parent cascades to its open descendants; preview how
      # many would close so a `done` on a project isn't a silent surprise. Gated
      # on an actual transition into DONE (item still open), matching the store.
      if target == "DONE" && item.open? && (n = open_descendant_count(item)) > 0
        puts "would also close #{n} open descendant#{"s" unless n == 1}"
      end
      puts "would add note: #{note_text}" if note_text
    end
    return
  end
  task_id = stable_id_for(item)
  result = if note_text
             snapshot = application.edit_snapshot(task_id)
             mutation_failed "failed to set state" unless snapshot
             body = snapshot.body
             new_body = body.nil? || body.empty? ? note_text : "#{body}\n#{note_text}"
             changeset_task_by_id(
               task_id, changes: { state: target, body: new_body },
               label: "state → #{target}: #{item.title}", today: today,
               snapshot: snapshot, context: cli_operation_context(context)
             )
           else
             patch_task_by_id(task_id, field: :state, value: target,
                              label: "state → #{target}: #{item.title}", today: today,
                              context: cli_operation_context(context))
           end
  mutation_result_failed(result, "failed to set state")
  if recurring_done && !flags["--json"]
    fresh = result.read_snapshot&.items&.find { |i| i.id == task_id }
    d = fresh && (fresh.deadline || fresh.scheduled)
    puts "↻ #{item.title}#{d ? " → next #{d.iso8601} (#{d.strftime("%a")})" : ""}"
  end
  report_touched(result_touched_ids(result, fallback: task_id), json: flags["--json"],
                 today: today, read_snapshot: result.read_snapshot, temporal_context: context)
  puts "Run `tasks archive` to move it out of tasks.jsonl." if archive_hint && !recurring_done && !flags["--json"]
end

# The date a recurring item's next occurrence would land on, from its precedence
# stamp (DEADLINE over SCHEDULED, matching the Store). For `done` preview output.
def recur_next(item, context: temporal_context)
  require_relative "../lib/tasks/recur"
  value = item.deadline_value || item.scheduled_value
  kind = item.deadline_value ? :deadline : :scheduled
  paired = item.deadline_value && item.scheduled_value ? item.scheduled_value : nil
  delta = paired && (paired.date - value.date)
  Tasks::Recur.next_temporal_date(item.recur, value: value, kind: kind, context: context) do |candidate|
    next true unless paired

    paired.with_date(candidate + delta).instant(context)
    true
  rescue Tasks::Timezones::Error, ArgumentError
    false
  end
end

# `done` and `cancel` are sugar for the DONE/CANCELLED transitions; they resolve
# open tasks only (a closed task needs `state` to reopen or re-close it).
def cmd_done(args)
  change_state(args, to: "DONE", usage: %(tasks done "<ref>"),
               resolve_closed: false, dry_verb: "mark DONE", archive_hint: true, recur_aware: true)
end

def cmd_cancel(args)
  notes, args = extract_repeatable_flag(args, "--note")
  change_state(args, to: "CANCELLED", usage: "tasks cancel <ref> [--note \"reason\"]",
               resolve_closed: false, notes: notes)
end

# --- Store-backed mutations (due / state / priority) ------------------------
#
# These go through Tasks::Store#with_history, which validates the file after
# every write and rolls back on structural error. Ref resolution matches a
# case-insensitive substring of an open task's title, or an exact `L<line>`.

def store
  @store ||= Tasks::Store.new(org: ORG, archive: ARCHIVE,
                              links: PATHS.links, link_systems: PATHS.link_systems,
                              max_depth: PATHS.max_depth)
end

# The application keeps no Store instance: every query receives its own fresh
# Store and immutable snapshot. The CLI's long-lived Store above remains for
# CLI-only ref resolution, presentation, and the remaining non-patch commands.
def application
  @application ||= Tasks::Application.new(
    store_factory: Tasks::StoreFactory.new(
      org: ORG, archive: ARCHIVE, links: PATHS.links,
      link_systems: PATHS.link_systems, max_depth: PATHS.max_depth
    ),
    temporal_context_factory: -> {
      Tasks::TemporalContext.capture(timezone: PATHS.timezone, time_format: PATHS.time_format)
    },
    host_context: PATHS.host_context
  )
end

# Abort a failed mutation. A false return is usually a stale line, but it's also
# how a post-write validation rollback surfaces — if the store recorded one,
# append a pointed hint so the user runs `check` instead of chasing a phantom
# concurrent edit.
def mutation_failed(msg)
  if store.last_rollback
    abort "#{msg}\nfile failed validation after the edit — run `tasks check`"
  else
    abort msg
  end
end

# CLI refs are deliberately fuzzy and may use L<line>, but that convenience
# ends at the command boundary. Every write below addresses its target by the
# stable id returned from ref resolution.
def stable_id_for(item)
  return item.id if item.id && !item.id.empty?

  mutation_failed "task has no stable id"
end

PATCH_EXPECTED_UNSET = Object.new.freeze
PATCH_SNAPSHOT_UNSET = Object.new.freeze

# Build one stable-id patch from a fresh editor snapshot. A ref can disappear
# after the CLI resolved it; that is the legacy stale-edit case (exit 1), while
# refs that are absent at resolution still exit 2 in resolve_ref.
def patch_task_by_id(task_id, field:, value:, label:, expected: PATCH_EXPECTED_UNSET,
                     coalesce_key: nil, snapshot: PATCH_SNAPSHOT_UNSET, force: false,
                     today: Date.today, context: nil)
  snapshot = application.edit_snapshot(task_id) if snapshot.equal?(PATCH_SNAPSHOT_UNSET)
  baseline = if expected.equal?(PATCH_EXPECTED_UNSET)
               snapshot && patch_expected(snapshot, field)
             else
               expected
             end
  patch = Tasks::TaskPatch.new(id: task_id, field: field, value: value,
                               expected: baseline, history_label: label,
                               coalesce_key: coalesce_key, force: force)
  result = application.patch_task(patch, today: today, context: context)
  return result unless result.not_found?

  Tasks::MutationResult.new(status: :stale, snapshot: result.snapshot,
                             errors: result.errors, field_errors: result.field_errors,
                             form_errors: result.form_errors,
                             touched_ids: result.touched_ids, summary: result.summary,
                             rolled_back: result.rolled_back?)
end

# Apply an atomic multi-field command from one Store-produced revision. Timed
# defer and activate intentionally own both availability fields, so two
# independent patches would expose an intermediate state and consume two undo
# entries.
def changeset_task_by_id(task_id, changes:, label:, today:, snapshot: nil, context: nil)
  snapshot ||= application.edit_snapshot(task_id)
  return Tasks::MutationResult.new(status: :stale) unless snapshot

  changeset = Tasks::TaskChangeset.from(snapshot, changes: changes, history_label: label)
  result = application.update_task(changeset, today: today, context: context)
  return result unless result.not_found?

  Tasks::MutationResult.new(status: :stale, snapshot: result.snapshot,
                            read_snapshot: result.read_snapshot,
                            errors: result.errors, field_errors: result.field_errors,
                            form_errors: result.form_errors,
                            touched_ids: result.touched_ids, summary: result.summary,
                            rolled_back: result.rolled_back?)
end

def patch_expected(snapshot, field)
  return snapshot.metadata.fetch(:tag_sequence) if field == :tag_delta
  return snapshot.metadata.fetch(:date_state) if field == :date_clear

  snapshot.expected_for(field)
end

# Adapter mapping for typed Store results. Human wording remains the command's
# established wording; the result supplies the exit status after the command
# has already distinguished ref-resolution failures from stale writes.
def mutation_result_failed(result, msg)
  return result if result.ok?

  # The result carries this distinction because Application mutations run on a
  # short-lived Store that the CLI never sees.
  message = if result.rolled_back?
              "#{msg}\nfile failed validation after the edit — run `tasks check`"
            elsif result.respond_to?(:migration_required?) && result.migration_required?
              "#{msg}\ntask data migration required; run `tasks migrate` (nothing was written)"
            elsif result.store_invalid?
              "#{msg}\ntask file is already invalid — run `tasks check` (nothing was written)"
            else
              msg
            end
  warn message
  exit result.cli_exit_code
end

def result_touched_ids(result, fallback:)
  result.touched_ids.empty? ? [fallback] : result.touched_ids
end

# Resolve a move destination section by name at the CLI boundary, then pass only
# the section id into the location patch. Delegates to Store#section_named, which
# resolves in the same widening tiers capture uses (exact top-level, exact
# any-level, substring top-level, substring any-level) — so a nested project
# sub-section is reachable by name, not just a top-level heading.
def section_record_for(name) = store.section_named(name)

def section_id_for(name) = section_record_for(name)&.fetch("id")

# Locate the task's nearest ancestor section by id without retaining a file
# coordinate. Rootless tasks have no top-level destination, matching the old
# move_top! refusal.
def nearest_section_id_for(task_id)
  records = store.read_snapshot.live_records
  by_id = records.to_h { |record| [record["id"], record] }
  record = by_id[task_id]
  record = record && record["parent"] && by_id[record["parent"]]
  while record && record["type"] != "section"
    # A nil parent must stop the walk (rootless ancestor chain) — without the
    # guard, by_id[nil] resolves to the id-less meta record, whose parent is
    # also nil, and the loop cycles on it forever.
    record = record["parent"] && by_id[record["parent"]]
  end
  record && record["id"]
end

# Pull known boolean flags out of args, returning [flags_hash, positional].
def take_flags(args, *known)
  flags = {}
  rest = []
  args.each do |a|
    if known.include?(a)
      flags[a] = true
    elsif a.start_with?("--")
      abort "unknown flag: #{a} (this command accepts: #{known.join(", ")})"
    else
      rest << a
    end
  end
  [flags, rest]
end

# Extract every occurrence of a valued flag (e.g. repeatable `--note`), returning
# [values, remaining_args]. Missing values abort the same way capture does.
def extract_repeatable_flag(args, flag)
  values = []
  rest = []
  i = 0
  while i < args.length
    if args[i] == flag
      values << (args[i += 1] or abort "missing value for #{flag}")
    else
      rest << args[i]
    end
    i += 1
  end
  [values, rest]
end

def item_headline(item)
  store.headline(item)
end

def item_json(item, task: nil)
  # One map, one insertion order. When a TaskView is present every semantic
  # field is read from it (source/headline/contexts included); otherwise the
  # Item supplies them — both respond to the same readers, so adding or
  # renaming a field can't split the JSON shape between read commands and
  # mutation reporting. `line` is always the item's physical line.
  src = task || item
  row = {
    id: src.id,
    state: src.state, priority: src.priority, title: src.title,
    tags: src.tags.reject { |tag| tag.start_with?("@") },
    contexts: src.contexts,
    deferred: src.deferred?,
    scheduled: src.scheduled&.iso8601,
    scheduled_time: task&.scheduled_time || item.scheduled_value&.time_metadata,
    deadline: src.deadline&.iso8601,
    deadline_time: task&.deadline_time || item.deadline_value&.time_metadata,
    recur: src.recur,
    # The canonical cookie stays the machine value; recur_human is the same
    # schedule rendered once, here, so no consumer re-implements the grammar.
    recur_human: src.recur && Tasks::Recur.humanize(src.recur),
    lead: src.lead,
    # Same convention as recur/recur_human: the canonical span stays the
    # machine value, and the rendering happens once, here.
    lead_human: Tasks::Lead.span?(src.lead) ? Tasks::Lead.humanize(src.lead) : nil,
    line: item.line, source: src.source, headline: src.headline,
  }
  if task
    row.merge!(
      lead_opens: task.lead_opens&.iso8601,
      lead_opens_at: task.lead_opens_at&.iso8601,
      available: task.available?,
      availability_reason: task.availability_reason.to_s,
      availability_blocker_id: task.availability_blocker_id,
      available_at: task.available_at,
      # Present (as null when absent) on every row that has a view, so
      # `list --agent-ready --json` needs no bespoke shape: an agent ranks and
      # claims from the same fields the other read commands emit.
      project: task.project,
      delegation: task.delegation
    )
  end
  row
end

# The full canonical task resource: the standard row plus what `show` adds —
# closed date, notes, project, links. `show --json` and `claim --json` both
# emit exactly this.
def task_resource_json(item, task)
  item_json(item, task: task).merge(
    closed: task.closed&.iso8601,
    notes: task.body.map(&:strip).reject(&:empty?),
    project: task.project,
    links: task.links.map(&:to_h)
  )
end

# Resolve <ref> to exactly one in-scope item (or exit 2). `L<line>` targets an
# exact headline line. When a ref names a live task outside the requested scope,
# say so explicitly instead of pretending the task does not exist.
def resolve_ref(ref, include_done: false, proposed_only: false, include_proposed: false)
  abort "missing <ref>" if ref.nil? || ref.strip.empty?
  all_items = store.items
  items = all_items
  items = if proposed_only
            items.select(&:proposed?)
          elsif include_done
            items
          elsif include_proposed
            items.select { |i| i.open? || i.proposed? }
          else
            items.select(&:open?)
          end

  if (m = ref.match(/\AL(\d+)\z/i))
    item = items.find { |i| i.line == m[1].to_i }
    unless item
      outside = all_items.find { |i| i.line == m[1].to_i }
      ref_outside_scope!(ref, outside, proposed_only: proposed_only,
                         include_done: include_done, include_proposed: include_proposed) if outside
      qualifier = proposed_only ? "proposed " : (include_done ? "" : "open ")
      warn "no #{qualifier}task with a headline on line #{m[1]}"
      exit 2
    end
    return item
  end

  # An exact :ID: match is unambiguous, so it wins over fuzzy title matching
  # (case-insensitive, since org treats property values loosely).
  if (item = items.find { |i| i.id && i.id.casecmp?(ref.strip) })
    return item
  end
  outside = all_items.find { |i| i.id && i.id.casecmp?(ref.strip) }
  ref_outside_scope!(ref, outside, proposed_only: proposed_only,
                     include_done: include_done, include_proposed: include_proposed) if outside

  q = ref.dup.force_encoding("UTF-8").strip.downcase
  # to_s: a nil-title record (a prime repair target) must be resolvable by
  # fuzzy ref without a NoMethodError; it simply won't match any substring.
  matches = items.select { |i| i.title.to_s.downcase.include?(q) }
  if matches.empty?
    outside_matches = all_items.select { |i| i.title.to_s.downcase.include?(q) }
    if outside_matches.size == 1
      ref_outside_scope!(ref, outside_matches.first, proposed_only: proposed_only,
                         include_done: include_done, include_proposed: include_proposed)
    elsif outside_matches.size > 1
      scope = ref_scope_description(proposed_only: proposed_only, include_done: include_done,
                                    include_proposed: include_proposed)
      warn "ref outside scope: #{ref} — #{outside_matches.size} title matches, none is #{scope}:"
      outside_matches.each { |i| warn "  L#{i.line}: #{item_headline(i)}" }
      exit 2
    end
    warn "no match: #{ref}"
    exit 2
  elsif matches.size > 1
    warn "ambiguous: #{ref} — matches #{matches.size} tasks:"
    matches.each { |i| warn "  L#{i.line}: #{item_headline(i)}" }
    exit 2
  end
  matches.first
end

def ref_outside_scope!(ref, item, proposed_only:, include_done:, include_proposed:)
  scope = ref_scope_description(proposed_only: proposed_only, include_done: include_done,
                                include_proposed: include_proposed)
  warn "ref outside scope: #{ref} — task is #{item.state}; expected #{scope}"
  exit 2
end

def ref_scope_description(proposed_only:, include_done:, include_proposed:)
  return "a PROPOSED task" if proposed_only
  return "a live task" if include_done
  return "an open or PROPOSED task" if include_proposed

  "an open task"
end

# After a mutation, print (or JSON-emit) every touched task's new headline.
# Stable ids survive retitles and tree moves, and cascade results carry every
# affected id. The CLI JSON keeps its historical line field as presentation,
# never as a mutation locator.
def report_touched(ids, json:, today: nil, read_snapshot: nil, extra: nil, temporal_context: nil)
  temporal_context ||= method(:temporal_context).call
  today ||= temporal_context.local_date
  if read_snapshot
    query = Tasks::TaskQueries.new(read_snapshot, today: today, temporal_context: temporal_context)
    items = Array(ids)
           .map { |id| read_snapshot.items.find { |item| item.id == id } }
           .compact.sort_by(&:line)
  else
    store.reload!
    items = Array(ids)
           .map { |id| store.items.find { |item| item.id == id } }
           .compact.sort_by(&:line)
  end
  if json
    require "json"
    query ||= Tasks::TaskQueries.new(store.read_snapshot, today: today,
                                     temporal_context: temporal_context)
    payload = { touched: items.map { |item| item_json(item, task: query.task(item)) } }
    payload.merge!(extra) if extra
    puts payload.to_json
  else
    items.each { |i| puts item_headline(i) }
  end
end

# How many open tasks sit below `item` in the tree — the descendants a `done`
# cascade would close. Read-side count over the item's tree node (self dropped);
# 0 when the item has no live node (e.g. an archive item), so the caller stays
# silent rather than guessing.
def open_descendant_count(item)
  node = store.node_for(item)
  return 0 unless node
  node.each.drop(1).count { |n| n.item&.open? }
end

# Shared implementation for `due` (DEADLINE) and `schedule` (SCHEDULED).
def cmd_set_date(args, kind:, usage:)
  args = args.dup
  context = temporal_context
  today = context.local_date
  key = kind == :scheduled ? "SCHEDULED" : "DEADLINE"
  temporal_options = extract_temporal_options(args)
  flags, rest = take_flags(args, "--dry-run", "--json", "--include-done")
  ref = rest.shift
  date_str = rest.join(" ")
  abort %(usage: #{usage}) if ref.nil? || date_str.strip.empty?
  date = parse_temporal(date_str, context: context, options: temporal_options)

  item = resolve_ref(ref, include_done: flags["--include-done"])
  task_id = stable_id_for(item)
  if flags["--dry-run"]
    puts "would set #{key} <#{temporal_label(date)}> on: #{item_headline(item)}"
    return
  end
  result = patch_task_by_id(task_id, field: kind, value: date,
                            label: "#{key.downcase} → #{temporal_label(date)}: #{item.title}",
                            today: today, context: cli_operation_context(context))
  # A refusal here names a rule (a lead's single timed gate, say); its own
  # sentence is the only thing that tells the user what to do instead.
  mutation_failed(result.errors.first) if result.invalid? && !result.errors.empty?
  mutation_result_failed(result, "failed to set #{key.downcase}")
  report_touched(result_touched_ids(result, fallback: task_id), json: flags["--json"],
                 today: today, read_snapshot: result.read_snapshot, temporal_context: context)
end

def cmd_due(args)      = cmd_set_date(args, kind: :deadline,  usage: "tasks due <ref> <date-or-date-time>")
def cmd_schedule(args) = cmd_set_date(args, kind: :scheduled, usage: "tasks schedule <ref> <date-or-date-time>")

def cmd_priority(args)
  flags, rest = take_flags(args, "--dry-run", "--json", "--include-done")
  ref = rest.shift
  pri_arg = rest.join(" ").strip
  abort %(usage: tasks priority <ref> <A|B|C|none>) if ref.nil? || pri_arg.empty?
  pri = pri_arg.upcase
  pri = nil if %w[NONE CLEAR -].include?(pri)
  abort "priority must be A, B, C, or none" unless pri.nil? || %w[A B C].include?(pri)

  item = resolve_ref(
    ref, include_done: flags["--include-done"], include_proposed: true
  )
  task_id = stable_id_for(item)
  if flags["--dry-run"]
    puts "would set priority #{pri ? "[##{pri}]" : "(none)"} on: #{item_headline(item)}"
    return
  end
  label = pri ? "priority [##{pri}]: #{item.title}" : "clear priority: #{item.title}"
  result = patch_task_by_id(task_id, field: :priority, value: pri, label: label)
  mutation_result_failed(result, "failed to set priority")
  report_touched(result_touched_ids(result, fallback: task_id), json: flags["--json"],
                 read_snapshot: result.read_snapshot)
end

def cmd_undate(args)
  context = temporal_context
  today = context.local_date
  args = args.dup
  kind = nil
  if (idx = args.index("--kind"))
    kind_arg = args[idx + 1]
    abort "usage: tasks undate <ref> [--kind deadline|scheduled]" unless kind_arg
    args.delete_at(idx + 1)
    args.delete_at(idx)
    kind = kind_arg.downcase.to_sym
    abort "--kind must be deadline or scheduled" unless %i[deadline scheduled].include?(kind)
  end

  flags, rest = take_flags(args, "--dry-run", "--json", "--include-done")
  ref = rest.shift
  abort %(usage: tasks undate <ref> [--kind deadline|scheduled]) if ref.nil? || ref.strip.empty?

  item = resolve_ref(ref, include_done: flags["--include-done"])
  task_id = stable_id_for(item)
  if flags["--dry-run"]
    target = kind ? kind.to_s.upcase : "SCHEDULED/DEADLINE"
    puts "would remove #{target} from: #{item_headline(item)}"
    return
  end
  label = kind ? "remove #{kind}: #{item.title}" : "remove dates: #{item.title}"
  snapshot = application.edit_snapshot(task_id)
  if snapshot && !(kind ? snapshot.public_send(kind) : snapshot.scheduled || snapshot.deadline)
    mutation_failed "nothing to remove (no matching date stamp?)"
  end
  result = patch_task_by_id(task_id, field: :date_clear, value: kind, label: label,
                            snapshot: snapshot, today: today)
  message = result.stale? ? "task changed or vanished while editing" \
                          : "nothing to remove (no matching date stamp?)"
  mutation_result_failed(result, message)
  report_touched(result_touched_ids(result, fallback: task_id), json: flags["--json"],
                 today: today, read_snapshot: result.read_snapshot, temporal_context: context)
end

def cmd_show(args)
  context = temporal_context
  today = context.local_date
  flags, rest = take_flags(args, "--json", "--include-done")
  ref = rest.shift
  abort %(usage: tasks show <ref>) if ref.nil? || ref.strip.empty?
  item = resolve_ref(
    ref, include_done: flags["--include-done"], include_proposed: true
  )
  # Show is a pure read: build the view over one snapshot and fall back to the
  # held item if a concurrent write removed it, instead of aborting with
  # mutation-flavored error text (and a misleading rollback hint).
  query = Tasks::TaskQueries.new(store.read_snapshot, today: today, temporal_context: context)
  task = query.task(item)

  closed = task.closed
  notes = task.body.map(&:strip).reject(&:empty?)
  links = task.links
  project = task.project

  if flags["--json"]
    require "json"
    puts task_resource_json(item, task).to_json
  else
    puts task.headline
    puts "  id:        #{task.id}" if task.id
    puts "  project:   #{project}" if project
    if task.delegated?
      puts "  delegation: #{delegation_summary(task.delegation)} #{dim("(since #{task.delegation["at"]})")}"
      puts "  work ref:  #{task.work_ref}" if task.work_ref
    end
    if task.scheduled
      puts "  available from: #{task.scheduled_value ? temporal_label(task.scheduled_value) : task.scheduled.iso8601}"
    end
    if task.deadline
      puts "  deadline:  #{task.deadline_value ? temporal_label(task.deadline_value) : task.deadline.iso8601}"
    end
    puts "  availability: #{availability_summary(query, query.availability(item))}"
    puts "  recur:     #{task.recur} #{dim("(#{recur_summary(task.recur)})")}" if task.recur
    if task.lead
      opens = lead_gate_line(item, task.lead, opens: task.lead_opens_value)
      puts "  lead:      #{task.lead} #{dim("(#{task.lead_human || task.lead})")}"
      puts "  opens:     #{opens}" if opens
    end

    puts "  closed:    #{closed.iso8601}" if closed
    notes.each { |n| puts "  #{n}" }
    unless links.empty?
      width = links.map { |l| l.system.length }.max
      links.each { |l| puts link_line(l, width) }
    end
  end
end

# List links found in task titles/bodies, classified by system (slack, jira,
# github, …). One task's links with a <ref>; otherwise every open task's.
# --system filters (e.g. --system jira); --all widens to done + archived.
# Shared --system value parsing for `links` and `open` — the two must agree
# on how a system name is read (downcased: SYSTEMS names and host fallbacks
# are lowercase) or "open what links showed me" breaks between them.
def take_system_value(args)
  value = args.shift
  abort "--system needs a value" if value.nil? || value.start_with?("-")
  value.downcase
end

def cmd_links(args)
  args = args.dup
  flags = {}
  system_f = nil
  rest = []
  until args.empty?
    a = args.shift
    case a
    when "--json"         then flags["--json"] = true
    when "--all", "-a"    then flags["--all"] = true
    when "--system", "-s" then system_f = take_system_value(args)
    when /\A-/            then abort "unknown flag: #{a} (links accepts: --json, --all, --system)"
    else                       rest << a
    end
  end

  entries =
    if (ref = rest.shift)
      item = resolve_ref(ref, include_done: true)
      [[item, store.links(item)]]
    else
      items = store.items
      items += store.archive_items if flags["--all"]
      items = items.select { |i| flags["--all"] || OPEN_STATES.include?(i.state) }
      items.map { |i| [i, store.links(i)] }
    end
  entries = entries.map { |i, ls| [i, system_f ? ls.select { |l| l.system == system_f } : ls] }
                   .reject { |_i, ls| ls.empty? }

  if flags["--json"]
    require "json"
    puts({ links: entries.flat_map { |i, ls|
      ls.map { |l| l.to_h.merge(task: i.title, id: i.id, line: i.line, source: i.source) }
    } }.to_json)
    return
  end

  if entries.empty?
    puts "No links found."
    return
  end
  width = entries.flat_map { |_i, ls| ls.map { |l| l.system.length } }.max
  entries.each do |i, ls|
    puts fmt(i)
    ls.each { |l| puts link_line(l, width) }
  end
end

# One rendered link row, shared by `links` and `show` so the surfaces agree.
def link_line(link, width)
  "  #{cyan(link.system.ljust(width))} #{link.url}#{link.label ? dim("  (#{link.label})") : ""}"
end

# Open a task's link in the browser. One link opens straight away; several
# need a pick — a 1-based index or --system — otherwise they're listed with a
# hint (nothing launches unbidden). --print prints instead of launching.
def cmd_open(args)
  args = args.dup
  flags = {}
  system_f = nil
  rest = []
  until args.empty?
    a = args.shift
    case a
    when "--print", "-p"  then flags["--print"] = true
    when "--system", "-s" then system_f = take_system_value(args)
    when /\A-/            then abort "unknown flag: #{a} (open accepts: --print, --system)"
    else                       rest << a
    end
  end
  ref = rest.shift
  abort "usage: tasks open <ref> [n] [--system <name>] [--print]" if ref.nil? || ref.strip.empty?
  pick = rest.shift&.then { |n| n =~ /\A\d+\z/ ? n.to_i : abort("expected a link number, got: #{n}") }

  item = resolve_ref(ref, include_done: true)
  links = store.links(item)
  links = links.select { |l| l.system == system_f } if system_f
  abort "no links on: #{item.title}#{system_f ? " (system #{system_f})" : ""}" if links.empty?

  if pick
    # 1-based; 0 would negative-index into the list's tail
    abort "no link ##{pick} (task has #{links.size})" unless pick >= 1 && links[pick - 1]
    link = links[pick - 1]
  elsif links.size == 1
    link = links.first
  else
    # Echo the --system filter in the hint: the numbers below index the
    # FILTERED list, so the re-run must filter the same way.
    sys = system_f ? " --system #{system_f}" : ""
    warn "#{links.size} links — pick one: tasks open #{ref.inspect}#{sys} <n>"
    width = links.map { |l| l.system.length }.max
    links.each_with_index { |l, i| warn "  #{i + 1}. #{cyan(l.system.ljust(width))} #{l.url}" }
    exit 1
  end

  if flags["--print"]
    puts link.url
  else
    Tasks::Opener.open_url(link.url) or abort "no browser launcher found (set TASKS_OPENER)"
    puts "opened #{link.url}"
  end
end

def cmd_state(args)
  usage = "tasks state <ref> <#{ALL_STATES.join("|")}>"
  # resolve_closed: true — a state change may need to find (and reopen) a
  # closed item, e.g. `state <ref> TODO`. recur_aware: DONE on a recurring task
  # rolls it forward (same as `done`), so the preview/output must say so.
  change_state(args, usage: usage, resolve_closed: true, recur_aware: true)
end

def cmd_retitle(args)
  flags, rest = take_flags(args, "--dry-run", "--json", "--include-done")
  ref = rest.shift
  new_title = rest.join(" ").strip
  abort %(usage: tasks retitle <ref> "new title") if ref.nil? || ref.strip.empty? || new_title.empty?

  item = resolve_ref(
    ref, include_done: flags["--include-done"], include_proposed: true
  )
  task_id = stable_id_for(item)
  if flags["--dry-run"]
    puts "would retitle to #{new_title.inspect}: #{item_headline(item)}"
    return
  end
  result = patch_task_by_id(task_id, field: :title, value: new_title,
                            label: "retitle → #{new_title}: #{item.title}")
  mutation_result_failed(result, "failed to retitle")
  report_touched(result_touched_ids(result, fallback: task_id), json: flags["--json"],
                 read_snapshot: result.read_snapshot)
end

def cmd_tag(args)
  flags, rest = take_flags(args, "--dry-run", "--json", "--include-done")
  ref = rest.shift
  specs = rest
  abort %(usage: tasks tag <ref> +tag -tag @ctx -@ctx) if ref.nil? || ref.strip.empty? || specs.empty?

  add = []
  remove = []
  specs.each do |s|
    case s
    when /\A-(.+)/  then remove << Regexp.last_match(1)  # -tag or -@ctx
    when /\A\+(.+)/ then add << Regexp.last_match(1)     # +tag
    when /\A@/      then add << s                        # @ctx
    else abort "tag spec must start with +, -, or @: #{s}"
    end
  end

  item = resolve_ref(
    ref, include_done: flags["--include-done"], include_proposed: true
  )
  task_id = stable_id_for(item)
  if flags["--dry-run"]
    changes = (add.map { |t| "+#{t}" } + remove.map { |t| "-#{t}" }).join(" ")
    puts "would apply #{changes} to: #{item_headline(item)}"
    return
  end
  result = patch_task_by_id(task_id, field: :tag_delta,
                            value: { add: add, remove: remove },
                            label: "tags: #{item.title}")
  mutation_result_failed(result, "failed to update tags")
  report_touched(result_touched_ids(result, fallback: task_id), json: flags["--json"],
                 read_snapshot: result.read_snapshot)
end

# ARGV strings carry the locale's encoding (ASCII-8BIT under LANG=C, cron,
# scripts); re-tag as UTF-8 before joining with snapshot text, or the
# interpolation below raises Encoding::CompatibilityError on a non-ASCII body.
# Same recovery Store#utf8 applies to the value once it reaches the patch.
def utf8_arg(str)
  return str if str.nil? || str.encoding == Encoding::UTF_8
  recoded = str.dup.force_encoding(Encoding::UTF_8)
  recoded.valid_encoding? ? recoded : str
end

# utf8_arg, then strip — in that order, always. String#strip raises
# Encoding::CompatibilityError on bytes that are invalid in their own encoding,
# so trimming first turns one mistyped byte into a raw backtrace. Text that is
# still invalid after normalization is returned untrimmed, for the caller to
# refuse with a sentence instead of a stack trace.
def utf8_strip(str)
  text = utf8_arg(str)
  return text if text.nil? || !text.valid_encoding?

  text.strip
end

def cmd_note(args)
  flags, rest = take_flags(args, "--dry-run", "--json", "--include-done")
  ref = rest.shift
  text = utf8_arg(rest.join(" ").strip)
  abort %(usage: tasks note <ref> "text") if ref.nil? || ref.strip.empty? || text.empty?

  item = resolve_ref(
    ref, include_done: flags["--include-done"], include_proposed: true
  )
  task_id = stable_id_for(item)
  if flags["--dry-run"]
    puts "would add note to #{item_headline(item)}: #{text}"
    return
  end
  snapshot = application.edit_snapshot(task_id)
  if snapshot.nil?
    mutation_failed "cannot add note: task is missing or the file is invalid — run `tasks check`"
  end
  body = snapshot.body
  result = patch_task_by_id(task_id, field: :body,
                            value: body.nil? || body.empty? ? text.strip : "#{body}\n#{text.strip}",
                            label: "note: #{item.title}", snapshot: snapshot)
  mutation_result_failed(result, "failed to add note")
  report_touched(result_touched_ids(result, fallback: task_id), json: flags["--json"],
                 read_snapshot: result.read_snapshot)
end

# Build the canonical availability answer from one read snapshot. The optional
# own-field override is used only for dry-run; ancestor precedence still comes
# from Tasks::TaskQueries rather than being duplicated in the CLI.
def availability_context(task_id, today:, read_snapshot:, deferred: PATCH_EXPECTED_UNSET,
                         scheduled: PATCH_EXPECTED_UNSET, lead: PATCH_EXPECTED_UNSET,
                         temporal_context: nil)
  query = Tasks::TaskQueries.new(read_snapshot, today: today, temporal_context: temporal_context)
  item = query.snapshot.items.find { |candidate| candidate.id == task_id }
  mutation_failed "task changed before availability could be read" unless item
  unset = [deferred, scheduled, lead].all? { |value| value.equal?(PATCH_EXPECTED_UNSET) }
  availability = if unset
                   query.availability(item)
                 else
                   own_deferred = deferred.equal?(PATCH_EXPECTED_UNSET) ? item.deferred? : deferred
                   # The VALUE, not the bare date: dropping its time and zone
                   # would make the preview resolve a different instant than the
                   # write it is previewing.
                   own_scheduled = if scheduled.equal?(PATCH_EXPECTED_UNSET)
                                     item.scheduled_value || item.scheduled
                                   else
                                     scheduled
                                   end
                   own_lead = lead.equal?(PATCH_EXPECTED_UNSET) ? Tasks::TaskQueries::UNSET : lead
                   query.availability_after(item, deferred: own_deferred,
                                            scheduled: own_scheduled, lead: own_lead)
                 end
  [query, item, availability]
end

def availability_summary(query, availability)
  blocker = availability.blocker_id &&
            query.snapshot.items.find { |item| item.id == availability.blocker_id }
  via = blocker ? %( via "#{blocker.title}" [#{blocker.id}]) : ""

  case availability.reason
  when :available then "available now"
  when :scheduled then "unavailable until #{temporal_label(availability.temporal_value)}"
  when :ancestor_scheduled then "unavailable until #{temporal_label(availability.temporal_value)}#{via}"
  when :on_hold then "on hold indefinitely"
  when :ancestor_on_hold then "still on hold indefinitely#{via}"
  when :proposed then "awaiting approval"
  when :closed then "closed"
  else "unavailable"
  end
end

def print_availability_change(task_id, today:, own_text:, dry_run: false,
                              read_snapshot:,
                              deferred: PATCH_EXPECTED_UNSET,
                              scheduled: PATCH_EXPECTED_UNSET,
                              lead: PATCH_EXPECTED_UNSET, temporal_context: nil)
  query, _item, availability = availability_context(
    task_id, today: today, read_snapshot: read_snapshot,
    deferred: deferred, scheduled: scheduled, lead: lead, temporal_context: temporal_context
  )
  puts "#{dry_run ? "would " : ""}#{own_text} — #{availability_summary(query, availability)}"
end

# `defer <ref> <date>` sets the available-from date and clears an indefinite
# hold atomically. With no date it preserves the historical indefinite hold;
# `someday` is the clearer canonical spelling for that operation.
def cmd_defer(args, someday: false)
  args = args.dup
  context = temporal_context
  today = context.local_date
  temporal_options = extract_temporal_options(args)
  flags, rest = take_flags(args, "--dry-run", "--json", "--include-done")
  ref = rest.shift
  date_str = rest.join(" ").strip
  usage = someday ? "tasks someday <ref>" : "tasks defer <ref> [date]"
  abort %(usage: #{usage}) if ref.nil? || ref.strip.empty? || (someday && !date_str.empty?)
  abort "temporal modifiers require a date" if date_str.empty? && temporal_options[:modified]

  date = unless date_str.empty?
           parse_temporal(date_str, context: context, options: temporal_options)
         end
  item = resolve_ref(ref, include_done: flags["--include-done"])
  task_id = stable_id_for(item)
  # Rule 3: the lead already owns "hide until". A one-off defer date would
  # either fight it or be silently ignored, so name the two ways out instead.
  if date && item.lead_time?
    abort "“#{item.title}” already hides until #{Tasks::Lead.describe(item.lead)} its " \
          "#{item.deadline ? "deadline" : "available-from date"} — " \
          "change the window with `tasks lead`, or clear it with `tasks lead <ref> off` first"
  end
  changes = date ? { deferred: false, scheduled: date } : { deferred: true }
  own_text = date ? %(defer "#{item.title}" until #{temporal_label(date)}) :
                    %(put "#{item.title}" on hold (Someday/Maybe))

  if flags["--dry-run"]
    read_snapshot = store.read_snapshot
    print_availability_change(
      task_id, today: today, own_text: own_text, dry_run: true,
      read_snapshot: read_snapshot,
      deferred: changes.fetch(:deferred),
      scheduled: changes.fetch(:scheduled, PATCH_EXPECTED_UNSET), temporal_context: context
    )
    return
  end

  label = date ? "defer until #{temporal_label(date)}: #{item.title}" : "someday: #{item.title}"
  result = changeset_task_by_id(task_id, changes: changes, label: label, today: today,
                                context: cli_operation_context(context))
  mutation_result_failed(result, "failed to defer")
  mutation_failed "defer succeeded without a result snapshot" unless result.read_snapshot
  if flags["--json"]
    report_touched(result_touched_ids(result, fallback: task_id), json: true, today: today,
                   read_snapshot: result.read_snapshot, temporal_context: context)
  else
    print_availability_change(task_id, today: today, own_text: own_text,
                              read_snapshot: result.read_snapshot, temporal_context: context)
  end
end

# Make the task available now: remove its own indefinite marker and clear only
# a future available-from date. A past/today date remains as useful history.
def cmd_activate(args)
  context = temporal_context
  today = context.local_date
  flags, rest = take_flags(args, "--dry-run", "--json", "--include-done")
  ref = rest.shift
  abort %(usage: tasks activate <ref>) if ref.nil? || ref.strip.empty? || !rest.empty?

  item = resolve_ref(ref, include_done: flags["--include-done"])
  task_id = stable_id_for(item)
  snapshot = application.edit_snapshot(task_id)
  mutation_failed "task changed before activation" unless snapshot
  scheduled_value = item.scheduled_value
  scheduled = if scheduled_value && scheduled_value.release_instant(context) > context.now
                nil
              else
                scheduled_value || snapshot.scheduled
              end
  changes = { activate: true }
  own_text = %(activate "#{item.title}")

  if flags["--dry-run"]
    print_availability_change(
      task_id, today: today, own_text: own_text, dry_run: true,
      read_snapshot: store.read_snapshot,
      deferred: false, scheduled: scheduled, temporal_context: context
    )
    return
  end

  result = changeset_task_by_id(
    task_id, changes: changes, label: "activate: #{item.title}", today: today,
    snapshot: snapshot, context: cli_operation_context(context)
  )
  mutation_result_failed(result, "failed to activate")
  mutation_failed "activate succeeded without a result snapshot" unless result.read_snapshot
  if flags["--json"]
    report_touched(result_touched_ids(result, fallback: task_id), json: true, today: today,
                   read_snapshot: result.read_snapshot, temporal_context: context)
  else
    print_availability_change(task_id, today: today, own_text: own_text,
                              read_snapshot: result.read_snapshot, temporal_context: context)
  end
end

# Human-readable gloss of a stored recurrence value, e.g. ".+1w" → "every week
# from completion", "w:mon,wed" → "every Mon and Wed". One renderer (the engine's)
# for `show`, `list`, and every `recur` surface; unparsable values echo verbatim.
def recur_summary(cookie)
  Tasks::Recur.humanize(cookie) || cookie.to_s
end

RECUR_USAGE = %(usage: tasks recur <ref> [<schedule>] [--from schedule|completion] [--on <date>]
       tasks recur <ref> [--count N] [--json]              preview the next occurrences
       tasks recur --explain "<schedule>" [--count N] [--json]).freeze

# What to type when the parser can't read a schedule: one example per shape.
RECUR_HINT = "try: weekly · 2w · every 3 days · .+1m · every mon,wed · m:15 · " \
             "2nd tuesday · last day of the month · every july 4 · off"

# Normalize typed input to its stored form, aborting with the engine's own
# reason (which names the fix) when it can't be read. `:off` comes back for the
# clearing words; each caller decides whether clearing is legal there.
def parse_recur_input(input, default_prefix: ".+")
  result = Tasks::Recur.parse_result(input, default_prefix: default_prefix)
  abort "#{result[:error]}\n#{RECUR_HINT}" if result[:error]
  result[:canonical]
end

# --count for the two preview modes. Returns nil when the flag was absent, so
# the write path can reject it rather than silently ignore it.
def recur_count(args)
  raw = extract_value(args, "--count")
  return nil if raw.nil?
  abort "--count must be a positive whole number" unless raw.match?(/\A\d+\z/) && raw.to_i.positive?
  abort "--count is capped at 50" if raw.to_i > 50
  raw.to_i
end

# Attach/replace/clear a recurrence schedule on a task's date stamp, or — with
# no schedule argument — preview when the task fires next. On `done`, a
# recurring task rolls its date forward and stays open instead of closing.
# `<schedule>`: an interval (weekly/2w/every 3 days/.+1m), a calendar schedule
# (every mon,wed / m:15 / last friday / w:mon), or `off` to clear.
# --from schedule|completion picks +/.+ for a bare interval (calendar schedules
# carry their own semantics and reject it); --on <date> seeds a stamp when the
# task has no date yet.
def cmd_recur(args)
  require_relative "../lib/tasks/dates"
  context = temporal_context
  today = context.local_date
  args = args.dup

  from = extract_value(args, "--from")
  abort "--from must be schedule or completion" unless from.nil? || %w[schedule completion].include?(from)
  on = extract_value(args, "--on")
  on_date = on && (Tasks::Dates.parse_when(on, today: today) || abort("unrecognized date: #{on}"))
  count = recur_count(args)

  flags, rest = take_flags(args, "--dry-run", "--json", "--include-done", "--explain")

  # `--explain` never touches the store: it parses, renders, and projects.
  if flags["--explain"]
    abort "--explain previews a schedule, not a task — drop --from/--on/--dry-run" if from || on || flags["--dry-run"]
    input = rest.join(" ").strip
    abort RECUR_USAGE if input.empty?
    return recur_explain(input, count: count || 5, json: flags["--json"], context: context)
  end

  ref = rest.shift
  input = rest.join(" ").strip
  abort RECUR_USAGE if ref.nil? || ref.strip.empty?

  item = resolve_ref(ref, include_done: flags["--include-done"])

  # No schedule argument: read-only preview of the schedule already stored.
  if input.empty?
    abort "`tasks recur <ref>` with no schedule is read-only — pass a schedule to set one" if from || on || flags["--dry-run"]
    return recur_preview(item, count: count || 5, json: flags["--json"], context: context)
  end

  abort "--count previews occurrences; it does not apply when setting a schedule" if count
  default_prefix = from == "schedule" ? "+" : ".+"
  cookie = parse_recur_input(input, default_prefix: default_prefix)
  # --from is interval-only: a calendar schedule carries its own advance
  # semantics in the `+` prefix, so point at the prefix the input does not have.
  if from && cookie.is_a?(String) && Tasks::Recur.calendar?(cookie)
    advice = if cookie.start_with?("+")
               "#{cookie} already advances one occurrence past the stored date; " \
               "drop the + to advance to the next match after today instead"
             else
               "#{cookie} advances to the next match after today; " \
               "write +#{cookie} to advance one occurrence past the stored date instead"
             end
    abort "--from #{from} applies to intervals, not calendar schedules — #{advice}"
  end

  task_id = stable_id_for(item)
  # A closed task with a live repeater is dead recurrence: `done` can't reach it
  # to roll it. Refuse to create one (clearing with `off` is always fine).
  if cookie != :off && DONE_STATES.include?(item.state)
    abort "can't set recurrence on a #{item.state} task — reopen it first"
  end
  has_date = item.scheduled || item.deadline
  if cookie != :off && !has_date && on_date.nil?
    abort "“#{item.title}” has no date to repeat — add --on <date>, or schedule/`due` it first"
  end
  # Clearing recurrence from a task that has no date (so can't be recurring) is
  # a harmless no-op, not an error.
  noop_off = cookie == :off && !has_date

  if flags["--dry-run"]
    desc =
      if noop_off        then "leave unchanged (no recurrence set)"
      elsif cookie == :off then "clear recurrence"
      else                    "set recurrence #{cookie} (#{recur_summary(cookie)})"
      end
    desc += ", seeding DEADLINE <#{on_date.iso8601}>" if on_date && !has_date
    puts "would #{desc} on: #{item_headline(item)}"
    return
  end

  if noop_off
    report_touched([task_id], json: flags["--json"], today: today)
    return
  end
  label = cookie == :off ? "recur off: #{item.title}" : "recur #{cookie}: #{item.title}"
  result =
    if on_date && !has_date
      # Seed and schedule land in one checked transaction: the store applies
      # dates before recurrence, so the satisfiability guard anchors on the new
      # deadline, a refusal leaves the file untouched, and success is one undo.
      changeset_task_by_id(task_id, changes: { deadline: on_date, recurrence: cookie },
                           label: "recur #{cookie} + deadline #{on_date.iso8601}: #{item.title}",
                           today: today, context: cli_operation_context(context))
    else
      patch_task_by_id(task_id, field: :recurrence, value: cookie, label: label, today: today)
    end
  # The store refuses a schedule that would never fire (or would roll past the
  # storable year range); its reason names which, so surface it verbatim.
  mutation_failed(result.errors.first) if result.invalid? && !result.errors.empty?
  mutation_result_failed(result, "failed to set recurrence (no date stamp?)")

  # The stamp on the task *is* its next occurrence, so report that — the same
  # value (and phrasing) `done` prints after a roll.
  fresh = result.read_snapshot&.items&.find { |i| i.id == task_id }
  stamp = fresh && (fresh.deadline || fresh.scheduled)
  nxt = cookie == :off ? nil : stamp
  if cookie != :off && !flags["--json"]
    puts "↻ #{recur_summary(cookie)} #{dim("(#{cookie})")}" \
         "#{nxt ? " → next #{nxt.iso8601} (#{nxt.strftime("%a")})" : ""}"
  end
  report_touched(result_touched_ids(result, fallback: task_id), json: flags["--json"],
                 today: today, read_snapshot: result.read_snapshot,
                 extra: nxt ? { next: nxt.iso8601 } : nil, temporal_context: context)
end

LEAD_USAGE = %(usage: tasks lead <ref> <span|off> [--dry-run] [--json]
       tasks lead <ref>                              read-only: the window it opens).freeze

# What to type when the parser can't read a span: one example per shape.
LEAD_HINT = "try: 3w · 2d · 1m · \"3 weeks\" · \"a week\" · \"10 days\" · off"

# Normalize typed input to its stored span, aborting with the engine's own
# reason (which names the fix) when it can't be read. `:off` comes back for the
# clearing words; each caller decides whether clearing is legal there.
def parse_lead_input(input)
  result = Tasks::Lead.parse_result(input)
  abort "#{result[:error]}\n#{LEAD_HINT}" if result[:error]
  result[:canonical]
end

# Rule 3's CLI-side wording (see docs/plans/implemented/recurring-lead-time.md §5).
# The store refuses the same shape with its own message; this one fires before
# a write the store would only reject, so a capture never half-lands.
def lead_gate_conflict_hint(span)
  "a #{Tasks::Lead.humanize(span)} lead measures from the deadline, so an " \
    "available-from date would be a second, ignored gate — pick one"
end

# The anchor a lead is measured back from, and the date its window opens.
def lead_anchor_value(item) = item.deadline_value || item.scheduled_value

# "2026-10-11 (Sun) — 3 weeks before 2026-11-01", or, with a clock lead, the
# time it opens as well. `opens` is the query's own derived value when the
# caller holds a TaskView, so a clock gate reads the same instant availability
# was decided on.
def lead_gate_line(item, span, opens: nil)
  anchor = lead_anchor_value(item)
  opens ||= lead_gate_value(item, span)
  return nil unless opens && anchor

  stamp = opens.local_time ? temporal_label(opens) : "#{opens.date.iso8601} (#{opens.date.strftime("%a")})"
  "#{stamp} — #{Tasks::Lead.humanize(span)} before #{anchor.date.iso8601}"
end

# The derived gate for a lead as a TemporalValue, for the read-only paths that
# hold an Item rather than a TaskView.
def lead_gate_value(item, span)
  anchor = lead_anchor_value(item)
  return nil unless anchor

  if Tasks::Lead.clock?(span)
    instant = Tasks::Lead.gate_instant(anchor, span, temporal_context)
    return nil unless instant

    local = Tasks::Timezones.local_time(instant, temporal_context.timezone)
    return Tasks::TemporalValue.new(
      date: local.to_date, local_time: format("%02d:%02d", local.hour, local.min),
      timezone: temporal_context.timezone_id, validate: false
    )
  end

  date = Tasks::Lead.gate_date(anchor.date, span)
  date && Tasks::TemporalValue.new(date: date)
end

# Attach/replace/clear the lead-time window on a task's date stamp: how long
# before its occurrence date the task becomes visible. With no span argument it
# is a read-only preview of the window already stored.
# `<span>`: a count and a unit (3w, 2d, 1m, 10 days, a week), or `off` to clear.
def cmd_lead(args)
  context = temporal_context
  today = context.local_date
  flags, rest = take_flags(args.dup, "--dry-run", "--json", "--include-done")
  ref = rest.shift
  input = rest.join(" ").strip
  abort LEAD_USAGE if ref.nil? || ref.strip.empty?

  item = resolve_ref(ref, include_done: flags["--include-done"], include_proposed: true)
  return lead_preview(item, json: flags["--json"]) if input.empty?

  span = parse_lead_input(input)
  task_id = stable_id_for(item)
  # The store owns the five rules; these two refusals exist only because the
  # CLI can name the exact flag combination that caused them (rules 1 and 3).
  if span != :off && lead_anchor_value(item).nil?
    abort "“#{item.title}” has no date to hide before — " \
          "add a deadline (`tasks due`) or an available-from date (`tasks schedule`) first"
  end
  abort lead_gate_conflict_hint(span) if span != :off && item.deadline && item.scheduled

  own_text =
    if span == :off
      %(clear the lead time on "#{item.title}")
    else
      anchor = lead_anchor_value(item)
      opens = lead_gate_value(item, span)
      # The mutation clause names the window; the availability clause that
      # follows carries the resulting date, so stating it twice would only
      # invite the two to disagree.
      window = anchor ? " (#{span} before #{anchor.date.iso8601})" : ""
      %(lead time #{span} on "#{item.title}"#{window})
    end

  if flags["--dry-run"]
    print_availability_change(
      task_id, today: today, own_text: own_text, dry_run: true,
      read_snapshot: store.read_snapshot, lead: span == :off ? nil : span,
      temporal_context: context
    )
    return
  end

  label = span == :off ? "lead off: #{item.title}" : "lead #{span}: #{item.title}"
  result = patch_task_by_id(task_id, field: :lead, value: span, label: label, today: today)
  mutation_failed(result.errors.first) if result.invalid? && !result.errors.empty?
  mutation_result_failed(result, "failed to set the lead time")

  if flags["--json"]
    report_touched(result_touched_ids(result, fallback: task_id), json: true, today: today,
                   read_snapshot: result.read_snapshot, temporal_context: context)
  else
    print_availability_change(task_id, today: today, own_text: own_text,
                              read_snapshot: result.read_snapshot, temporal_context: context)
  end
end

# `tasks lead <ref>` — read-only: the stored span and the date its window
# opens. Never mutates, so it is safe for agents to call before committing.
def lead_preview(item, json:)
  span = item.lead.to_s.strip
  anchor = lead_anchor_value(item)
  gate = Tasks::Lead.span?(span) ? lead_gate_value(item, span) : nil

  if json
    require "json"
    row = { id: item.id, line: item.line, title: item.title,
            lead: span.empty? ? nil : span,
            lead_human: span.empty? ? nil : (Tasks::Lead.humanize(span) || span),
            anchor: anchor&.date&.iso8601, opens: gate&.date&.iso8601,
            opens_at: gate&.release_instant(temporal_context)&.iso8601,
            lead_skip: item.lead_skip }
    puts JSON.generate(row)
    return
  end

  puts item_headline(item)
  if span.empty?
    puts "  no lead time — set one with `tasks lead #{item.title.inspect} 3w`"
    return
  end
  puts "  ⏳ #{Tasks::Lead.describe(span)} #{dim("(#{span})")}"
  if (line = lead_gate_line(item, span))
    puts "  opens #{line}"
  else
    warn "no date to hide before — add a deadline or an available-from date"
  end
  puts "  #{dim("this occurrence was released early (activate)")}" if item.lead_skip == anchor&.date&.iso8601
end

# `tasks recur <ref>` — read-only: what this task's schedule means and when it
# fires next. The stamp is the next occurrence by definition, so the list starts
# with it and projects forward from there. Never mutates, so it is safe for
# agents to call before committing.
def recur_preview(item, count:, json:, context:)
  today = context.local_date
  cookie = item.recur.to_s.strip
  anchor = item.deadline || item.scheduled
  dates, error = [], nil
  unless cookie.empty?
    if anchor
      dates = [anchor]
      begin
        dates += Tasks::Recur.occurrences(cookie, from: anchor, today: today, count: count - 1) if count > 1
      rescue ArgumentError => e
        error = e.message
      end
    else
      error = "no scheduled date or deadline to project from"
    end
  end

  if json
    require "json"
    row = { id: item.id, line: item.line, title: item.title,
            recur: cookie.empty? ? nil : cookie,
            recur_human: cookie.empty? ? nil : recur_summary(cookie),
            anchor: anchor&.iso8601, next: dates.map(&:iso8601) }
    row[:error] = error if error
    puts JSON.generate(row)
    return
  end

  puts item_headline(item)
  if cookie.empty?
    puts "  no recurrence — set one with `tasks recur #{item.title.inspect} <schedule>`"
    return
  end
  puts "  ↻ #{recur_summary(cookie)} #{dim("(#{cookie})")}"
  warn error if error
  dates.each { |d| puts "  #{d.iso8601} #{dim(d.strftime("%a"))}" }
end

# `tasks recur --explain "<schedule>"` — taskless parse/preview. The engine's
# payload has three shapes (understood + projected, understood but never fires,
# not understood); all three render here, and both failing shapes exit 1 so a
# script can branch on the status alone.
def recur_explain(input, count:, json:, context:)
  payload = Tasks::Recur.explain(input, context: context, count: count)
  if json
    require "json"
    row = payload.dup
    row[:next] = row[:next].map(&:iso8601) if row[:next]
    puts JSON.generate(row)
    exit 1 if row[:error]
    return
  end

  unless payload[:canonical]
    # Either an unreadable input or the explicit "off" words, which parse
    # cleanly and mean "clear the schedule".
    abort "#{payload[:error]}\n#{RECUR_HINT}" if payload[:error]
    puts "off — clears any schedule on the task"
    return
  end

  puts "#{payload[:canonical]} — #{payload[:human]}"
  Array(payload[:next]).each { |d| puts "  #{d.iso8601} #{dim(d.strftime("%a"))}" }
  return unless payload[:error]

  warn payload[:error]
  exit 1
end

# Pull `--flag value` out of args in place, returning the value (or nil). Aborts
# if the flag is present without a following value. For value flags that
# take_flags (boolean-only) can't handle.
def extract_value(args, flag)
  idx = args.index(flag)
  return nil unless idx
  val = args[idx + 1]
  abort "missing value for #{flag}" if val.nil? || val.start_with?("--")
  args.delete_at(idx + 1)
  args.delete_at(idx)
  val
end

def temporal_context
  now = if ENV["TASKS_TEST_TODAY_SEQUENCE"]
          date = Date.today
          Time.utc(date.year, date.month, date.day, 12)
        else
          Time.now.utc
        end
  Tasks::TemporalContext.new(now: now, timezone: PATHS.timezone, time_format: PATHS.time_format)
end

def cli_operation_context(context)
  Tasks::OperationContext.new(operation_id: "cli_#{SecureRandom.hex(8)}", source: :cli,
                              temporal_context: context)
end

def extract_temporal_options(args, timezone_flag: "--timezone", floating_flag: "--floating",
                             fold_flag: "--fold")
  timezone = extract_value(args, timezone_flag)
  fold_name = extract_value(args, fold_flag)
  floating = !!args.delete(floating_flag)
  abort "#{timezone_flag} and #{floating_flag} are mutually exclusive" if timezone && floating
  unless fold_name.nil? || %w[earlier later].include?(fold_name)
    abort "#{fold_flag} must be earlier or later"
  end
  { timezone: timezone, floating: floating, fold: fold_name == "later" ? 1 : 0,
    modified: !!(timezone || floating || fold_name) }
end

def parse_temporal(expression, context:, options: {}, field: nil)
  require_relative "../lib/tasks/temporal_parser"
  Tasks::TemporalParser.parse(expression, today: context.local_date, context: context,
                              timezone: options[:timezone], floating: options[:floating],
                              fold: options.fetch(:fold, 0)) || abort("unrecognized date: #{expression}")
rescue ArgumentError, Tasks::Timezones::Error => e
  abort field ? "#{field}: #{e.message}" : e.message
end

def temporal_label(value)
  text = +value.date.iso8601
  text << " #{value.local_time}" if value.local_time
  text << " #{value.timezone}" if value.timezone
  text << " (later fold)" if value.fold == 1
  text
end

MOVE_USAGE = %(tasks move <ref> ("Section" | --under <ref> | --top | ["Section" | --under <ref>] --before <ref>))

def placement_destination(parent)
  kind = parent.fetch("type") == "task" ? "under task" : "in section"
  %(#{kind} "#{parent["title"]}")
end

def placement_record(id)
  store.read_snapshot.live_records.find do |record|
    record["id"] == id && %w[task section].include?(record["type"])
  end
end

# Validate a dry-run through the exact Application/Store placement path against
# an isolated byte-for-byte copy. This keeps depth, cycle, anchor, and Check
# rules in the model while guaranteeing the configured task files and journal
# remain untouched.
def preview_task_placement(task_id, placement:, snapshot:, label:)
  require "tmpdir"
  Dir.mktmpdir("tasks-move-preview") do |dir|
    preview_org = File.join(dir, "tasks.jsonl")
    preview_archive = File.join(dir, "archive.jsonl")
    File.binwrite(preview_org, File.binread(ORG))
    File.binwrite(preview_archive, File.binread(ARCHIVE)) if File.exist?(ARCHIVE)
    preview_application = Tasks::Application.new(
      store_factory: Tasks::StoreFactory.new(
        org: preview_org, archive: preview_archive, journal_dir: File.join(dir, "journal"),
        links: PATHS.links, link_systems: PATHS.link_systems, max_depth: PATHS.max_depth
      )
    )
    changeset = Tasks::TaskChangeset.from(
      snapshot, changes: { location: placement }, history_label: label
    )
    preview_application.update_task(changeset, today: Date.today)
  end
end

def placement_result_failed(result, anchor_item:, parent:)
  mutation_failed "would exceed max depth #{store.max_depth} (max_depth config / TASKS_MAX_DEPTH)" if result.too_deep?
  mutation_failed "can't place a task relative to its own subtree" if result.cycle?
  if result.conflict?
    mutation_failed %("#{anchor_item.title}" is not a direct child of #{placement_destination(parent)})
  end
  mutation_result_failed(result, "could not place task before anchor")
end

# Relocate a task's subtree. Exactly one destination: a positional section
# name, --under <ref> (nest below another task, depth-capped), or --top (unnest
# to the section level). --top and moves to a section are never depth-checked.
def cmd_move(args)
  args = args.dup
  under = extract_value(args, "--under")
  before = extract_value(args, "--before")
  flags, rest = take_flags(args, "--dry-run", "--json", "--include-done", "--top")
  ref = rest.shift
  section = rest.join(" ").strip
  top = flags["--top"]
  abort %(usage: #{MOVE_USAGE}) if ref.nil? || ref.strip.empty?

  explicit_destinations = [!section.empty?, !under.nil?, top].count(true)
  if before
    # An anchor can infer its parent, or one explicit parent may constrain it.
    abort %(usage: #{MOVE_USAGE}) if top || explicit_destinations > 1
  else
    # Legacy append forms continue to require exactly one destination.
    abort %(usage: #{MOVE_USAGE}) unless explicit_destinations == 1
  end

  item = resolve_ref(ref, include_done: flags["--include-done"])
  task_id = stable_id_for(item)

  if before
    anchor_item = resolve_ref(before, include_done: flags["--include-done"])
    anchor_id = stable_id_for(anchor_item)

    anchor_record = placement_record(anchor_id)
    mutation_failed "anchor task no longer exists" unless anchor_record

    parent = if under
               parent_item = resolve_ref(under, include_done: flags["--include-done"])
               placement_record(stable_id_for(parent_item))
             elsif !section.empty?
               section_record_for(section)
             else
               placement_record(anchor_record["parent"])
             end
    missing_parent = if under
                       %(destination task "#{under}" no longer exists)
                     elsif !section.empty?
                       %(could not move (no "#{section}" section?))
                     else
                       "anchor has no live task or section parent"
                     end
    mutation_failed missing_parent unless parent
    parent_id = parent.fetch("id")

    snapshot = application.edit_snapshot(task_id)
    mutation_failed "task no longer exists" unless snapshot
    subtree_ids = snapshot.metadata.fetch(:subtree_ids)
    if anchor_id == task_id
      abort "can't place a task before itself"
    elsif subtree_ids.include?(parent_id) || subtree_ids.include?(anchor_id)
      abort "can't place a task relative to its own subtree"
    end
    if anchor_record["parent"] != parent_id
      abort %("#{anchor_item.title}" is not a direct child of #{placement_destination(parent)})
    end

    summary = %(move "#{item.title}" #{placement_destination(parent)} before "#{anchor_item.title}")
    label = "move before #{anchor_item.title}: #{item.title}"
    placement = Tasks::TaskPlacement.new(parent_id: parent_id, before_id: anchor_id)
    if flags["--dry-run"]
      preview = preview_task_placement(task_id, placement: placement, snapshot: snapshot, label: label)
      placement_result_failed(preview, anchor_item: anchor_item, parent: parent)
      puts "would #{summary}"
      puts item_headline(item)
      return
    end

    result = changeset_task_by_id(
      task_id,
      changes: { location: placement },
      label: label,
      today: Date.today,
      snapshot: snapshot
    )
    placement_result_failed(result, anchor_item: anchor_item, parent: parent)

    if flags["--json"]
      placement_json = {
        parent_id: parent_id,
        parent_type: parent.fetch("type"),
        parent_title: parent["title"],
        before_id: anchor_id,
        before_title: anchor_item.title,
      }
      report_touched([task_id], json: true, read_snapshot: result.read_snapshot,
                     extra: { placement: placement_json })
    else
      verb = result.no_change? ? "already placed" : "moved"
      puts %(#{verb} "#{item.title}" #{placement_destination(parent)} before "#{anchor_item.title}")
      report_touched([task_id], json: false, read_snapshot: result.read_snapshot)
    end
  elsif top
    if flags["--dry-run"]
      puts "would unnest to top level: #{item_headline(item)}"
      return
    end
    section_id = nearest_section_id_for(task_id)
    mutation_failed "failed to unnest" unless section_id
    result = patch_task_by_id(task_id, field: :location, value: section_id,
                              label: "unnest: #{item.title}")
    mutation_result_failed(result, "failed to unnest")
    if result.no_change?
      # Already parented to its section — nothing to do (and no undo slot burned).
      puts "already at top level"
      puts item_headline(item)
    else
      report_touched([task_id], json: flags["--json"], read_snapshot: result.read_snapshot)
    end
  elsif under
    parent_item = resolve_ref(under)
    parent_id = stable_id_for(parent_item)
    if flags["--dry-run"]
      puts %(would nest under "#{parent_item.title}": #{item_headline(item)})
      return
    end
    result = patch_task_by_id(task_id, field: :location, value: parent_id,
                              label: "nest under #{parent_item.title}: #{item.title}", force: true)
    mutation_failed "would exceed max depth #{store.max_depth} (max_depth config / TASKS_MAX_DEPTH)" if result.too_deep?
    mutation_failed "can't nest a task under its own subtree" if result.cycle?
    mutation_result_failed(result, %(could not nest under "#{parent_item.title}"))
    report_touched([task_id], json: flags["--json"], read_snapshot: result.read_snapshot)
  else
    if flags["--dry-run"]
      puts "would move to #{section.inspect}: #{item_headline(item)}"
      return
    end
    section_id = section_id_for(section)
    mutation_failed %(could not move (no "#{section}" section?)) unless section_id
    result = patch_task_by_id(task_id, field: :location, value: section_id,
                              label: "move → #{section}: #{item.title}", force: true)
    mutation_result_failed(result, %(could not move (no "#{section}" section?)))
    report_touched([task_id], json: flags["--json"], read_snapshot: result.read_snapshot)
  end
end

DELETE_USAGE = %(tasks delete <ref> [--cascade] [--dry-run] [--json] [--include-done])

# Hard-delete a task's subtree from the live file (not the archive). A task with
# descendants is refused unless --cascade removes the whole subtree; deletion
# never reparents children. Undoable via `tasks undo`. The removed tasks are
# gone after the write, so capture their headlines BEFORE mutating and report
# from that snapshot.
def cmd_delete(args)
  context = temporal_context
  today = context.local_date
  flags, rest = take_flags(args, "--cascade", "--dry-run", "--json", "--include-done")
  ref = rest.shift
  abort %(usage: #{DELETE_USAGE}) if ref.nil? || ref.strip.empty?

  item = resolve_ref(
    ref, include_done: flags["--include-done"], include_proposed: true
  )
  task_id = stable_id_for(item)
  query = Tasks::TaskQueries.new(
    store.read_snapshot, today: today, temporal_context: context
  )
  snapshot_item = query.snapshot.items.find { |candidate| candidate.id == task_id }
  mutation_failed "task changed before delete" unless snapshot_item
  node = query.snapshot.node_for(snapshot_item)
  removed = node ? node.each.map(&:item).compact : [snapshot_item]
  expected_revision = query.task(snapshot_item).revision
  descendants = removed.length - 1

  if flags["--dry-run"]
    if descendants.positive?
      puts "would delete #{removed.length} tasks (#{descendants} descendant#{"s" unless descendants == 1}): #{item_headline(item)}"
    else
      puts "would delete: #{item_headline(item)}"
    end
    return
  end

  result = application.delete_task(task_id, cascade: flags["--cascade"],
                                   expected_revision: expected_revision)
  if result.conflict?
    n = result.summary[:descendants]
    m = result.summary[:open_descendants]
    warn "refusing to delete: #{item.title.inspect} has #{n} descendant#{"s" unless n == 1} " \
         "(#{m} open). Re-run with --cascade to remove the whole subtree."
    exit 1
  end
  mutation_result_failed(result, "failed to delete")

  if flags["--json"]
    require "json"
    puts({ deleted: removed.map { |removed_item|
      item_json(removed_item, task: query.task(removed_item))
    } }.to_json)
  else
    removed.each { |i| puts item_headline(i) }
  end
end

def cmd_archive
  require_current_schema_for_mutation!
  result = store.archive_swept!
  if result.is_a?(Tasks::Store::ArchiveRefusal)
    preview = result.preview
    if result.reason == :archive_conflict
      abort [
        "Archive refused: archive.jsonl has partial or conflicting copies of candidate IDs " \
          "#{result.details.join(", ")}.",
        "Live tasks were preserved. Compare `tasks list --done --json` with " \
          "`tasks list --archived --json`, reconcile the conflicting records, then retry.",
      ].join("\n")
    end
    blocked = preview.blocks.map do |block|
      %(#{block.root_title.inspect}: #{block.open_titles.join(", ")})
    end
    abort [
      "Archive refused: #{preview.blocked_roots} closed root#{preview.blocked_roots == 1 ? " has" : "s have"} " \
        "#{preview.open_descendants} open descendant#{preview.open_descendants == 1 ? "" : "s"}.",
      "Blocked subtree#{blocked.length == 1 ? "" : "s"}: #{blocked.join("; ")}",
      "Complete, cancel, move, or unnest the open work, then retry `tasks archive`.",
    ].join("\n")
  end
  mutation_failed("archive failed; live tasks were preserved") if result == false || store.last_rollback

  n = result
  if n.zero?
    puts "Nothing to archive (no DONE/CANCELLED items)."
  else
    puts "Archived #{n} item#{n == 1 ? "" : "s"} to archive.jsonl."
  end
end

# Revert (undo) or replay (redo) the last mutation. History is the on-disk
# journal shared with the TUI and across CLI runs, so this reaches back past the
# current invocation. Refuses when tasks.jsonl changed out-of-band since that edit.
def cmd_undo = run_history(:undo!, verb: "undo", past: "undid")
def cmd_redo = run_history(:redo!, verb: "redo", past: "redid")

# Print a task's stable :ID:, assigning one (a PROPERTIES drawer) if it has none.
# Idempotent — a task that already carries an id is printed without a rewrite.
def cmd_id(args)
  today = Date.today
  flags, rest = take_flags(args, "--json")
  ref = rest.shift
  abort "usage: tasks id <ref>" if ref.nil? || ref.strip.empty?
  item = resolve_ref(ref, include_done: true) # referenceable regardless of state
  require_current_schema_for_mutation!
  id = store.ensure_id!(item)
  mutation_failed "failed to assign id" unless id
  store.reload!
  fresh = store.items.find { |i| i.id == id }
  if flags["--json"]
    require "json"
    query = Tasks::TaskQueries.new(store.read_snapshot, today: today)
    puts({ id: id, touched: fresh ? [item_json(fresh, task: query.task(fresh))] : [] }.to_json)
  else
    puts id
    puts item_headline(fresh) if fresh
  end
end

def run_history(op, verb:, past:)
  require_current_schema_for_mutation!
  kind, label = store.public_send(op)
  case kind
  when :empty    then abort "nothing to #{verb}"
  when :conflict then abort "tasks.jsonl changed since that edit — refusing to #{verb} “#{label}”"
  else                puts "#{past}: #{label}"
  end
end

def require_current_schema_for_mutation!
  return unless store.migration_required?

  mutation_failed "task data migration required; run `tasks migrate`"
end

STATE_ORDER = Tasks::TaskFilter::STATE_ORDER

# Parse `list` args into a scope symbol plus filters, then print grouped output.
def cmd_list(args)
  context = temporal_context
  today = context.local_date
  parsed = begin
    Tasks::TaskFilter.parse_cli(args)
  rescue ArgumentError => error
    abort error.message
  end
  operation_context = cli_operation_context(context)
  result = application.list_tasks(parsed.filter, today: today, context: operation_context)
  sel = result.items

  return if emit_json?(sel, [parsed.json ? "--json" : nil].compact, result: result)

  if sel.empty?
    puts "No matching tasks."
    return
  end

  # The delegation scopes are about who holds the task, not what state it is
  # in, so they print one flat ranked list of delegation summaries instead of
  # the state-grouped view.
  if parsed.filter.delegated_only || parsed.filter.agent_ready_only
    sel.each { |item| puts delegation_headline(result.task_for(item)) }
    return
  end

  by_state = sel.group_by(&:state)
  STATE_ORDER.each do |st|
    list = by_state[st]
    next unless list
    puts bold(st)
    list.sort_by { |i| i.priority || "Z" }.each do |i|
      due = short_due(i, today: today, context: context)
      arch = i.source == :archive ? dim("  (archived)") : ""
      task = result.task_for(i)
      defr = list_availability_label(task, today: today, context: operation_context)
      recr = i.recur ? dim("  ↻ #{recur_summary(i.recur)}") : ""
      puts "  #{fmt(i)}#{due.empty? ? "" : "  #{due}"}#{recr}#{defr}#{arch}"
    end
    puts
  end
end

def list_availability_label(task, today:, context: nil)
  return "" unless task
  return dim("  (on hold)") if task.deferred?
  return "" if task.available? || task.availability_reason == :closed

  blocker = task.availability_blocker_id &&
            application.get_task(task.availability_blocker_id, today: today, context: context)
  case task.availability_reason
  when :scheduled
    dim("  (unavailable until #{temporal_label(task.gate_value)}#{lead_span_suffix(task)})")
  when :ancestor_scheduled
    # The effective gate, which for an ancestor with a lead is the derived date
    # rather than any stamp the ancestor carries.
    value = task.gate_value || blocker&.scheduled_value
    dim("  (unavailable#{value ? " until #{temporal_label(value)}" : ""} via #{blocker&.title || task.availability_blocker_id})")
  when :ancestor_on_hold
    dim("  (on hold via #{blocker&.title || task.availability_blocker_id})")
  else
    dim("  (unavailable)")
  end
end

# " (3w before 11/1)" for a row a lead is hiding, so an unavailable review shows
# the intent beside the derived date rather than only the date it produced.
def lead_span_suffix(task)
  return "" unless task.respond_to?(:lead_opens) && task.lead_opens
  return "" unless task.gate_date == task.lead_opens

  anchor = task.deadline || task.scheduled
  anchor ? " · #{task.lead} before #{anchor.strftime("%-m/%-d")}" : ""
end

# Validate tasks.jsonl structure. Exit 0 clean, 1 errors found.
def cmd_check(args)
  flags, rest = take_flags(args, "--json", "--all-files")
  abort "usage: tasks check [--json] [--all-files]" unless rest.empty?
  all_files = flags["--all-files"]
  res = all_files ? store.check_files : Tasks::Check.check(ORG)
  if flags["--json"]
    require "json"
    puts res.to_h.to_json
  else
    res.errors.each   { |line, msg| puts "#{red("error")}  line #{line}: #{msg}" }
    res.warnings.each { |line, msg| puts "#{yellow("warn")}   line #{line}: #{msg}" }
    if res.ok?
      snapshot = store.read_snapshot(include_archive: all_files)
      n = snapshot.items.size + (all_files ? snapshot.archive_items.size : 0)
      noun = all_files ? "record" : "task"
      puts "ok — #{n} #{noun}#{n == 1 ? "" : "s"} parsed, no structural errors#{res.warnings.empty? ? "" : " (#{res.warnings.size} warning#{res.warnings.size == 1 ? "" : "s"})"}"
    else
      puts "#{res.errors.size} error(s), #{res.warnings.size} warning(s)"
    end
  end
  exit(res.ok? ? 0 : 1)
end

# Hand a natural-language prompt to an LLM agent with TASK_AGENT.md as context.
# Runs the configured harness headless; auto-applies, then shows the file diff.
# `--provider`/`--model` (leading flags) override the config default for one run.
def cmd_prompt(args)
  provider, model, words = extract_llm_flags(Array(args))
  prompt = words.join(" ")
  abort %(usage: tasks -p [--provider NAME] [--model NAME] "do something with my tasks") if prompt.strip.empty?

  require_relative "../lib/llm/registry"
  require_relative "../lib/tasks/agent_context"
  data_dir = File.dirname(ORG)
  # Build the system context (TASK_AGENT.md + file locations + task-set memory)
  # before spawning: an oversize/unreadable agent-memory.md must abort with the
  # path here, not run the agent without the user's saved defaults.
  sys_prompt = Tasks::AgentContext.build(paths: PATHS, cli_root: ROOT)

  entry = LLM.default_entry(provider: provider, model: model)
  agent = LLM.build(entry, root: data_dir, system: sys_prompt)
rescue ArgumentError, Tasks::AgentContext::Error => e
  abort e.message
else
  unless agent.available?
    abort "agent '#{entry.provider}' not available — check the CLI is installed and any local model server is running"
  end
  ok = agent.run_sync(prompt.strip, model: entry.model)
  warn "\n(agent exited non-zero)" unless ok
  maybe_show_diff(data_dir)
end

# Peel leading `--provider NAME` / `--model NAME` flags off the -p arguments so
# the rest is the prompt verbatim. Only strips when they lead, so a prompt that
# happens to mention "--model" mid-sentence is left untouched.
def extract_llm_flags(args)
  args = args.dup
  provider = model = nil
  loop do
    case args.first
    when "--provider" then args.shift; provider = args.shift
    when "--model"    then args.shift; model = args.shift
    else break
    end
  end
  [provider, model, args]
end

# Show what the agent changed — the task files plus the memory sidecar when it
# lives in the same repo. Only possible when the task files sit in a git repo;
# a memory sidecar relocated outside that repo can't be diffed here, so it gets
# a one-line notice instead. Decision logic lives in Tasks::AgentDiff so it can
# be tested against a real sandbox; this stays thin human formatting.
def maybe_show_diff(data_dir)
  require_relative "../lib/tasks/agent_diff"
  result = Tasks::AgentDiff.compute(data_dir: data_dir, org: ORG, archive: ARCHIVE,
                                    memory: PATHS.memory, color: $stdout.tty?)
  return unless result

  unless result.diff.strip.empty?
    puts "\n#{bold("Changes to task files:")}"
    print result.diff
    puts unless result.diff.end_with?("\n")
  end
  if result.notice
    puts dim("Note: task-set memory at #{result.notice} is outside the task-data " \
             "repo — review its changes there separately.")
  end
end

# Where the task files resolve to, and why — for debugging a config setup.
def cmd_config(args)
  if args.include?("--json")
    require "json"
    puts({ org: ORG, archive: ARCHIVE,
           memory: PATHS.memory,
           urgent_days: PATHS.urgent_days,
           max_depth: PATHS.max_depth,
           theme: PATHS.theme, colors: PATHS.colors,
           mouse: PATHS.mouse,
           timezone: PATHS.timezone, time_format: PATHS.time_format,
           date_order: PATHS.date_order,
           tzdb_version: Tasks::Timezones.tzdb_version,
           timezone_fallback_warning: PATHS.timezone_fallback_warning,
           links: PATHS.links, link_systems: PATHS.link_systems,
           prompt_facts: PATHS.prompt_facts,
           hostname: PATHS.hostname, host_context: PATHS.host_context,
           host_context_source: PATHS.host_context_source,
           host_contexts: PATHS.host_contexts,
           sources: PATHS.sources,
           memory_exists: File.file?(PATHS.memory),
           config_file: PATHS.config_file,
           config_file_exists: File.file?(PATHS.config_file) }.to_json)
  else
    puts "org:         #{ORG}  #{dim("(#{PATHS.sources[:org]})")}"
    puts "archive:     #{ARCHIVE}  #{dim("(#{PATHS.sources[:archive]})")}"
    puts "memory:      #{PATHS.memory}  #{dim("(#{PATHS.sources[:memory]}#{File.file?(PATHS.memory) ? "" : ", not present"})")}"
    puts "urgent_days: #{PATHS.urgent_days}  #{dim("(#{PATHS.sources[:urgent_days]})")}"
    puts "max_depth:   #{PATHS.max_depth}  #{dim("(#{PATHS.sources[:max_depth]})")}"
    puts "theme:       #{PATHS.theme}  #{dim("(#{PATHS.sources[:theme]})")}"
    puts "mouse:       #{PATHS.mouse ? "on" : "off"}  #{dim("(#{PATHS.sources[:mouse]})")}"
    puts "timezone:    #{PATHS.timezone}  #{dim("(#{PATHS.sources[:timezone]})")}"
    puts "time_format: #{PATHS.time_format}  #{dim("(#{PATHS.sources[:time_format]})")}"
    puts "date_order:  #{PATHS.date_order}  #{dim("(#{PATHS.sources[:date_order]})")}"
    puts "hostname:    #{PATHS.hostname || "unavailable"}"
    host_context = PATHS.host_context || "none"
    source = PATHS.host_context_source ? "  #{dim("(#{PATHS.host_context_source})")}" : ""
    puts "host_context: #{host_context}#{source}"
    puts "tzdb:        #{Tasks::Timezones.tzdb_version}"
    warn "warning: host time zone could not be detected; using Etc/UTC" if PATHS.timezone_fallback_warning
    puts "colors:      #{PATHS.colors.map { |k, v| "#{k}=#{v}" }.join(" · ")}" unless PATHS.colors.empty?
    # The link namespaces are the debugging surface for "why doesn't my
    # shorthand expand?" — show what actually resolved.
    PATHS.links.each { |n, t| puts "link.#{n}:   #{t}" }
    PATHS.link_systems.each { |n, h| puts "system.#{n}: #{h}" }
    PATHS.prompt_facts.each { |n, on| puts "prompt.#{n}: #{on ? "on" : "off"}" }
    puts "config:      #{PATHS.config_file}#{File.file?(PATHS.config_file) ? "" : dim(" (not present)")}"
  end
end

def cmd_migrate(args)
  flags, rest = take_flags(args, "--dry-run", "--json")
  abort "usage: tasks migrate [--dry-run] [--json]" unless rest.empty?
  result = application.migrate_schema(dry_run: flags["--dry-run"])
  if flags["--json"]
    require "json"
    puts JSON.generate(status: result.status, from_version: result.from_version,
                       to_version: result.to_version, files: result.files,
                       backups: result.backups, errors: result.errors)
  elsif result.status == :dry_run
    puts "would migrate #{result.files.join(" and ")} from schema v1 to v#{result.to_version}"
  elsif result.status == :already_current
    puts "schema already at v#{result.to_version}"
  elsif result.ok?
    puts "migrated #{result.files.join(" and ")} to schema v#{result.to_version}"
    result.backups.each { |path| puts "backup: #{path}" }
  else
    warn(result.errors.join("\n"))
    exit 1
  end
end

# --- Projects (projects + project <verb>) -----------------------------------
#
# A project is a rolled-up section: the ProjectView read model (open/NEXT
# counts, soonest date, stuck flag) is produced by Tasks::Application, so
# bin/tasks only resolves the ref and renders. Project refs resolve against the
# `projects` listing — an exact id, an L<line> section line, then a title
# substring across projects and areas — mirroring task refs (exit 2 on
# no-match/ambiguous).

PROJECT_USAGE = "usage: tasks project <create|show|complete|archive|rename> <title|ref> [...]"

# Short "M/D" date (no leading zeros), matching short_due, for project rows.
def project_date(date) = date ? "#{date.month}/#{date.day}" : nil

# One project/area summary: "3 open · 1 next · next 7/25" plus a stuck marker.
def project_summary(view)
  parts = ["#{view.open_count} open", "#{view.next_count} next"]
  if view.next_date
    parts << "next #{view.next_time&.fetch(:local, nil) || project_date(view.next_date)}"
  end
  "#{dim(parts.join(" · "))}#{view.stuck ? "  #{yellow("(stuck)")}" : ""}"
end

def project_row(view, width: 0) = "#{view.title.to_s.ljust(width)}  #{project_summary(view)}"

def cmd_projects(args)
  context = temporal_context
  today = context.local_date
  flags, rest = take_flags(args, "--json")
  abort "usage: tasks projects [--json]" unless rest.empty?
  result = application.list_projects_result(today: today, context: cli_operation_context(context))
  abort "task file is invalid — run `tasks check`" unless result.ok?
  views = result.data

  if flags["--json"]
    require "json"
    puts JSON.generate(views.map(&:to_h))
    return
  end
  if views.empty?
    puts "No projects or areas."
    return
  end
  width = views.map { |v| v.title.to_s.length }.max
  { "project" => "Projects", "area" => "Areas" }.each do |kind, label|
    group = views.select { |v| v.kind == kind }
    next if group.empty?
    puts bold(label)
    group.each { |v| puts "  #{project_row(v, width: width)}" }
    puts
  end
end

def cmd_project(args)
  verb = args.shift
  case verb
  when "create", "new"    then project_create(args)
  when "show"             then project_show(args)
  when "complete", "done" then project_complete(args)
  when "archive"          then project_archive(args)
  when "rename"           then project_rename(args)
  when nil                then abort PROJECT_USAGE
  else abort "unknown project command: #{verb.inspect}\n#{PROJECT_USAGE}"
  end
end

# Create a new empty project section under the top-level "Projects" root
# (bootstrapping the root when absent). The title is positional; a blank or
# duplicate title exits 1 with the reason.
def project_create(args)
  today = Date.today
  flags, rest = take_flags(args, "--dry-run", "--json")
  title = utf8_arg(rest.join(" ").strip)
  abort "usage: tasks project create <title>" if title.empty?
  if flags["--dry-run"]
    puts %(would create project "#{title}")
    return
  end
  result = application.create_project(title: title, today: today)
  if result.invalid?
    warn(result.errors.first || "invalid project title")
    exit result.cli_exit_code
  end
  mutation_result_failed(result, "failed to create project")
  new_id = result.summary && result.summary[:created_id]
  emit_project(new_id, json: flags["--json"], today: today, human: %(created "#{title}"))
end

# Resolve a project <ref> to one ProjectView, or exit 2. An exact 8-hex section
# id wins, then an L<line> section line, then a case-insensitive title substring
# across projects and areas. The `projects` listing is the candidate set, so an
# empty area (no open work) is not addressable — matching what `projects` shows.
def resolve_project(ref, today: Date.today)
  abort "missing <ref>" if ref.nil? || ref.strip.empty?
  result = application.list_projects_result(today: today)
  abort "task file is invalid — run `tasks check`" unless result.ok?
  views = result.data

  if (m = ref.match(/\AL(\d+)\z/i))
    view = views.find { |v| v.line == m[1].to_i }
    unless view
      warn "no project section on line #{m[1]}"
      exit 2
    end
    return view
  end

  if (view = views.find { |v| v.id && v.id.casecmp?(ref.strip) })
    return view
  end

  q = ref.dup.force_encoding("UTF-8").strip.downcase
  matches = views.select { |v| v.title.to_s.downcase.include?(q) }
  if matches.empty?
    warn "no match: #{ref}"
    exit 2
  elsif matches.size > 1
    warn "ambiguous: #{ref} — matches #{matches.size} projects:"
    matches.each { |v| warn "  L#{v.line}: #{v.title}" }
    exit 2
  end
  matches.first
end

def project_show(args)
  today = Date.today
  flags, rest = take_flags(args, "--json")
  ref = rest.shift
  abort "usage: tasks project show <ref> [--json]" if ref.nil? || ref.strip.empty? || !rest.empty?
  view = resolve_project(ref, today: today)
  if flags["--json"]
    require "json"
    puts JSON.generate(view.to_h)
    return
  end
  puts "#{bold(view.title)}  #{dim("[#{view.kind}]")}"
  puts "  id:        #{view.id}"
  puts "  #{project_summary(view)}"
  puts "  #{view.body}" if view.body && !view.body.empty?
end

def project_rename(args)
  today = Date.today
  flags, rest = take_flags(args, "--dry-run", "--json")
  ref = rest.shift
  new_title = utf8_arg(rest.join(" ").strip)
  abort %(usage: tasks project rename <ref> <new title>) if ref.nil? || ref.strip.empty? || new_title.empty?
  view = resolve_project(ref, today: today)
  if flags["--dry-run"]
    puts %(would rename "#{view.title}" → "#{new_title}")
    return
  end
  result = application.rename_project(view.id, title: new_title)
  mutation_result_failed(result, "failed to rename project")
  emit_project(result.touched_ids.first, json: flags["--json"], today: today,
               human: %(renamed "#{view.title}" → "#{new_title}"))
end

def project_complete(args)
  today = Date.today
  flags, rest = take_flags(args, "--dry-run", "--json")
  ref = rest.shift
  abort "usage: tasks project complete <ref>" if ref.nil? || ref.strip.empty? || !rest.empty?
  view = resolve_project(ref, today: today)
  # The touched tasks are the project's open descendants; capture them before
  # the cascade so their post-close headlines can be reported by line.
  touched = open_descendant_task_ids(view.id)
  if flags["--dry-run"]
    n = touched.length
    puts %(would complete "#{view.title}": close #{n} open task#{"s" unless n == 1})
    return
  end
  result = application.complete_project(view.id, today: today)
  mutation_result_failed(result, "failed to complete project")
  closed = (result.summary && result.summary[:closed]) || touched.length
  puts %(completed "#{view.title}" (closed #{closed})) unless flags["--json"]
  report_touched(touched, json: flags["--json"], today: today)
end

def project_archive(args)
  today = Date.today
  flags, rest = take_flags(args, "--dry-run", "--json", "--force")
  ref = rest.shift
  abort "usage: tasks project archive <ref> [--force]" if ref.nil? || ref.strip.empty? || !rest.empty?
  view = resolve_project(ref, today: today)
  # Deferred/held tasks are still open work, so they block archive too (parity
  # with complete's cascade, which closes them). Refuse unless --force.
  blocking = view.open_count + view.held_count
  if blocking.positive? && !flags["--force"]
    held_note = view.held_count.positive? ? " (#{view.held_count} deferred)" : ""
    warn %(refusing to archive "#{view.title}": #{blocking} open task#{"s" unless blocking == 1}#{held_note} remain. Complete them or re-run with --force.)
    exit 1
  end
  if flags["--dry-run"]
    puts %(would archive "#{view.title}" and its subtree to archive.jsonl)
    return
  end
  result = application.archive_project(view.id)
  mutation_failed(result.errors.first) if result.conflict? && !result.errors.empty?
  mutation_result_failed(result, "failed to archive project")
  archived = (result.summary && result.summary[:archived]) || result.touched_ids.length
  if flags["--json"]
    require "json"
    puts JSON.generate({ archived: archived, moved_ids: result.touched_ids })
  else
    puts %(archived "#{view.title}" — #{archived} record#{"s" unless archived == 1} moved to archive.jsonl)
  end
end

# After a project mutation, re-read and render the (now current) project. The
# project mutations return only touched ids and a summary, so the fresh view
# comes from a follow-up read pinned to the same `today`.
def emit_project(id, json:, today:, human:)
  view = id && application.get_project(id, today: today)
  if json
    require "json"
    puts JSON.generate(view ? view.to_h : {})
  else
    puts human
    puts "  #{project_row(view)}" if view
  end
end

# The open descendant task ids of a section, at any depth — the tasks a project
# completion cascade closes. Walks the live parent pointers (order is irrelevant;
# report_touched re-sorts by line before printing).
def open_descendant_task_ids(section_id)
  records = store.read_snapshot.live_records
  by_parent = Hash.new { |h, k| h[k] = [] }
  records.each { |record| by_parent[record["parent"]] << record }
  ids = []
  queue = by_parent[section_id].dup
  until queue.empty?
    record = queue.shift
    queue.concat(by_parent[record["id"]])
    ids << record["id"] if record["type"] == "task" && OPEN_STATES.include?(record["state"])
  end
  ids
end

require "shellwords"

HELP = <<~USAGE
  tasks — a plain-text GTD CLI over tasks.jsonl. Every command has a short alias.

  Read:
    agenda    a              dated items, soonest first
    next      n              NEXT actions grouped by context
    quadrants q              Covey 2x2: priority (A/B) + near deadline, or tags
    inbox     i              unprocessed INBOX items
    projects  pj             projects & areas rolled up over their open tasks
                             (open/NEXT counts, soonest date, stuck flag)
    list      l [filters]    tasks by state. Filters: @context /text +tag -A|-B|-C
                             Scope: --open/-o (default) --proposed --done/-d
                             --archived/-x --all/-a (choose one)
                             --deferred/-D all unavailable · --unavailable canonical spelling
                             --someday/--on-hold own indefinite holds · --recurring/-R repeating
                             --delegated any delegation · --agent-ready claimable
                             agent work, ranked by priority then date
                             --body/-b widens /text search into task notes
    show      s <ref>        one task in full (headline + notes + links)
    links     urls [<ref>]   links in task notes, by system (slack, jira, …)
                             --system <name> filters · --all widens the listing
                             to done + archived (<ref> stays live-file) · --json
    open      o <ref> [n]    open a task's link in the browser (n or --system
                             picks among several; --print shows instead)
    id           <ref>       print a task's stable id (assigns one if absent)
    check     k              validate tasks.jsonl structure

  Capture:
    capture   c "text"       new item. Flags: --due --scheduled --priority
                             --tag --context --no-host-context --state
                             --project --under --recur --lead --note
                             (--under <ref> nests it below a task; caps at max_depth)
    propose     "text"       inert PROPOSED item for owner review. Capture flags
                             except --state/--recur; repeat --note for rationale

  Update (take <ref>; support --dry-run/--json/--include-done):
    approve      <ref>        accept PROPOSED into INBOX
    reject       <ref> [--note] decline PROPOSED into CANCELLED; repeat --note
                             for withdrawal rationale (visible in `show`)
    done      d <ref>        mark DONE (cascades to open subtasks) — or roll a
                             recurring task forward (aka complete, close)
    cancel      <ref> [--note] mark CANCELLED (aka drop); repeat --note for reason
    state     mv <ref> <STATE>       any state transition
    due          <ref> <date/time>   set/replace DEADLINE   (aka deadline, reschedule)
    schedule     <ref> <date/time>   set/replace Available from (SCHEDULED)
    undate       <ref> [--kind deadline|scheduled]   remove date stamp(s)
    priority pri <ref> <A|B|C|none>  set/clear priority (incl. PROPOSED)
    retitle rename <ref> "title"     replace title (incl. PROPOSED)
    tag          <ref> +t -t @ctx -@ctx   edit tags/contexts (incl. PROPOSED)
    note         <ref> "text"        append a body line (incl. PROPOSED)
    move         <ref> "Section"     relocate the subtree under a heading
                                     (top-level or a nested project section)
                 <ref> --under <ref> nest the subtree below another task (≤ max_depth)
                 <ref> --top         unnest the subtree back to the section level
                 <ref> ["Section"|--under <ref>] --before <ref>
                                     place the subtree before a stable sibling
    recur repeat <ref> <schedule>    repeat on done: weekly · 2w · .+1m · off
                                     calendar: every mon,wed · m:15 · 2nd tuesday ·
                                     last day of the month · every july 4
                                     --from schedule|completion (intervals only) ·
                                     --on <date> seeds a stamp
                 <ref>               read-only: the schedule + its next dates
                                     (--count N, default 5 · --json)
                 --explain "<sched>" parse/preview any schedule, no task needed
    lead           <ref> <span|off>   hide until a span before its date: 3w · 2d ·
                                     1m · "a week" · off (anchor = deadline if
                                     it has one, else Available from)
                   <ref>              read-only: the window and when it opens
    defer   snooze <ref> [date/time] defer until exact value; omitted means On Hold
    someday        <ref>             put on indefinite hold (Someday/Maybe)
    activate       <ref>             make available now (undefer, resume)
    delete         <ref>             hard-delete a task (no archive). Needs --cascade
                                     if it has subtasks. Undoable via `undo`;
                                     usually prefer cancel/archive — this is for
                                     true mistakes.

  Delegation (hand a task to a person or to the agent pool):
    delegate <ref> refine|research|implement   agent-ready at that authority
    delegate <ref> --to <email> [--keep-state] hand to a person; sets WAITING
    undelegate <ref>                clear the marker (also revokes a claim)
    workref <ref> <url-or-id|off>   record where the work lives (one reference)
    claim <ref> --worker <id>       atomic pickup of agent-ready work; --json
                                    re-emits the full task so an agent reads its
                                    authority in one step
    release <ref> --worker <id>     hand a claim back to agent-ready
                                    --note "blocker" appends a note in the same
                                    undo step · --force is the owner override
    list --delegated · list --agent-ready    the two delegation read scopes
    --worker defaults from TASKS_WORKER_ID; the flag always wins.
    A lost claim race exits 1 with `conflict: already claimed by <id> at <ts>`.

  Projects (a project/area is a rolled-up section):
    projects  pj             list projects & areas (see Read above)
    project create "title"   new empty project under the "Projects" root
    project show <ref>       one project/area in full
    project complete <ref>   close every open task in the project (aka done)
    project archive <ref>    sweep the project's subtree to archive.jsonl
                             (--force past remaining open tasks)
    project rename <ref> "title"   retitle the section
                             (refs: id · L<line> · title substring · --json/--dry-run)

  Lifecycle:
    archive   x              sweep DONE/CANCELLED to archive.jsonl
    undo                     revert the last mutation (shared with the TUI)
    redo                     replay the last undone mutation
    config                   show resolved file paths and their sources
    migrate                  migrate schema v1 stores to v2 (--dry-run first)
    -p "..."                 hand a request to an LLM agent
                             (-p [--provider N] [--model N] "...")
    help      -h             this message

  Files: default to the repo; override with TASKS_DIR (or TASKS_FILE/TASKS_ARCHIVE)
  env vars, or ~/.config/tasks/config (dir = / file = / archive = lines).
  Quadrants urgency window: urgent_days = N in the config file, or TASKS_URGENT_DAYS
  env (default 3) — a DEADLINE within N days counts as urgent.
  TUI colors: theme = default|mono|dracula|nord|catppuccin-mocha|... and
  color.<slot> = <spec> in the config file (or TASKS_THEME env; NO_COLOR
  honored) — see docs/cli-spec.md (TUI colors).
  Link shorthands: link.jira = https://acme.atlassian.net/browse/%s in the config
  lets notes say jira:OPS-1234; system.gitlab = gitlab.acme.io names custom hosts.
  Host contexts: host_context.my-mac.local = @home adds that context to new tasks.

  Dates: 2026-07-15 · 07-15 · fri · today · tomorrow · +3 · tomorrow 9am
  Timed values: --timezone Europe/London · --floating · --fold earlier|later
  Refs:  a case-insensitive title substring, an exact id, or L<line>.
  Full spec: docs/cli-spec.md
USAGE

def cmd_help(io = $stdout) = io.puts(HELP)

# each branch reads via the store on demand — `check` must be able to run
# (and report) on a file the parser would choke on
begin
case ARGV[0]
when "-p", "--prompt" then cmd_prompt(ARGV[1..]); exit
when "next", "n"      then cmd_next(ARGV[1..])
when "quadrants", "q" then cmd_quadrants(ARGV[1..])
when "agenda", "a"    then cmd_agenda(ARGV[1..])
when "inbox", "i"     then cmd_inbox(ARGV[1..])
when "projects", "pj" then cmd_projects(ARGV[1..])
when "project"        then cmd_project(ARGV[1..])
when "capture", "add", "c" then cmd_capture(ARGV[1..])
when "propose"        then cmd_propose(ARGV[1..])
when "approve"        then cmd_approve(ARGV[1..])
when "reject"         then cmd_reject(ARGV[1..])
when "delegate"       then cmd_delegate(ARGV[1..])
when "undelegate"     then cmd_undelegate(ARGV[1..])
when "workref", "work-ref" then cmd_workref(ARGV[1..])
when "claim"          then cmd_claim(ARGV[1..])
when "release"        then cmd_release(ARGV[1..])
when "done", "complete", "close", "d" then cmd_done(ARGV[1..])
when "due", "deadline", "reschedule" then cmd_due(ARGV[1..])
when "schedule"       then cmd_schedule(ARGV[1..])
when "undate"         then cmd_undate(ARGV[1..])
when "state", "mv"    then cmd_state(ARGV[1..])
when "cancel", "drop" then cmd_cancel(ARGV[1..])
when "priority", "pri" then cmd_priority(ARGV[1..])
when "retitle", "rename" then cmd_retitle(ARGV[1..])
when "tag"            then cmd_tag(ARGV[1..])
when "note"           then cmd_note(ARGV[1..])
when "move"           then cmd_move(ARGV[1..])
when "delete"         then cmd_delete(ARGV[1..])
when "recur", "repeat", "every" then cmd_recur(ARGV[1..])
when "lead", "leadtime", "lead-time" then cmd_lead(ARGV[1..])
when "defer", "snooze" then cmd_defer(ARGV[1..])
when "someday"         then cmd_defer(ARGV[1..], someday: true)
when "activate", "undefer", "resume" then cmd_activate(ARGV[1..])
when "show", "s"      then cmd_show(ARGV[1..])
when "archive", "x"   then cmd_archive
when "undo"           then cmd_undo
when "redo"           then cmd_redo
when "id"             then cmd_id(ARGV[1..])
when "links", "urls"  then cmd_links(ARGV[1..])
when "open", "o"      then cmd_open(ARGV[1..])
when "list", "l"      then cmd_list(ARGV[1..])
when "check", "k"     then cmd_check(ARGV[1..])
when "config"         then cmd_config(ARGV[1..])
when "migrate"        then cmd_migrate(ARGV[1..])
when "help", "-h", "--help" then cmd_help
else
  warn "unknown command: #{ARGV[0].inspect}\n\n" if ARGV[0]
  cmd_help($stderr)
  exit 1
end
rescue Tasks::Timezones::Error => e
  warn "temporal value is invalid in #{PATHS.timezone}: #{e.message}"
  warn "choose a valid local time or change the configured timezone"
  exit 1
end
