# Ruby
*.gem
.bundle/
vendor/bundle/

# Task data must never land in the code repo — it lives in a separate private
# repo (see ~/.config/tasks/config). Guards against a stray CLI/eval fallback
# write to the repo-root default. (examples/tasks.jsonl is committed sample data;
# these root-anchored patterns don't touch it.)
/tasks.jsonl
/tasks.jsonl.bak
/archive.jsonl
/archive.jsonl.bak
# Advisory-lock sidecar Store#with_lock drops beside the live file (the undo
# journal itself lives under $XDG_STATE_HOME/tasks/, out of the repo).
/.tasks.jsonl.lock
/.archive.jsonl.lock

# Editor / OS
.DS_Store
*.swp
*~
\#*\#
.\#*

# launchd auto-commit log
.autocommit.log
.todos/
.sidecar/
.sidecar-agent
.sidecar-task
.sidecar-pr
.sidecar-start.sh
.sidecar-base
.td-root

# Go-port fleet runtime state (porting/loop.sh). Tick transcripts and the
# usage-limit record are per-machine and large; STOP is an operator gesture,
# not a repo fact. Everything durable — manifest, fixtures, evidence — is
# committed.
/porting/logs/
/porting/STOP
/porting/.manifest-merge.log

# Go-port build products. The sources are committed; the binaries are not.
/go/bin/
/porting/corpus/generated/

# Lock sidecars are runtime artifacts. Running a fixture in place creates one,
# and committing it changes the starting state every conformance read observes
# — porting/fixtures/README.md says it belongs to the stale-lock fixture alone.
/porting/fixtures/*/*/store/.tasks.jsonl.lock
!/porting/fixtures/adversarial/stale-lock-sidecar/store/.tasks.jsonl.lock
